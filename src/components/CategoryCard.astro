---
interface Props {
  id: string;
  name: string;
  description: string;
  icon: string;
  count: number;
}
const { id, name, description, count } = Astro.props;
import { u } from '../utils/url';
import Icon from './Icon.astro';
import Badge from './Badge.astro';
import { categoryIcon } from '../utils/categoryIcons';
---

<a
  href={u(`/products/${id}`)}
  class="card card-interactive group block p-7"
>
  <div class="flex items-start gap-4">
    <div class="shrink-0 w-12 h-12 bg-cloud rounded-xl flex items-center justify-center transition-colors duration-200 group-hover:bg-red/8">
      <Icon name={categoryIcon(id)} class="w-6 h-6 text-ink transition-colors duration-200 group-hover:text-red" />
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between gap-2 mb-2">
        <h3 class="font-bold text-ink text-[15px] leading-snug transition-colors duration-200 group-hover:text-red">
          {name}
        </h3>
        <Badge variant="neutral" class="shrink-0">{count} {count === 1 ? 'product' : 'products'}</Badge>
      </div>
      <p class="text-sm text-muted line-clamp-2 leading-relaxed">{description}</p>
    </div>
  </div>
  <div class="link-arrow mt-5 text-xs text-red">
    View products <Icon name="arrow" class="w-3.5 h-3.5" />
  </div>
</a>
