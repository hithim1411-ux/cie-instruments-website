---
// The one badge/tag shape site-wide — "Featured", "CIE Manufactured",
// "Vartech® Dealer", model counts, etc. Same pill, same type treatment;
// color only changes where it's meaningfully different (CIE red vs.
// Vartech emerald). Don't hand-roll a new badge style per page.
interface Props {
  variant?: 'red' | 'emerald' | 'neutral' | 'dark';
  class?: string;
}
const { variant = 'neutral', class: className = '' } = Astro.props;
---
<span class={`badge badge--${variant} ${className}`}>
  <slot />
</span>
