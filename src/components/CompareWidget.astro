---
// "Compare with similar models" block for product pages. Renders nothing for products
// that are not in a comparison group. Static HTML (crawlable), enhanced by the /compare/ tool.
import { compareRef } from '../data/compare';
import { buildRows, insights, leaderIndex, rowDiffers, similar } from '../utils/compareCore';
import { u } from '../utils/url';

interface Props { categoryId: string; id: string }
const { categoryId, id } = Astro.props;
const ref = compareRef(categoryId, id);
const group = ref?.group;
const self = ref?.item;

let items: any[] = [], rows: any[] = [], notes: string[] = [], others: any[] = [], fullHref = '', aiQuery = '';
if (group && self) {
  const alts = similar(group, self, 2);
  items = [self, ...alts];
  const built = buildRows(group.rows, items);
  rows = (group.rows.length ? built.rows : built.more).slice(0, 8);
  notes = insights(group, items, rows).filter(n => !n.startsWith('They differ'));
  others = group.items.filter(i => i.id !== self.id).slice(0, 12);
  fullHref = u(`/compare/?g=${group.id}&p=${items.map(i => i.id).join(',')}`);
  aiQuery = `Is the ${self.model} the right choice, or should I consider ${alts.map(a => a.model).join(' or ')}? Compare them for me.`;
}
---

{group && self && items.length >= 2 && (
  <section class="cw" id="compare" aria-labelledby="cw-h">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="cw-card">
        <div class="cw-top">
          <div>
            <p class="cw-eyebrow">Compare</p>
            <h2 id="cw-h" class="cw-h">{self.model} vs similar {group.label.toLowerCase()}</h2>
            <p class="cw-sub">A quick look at how it stacks up. Open the full tool to tick your must-haves and compare any models.</p>
          </div>
          <a href={fullHref} class="cw-btn cw-btn--red">Open full comparison →</a>
        </div>

        <div class="cw-scroll">
          <table class="cw-table" style={`--n:${items.length}`}>
            <thead>
              <tr>
                <th class="cw-corner"></th>
                {items.map((it, k) => (
                  <th scope="col" class={k === 0 ? 'cw-self' : ''}>
                    {it.img && <img src={it.img} alt="" width="72" height="72" loading="lazy" />}
                    <span class="cw-brand">{it.brand}{k === 0 ? ' · this model' : ''}</span>
                    {k === 0 ? <span class="cw-model">{it.model}</span> : <a class="cw-model" href={it.href}>{it.model}</a>}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map(r => {
                const li = leaderIndex(r);
                return (
                  <tr class={rowDiffers(r.vals) ? 'is-diff' : ''}>
                    <th scope="row">{r.label}</th>
                    {r.vals.map((v: string | null, i: number) => v === null
                      ? <td class="cw-na">Not listed</td>
                      : <td set:html={v.split(' | ')[0].replace(/&/g, '&amp;').replace(/</g, '&lt;') + (i === li ? '<span class="cw-lead">Highest listed</span>' : '')} />)}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        {notes.length > 0 && (
          <div class="cw-notes">
            <p class="cw-eyebrow">What stands out</p>
            <ul>{notes.map(n => <li>{n}</li>)}</ul>
          </div>
        )}

        <div class="cw-more">
          <p class="cw-eyebrow">Compare {self.model} with another model</p>
          <div class="cw-chips">
            {others.map(o => (
              <a href={u(`/compare/?g=${group.id}&p=${self.id},${o.id}`)} class="cw-chip">{o.model}</a>
            ))}
          </div>
        </div>

        <div class="cw-foot">
          <button type="button" class="cw-btn" data-cw-ask={aiQuery}>Ask the AI if the {self.model} is right for me</button>
          <p>Values are taken from each product page. "Not listed" does not mean a feature is missing.</p>
        </div>
      </div>
    </div>

    <script>
      document.querySelectorAll<HTMLElement>('[data-cw-ask]').forEach(b => {
        b.addEventListener('click', () => {
          const ask = (window as any).__askCIESearch;
          if (ask) ask(b.dataset.cwAsk);
        });
      });
    </script>
  </section>
)}

<style is:global>
  .cw-card { padding: 1.4rem; border: 1px solid var(--color-border); border-radius: 1.2rem; background: #fff; box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 16px 40px -24px rgba(16,24,40,.22); }
  @media (min-width: 640px) { .cw-card { padding: 2rem; } }
  .cw-top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  .cw-eyebrow { margin: 0 0 .35rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--color-red); font-weight: 700; }
  .cw-h { margin: 0; font-size: 1.4rem; font-weight: 800; color: var(--color-ink); line-height: 1.2; }
  .cw-sub { margin: .4rem 0 0; font-size: .9rem; color: var(--color-muted); max-width: 40rem; }
  .cw-btn { display: inline-flex; align-items: center; padding: .65rem 1.15rem; font-size: .88rem; font-weight: 700; border: 1px solid var(--color-border); border-radius: .7rem; background: var(--color-cloud); color: var(--color-ink); cursor: pointer; transition: all .15s; }
  .cw-btn:hover { border-color: var(--color-red); color: var(--color-red); }
  .cw-btn--red { background: var(--color-red); border-color: var(--color-red); color: #fff; }
  .cw-btn--red:hover { filter: brightness(.92); color: #fff; }
  .cw-scroll { overflow-x: auto; border: 1px solid var(--color-border); border-radius: .9rem; }
  .cw-table { width: 100%; border-collapse: separate; border-spacing: 0; table-layout: fixed; min-width: calc(7rem + var(--n, 3) * 11rem); }
  .cw-table th, .cw-table td { padding: .6rem .8rem; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: top; font-size: .84rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cw-table tbody tr:last-child th, .cw-table tbody tr:last-child td { border-bottom: 0; }
  .cw-table thead th { text-align: center; background: #fff; padding-top: 1rem; }
  .cw-table thead th.cw-self { background: #fff6f6; }
  .cw-table thead img { display: block; margin: 0 auto .4rem; width: 4.5rem; height: 4.5rem; object-fit: contain; }
  .cw-brand { display: block; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .cw-model { display: block; font-size: 1rem; font-weight: 800; color: var(--color-ink); }
  a.cw-model:hover { color: var(--color-red); }
  .cw-table tbody th { width: 7rem; background: var(--color-cloud); font-family: var(--font-mono); font-size: .68rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-ink); }
  .cw-corner { width: 7rem; }
  .cw-table td + td { border-left: 1px solid var(--color-border); }
  .cw-table tr.is-diff td { background: #fff9ec; }
  .cw-na { color: #9aa3af; font-style: italic; }
  .cw-lead { display: inline-block; margin-left: .35rem; padding: .05rem .45rem; border-radius: 999px; font-size: .64rem; font-weight: 700; color: #047857; background: #d1fae5; white-space: nowrap; }
  .cw-notes { margin-top: 1.1rem; padding: .9rem 1.1rem; border-radius: .9rem; background: #fff9ec; border: 1px solid #f5d28a; }
  .cw-notes .cw-eyebrow { color: #92400e; }
  .cw-notes ul { margin: 0; padding-left: 1.1rem; list-style: disc; font-size: .9rem; line-height: 1.6; color: var(--color-ink); }
  .cw-more { margin-top: 1.2rem; }
  .cw-more .cw-eyebrow { color: var(--color-muted); }
  .cw-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .cw-chip { padding: .35rem .8rem; font-size: .82rem; font-weight: 600; border: 1px solid var(--color-border); border-radius: 999px; background: #fff; color: var(--color-ink); transition: all .15s; }
  .cw-chip:hover { border-color: var(--color-red); color: var(--color-red); }
  .cw-foot { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 1.2rem; margin-top: 1.3rem; }
  .cw-foot p { margin: 0; font-size: .78rem; color: var(--color-muted); }
</style>
