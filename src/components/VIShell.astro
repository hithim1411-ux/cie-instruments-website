---
import Base from '../layouts/Base.astro';
import EyebrowLabel from './EyebrowLabel.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CTABand from './CTABand.astro';
import { u } from '../utils/url';

interface Props {
  slug: string;
  model: string;
  pageTitle: string;
  description: string;
  h1: string;
  intro: string;
  productHref: string;
  ctaBody?: string;
  aboutTitle?: string;
  extraLink?: { href: string; label: string };
}
const { slug, model, pageTitle, description, h1, intro, productHref, ctaBody, aboutTitle, extraLink } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${model} Playground`,
  description,
  url: `https://www.cieinstruments.in/playground/${slug}/`,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  publisher: { '@id': 'https://www.cieinstruments.in/#organization' },
};
---

<Base title={pageTitle} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="blueprint-bg bg-ink text-white pt-10 pb-10 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="vi-crumbs"><Breadcrumbs crumbs={[{ label: 'Instrument Playground', href: u('/playground/') }, { label: model }]} /></div>
      <EyebrowLabel text="Just for fun" class="mt-5 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-white leading-[1.1] tracking-tight max-w-4xl">{h1} <span class="vi-beta">Beta</span></h1>
      <p class="mt-3 text-muted-dark max-w-2xl text-body-lg">{intro}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={productHref} class="btn-primary">{model} product page</a>
        {extraLink && <a href={extraLink.href} class="vi-ghost">{extraLink.label}</a>}
        <a href={u('/playground/')} class="vi-ghost">Back to the playground</a>
      </div>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="vi-disc" role="note">
        <strong>Beta, just for fun.</strong> This is a playful beta, for illustration only. It is not a training tool and not a substitute for the real instrument. The actual {model} can differ in appearance, display, button behaviour, ranges, timings and readings. Everything here is simulated, so do not use it to judge a real measurement. Always follow the instruction manual and your site safety procedure.
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 grid lg:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] gap-8 lg:gap-12 items-start">
      <div class="vi-stage lg:sticky lg:top-24">
        <slot name="stage" />
        <span class="vi-stagebeta">Beta · just for fun</span>
        <p class="vi-hint"><slot name="hint" /></p>
      </div>
      <div class="vi-panels"><slot name="panels" /></div>
    </div>
  </section>

  <section class="bg-cloud section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl vi-prose">
      <h2>{aboutTitle ?? `How the ${model} works`}</h2>
      <slot name="about" />
    </div>
  </section>

  <CTABand heading="Want the real thing on your bench?" body={ctaBody ?? `The ${model} is supplied by CIE in Howrah, with test certificate available on request.`} />
</Base>

<style is:global>
  .vi-beta { display: inline-block; vertical-align: middle; margin-left: .4rem; padding: .2rem .6rem; font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #fbbf24; background: rgba(245,158,11,.16); border: 1px solid rgba(245,158,11,.5); border-radius: 999px; }
  .vi-disc { padding: .9rem 1.1rem; font-size: .9rem; line-height: 1.55; color: #7c4a03; background: #fff7e6; border: 1px solid #f5c76b; border-left-width: 4px; border-radius: .75rem; }
  .vi-disc strong { color: #5c3500; }
  .vi-stagebeta { display: block; margin-top: .6rem; text-align: center; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: #b45309; }
  .vi-crumbs .text-ink { color: #fff; }
  .vi-ghost { display: inline-flex; align-items: center; padding: .8rem 1.4rem; font-weight: 600; font-size: .95rem; color: #fff; border: 1px solid rgba(255,255,255,.28); border-radius: .75rem; transition: all .2s; }
  .vi-ghost:hover { border-color: var(--color-red); background: rgba(224,37,46,.16); }

  .vi-stage { padding: 1.25rem; border-radius: 1.4rem; background: radial-gradient(120% 90% at 50% 0%, #fff 0%, #eef0f4 60%, #e3e6ec 100%); border: 1px solid var(--color-border); box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 20px 50px -22px rgba(16,24,40,.25); }
  #vi-svg { display: block; width: 100%; height: auto; max-height: calc(100vh - 9.5rem); margin-inline: auto; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  .vi-hint { margin: .75rem 0 0; font-size: .78rem; color: var(--color-muted); text-align: center; line-height: 1.7; }
  .vi-hint kbd { font-family: var(--font-mono); font-size: .7rem; padding: .05rem .35rem; border: 1px solid #cdd3dd; border-bottom-width: 2px; border-radius: .3rem; background: #fff; color: var(--color-ink); }

  /* SVG bits */
  .t-w { fill: #fff; } .t-y { fill: #f3b21b; }
  #vi-svg .btn { cursor: pointer; outline: none; transition: transform .07s; }
  #vi-svg .btn.down { transform: translateY(6px); }
  #vi-svg .btn:focus-visible rect { stroke: #fff; stroke-width: 5; }
  #vi-svg .btn:hover rect { filter: brightness(1.08); }
  #knob { transform-origin: 607px 845px; transition: transform .28s cubic-bezier(.3,1.5,.5,1); }
  #dial { cursor: grab; outline: none; touch-action: none; } #dial.drag { cursor: grabbing; }
  #dial:focus-visible circle:first-child { stroke: #fff; stroke-width: 7; }
  .pos { cursor: pointer; } .pos circle { fill: #fff; transition: fill .2s, r .2s; } .pos text { fill: #fff; } .pos:hover circle { fill: #ffd27a; }
  .pos.on circle { fill: #ffb83a; }
  .seg { fill: #171b15; opacity: .065; transition: opacity .06s; } .seg.on { opacity: .92; }
  .ann { opacity: .065; } .ann.on { opacity: .92; }
  #lcd.bl-off { }
  #led { transition: fill .2s; } #led.on { fill: #ff3b3b; filter: drop-shadow(0 0 8px #ff3b3b); }
  .hv-glow { animation: vi-pulse .9s ease-in-out infinite; }
  @keyframes vi-pulse { 50% { opacity: .35; } }

  /* Panels */
  .vi-panels { display: grid; gap: 1.1rem; min-width: 0; }
  .vi-card { padding: 1.25rem 1.35rem; border: 1px solid var(--color-border); border-radius: 1.1rem; background: #fff; box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 10px 28px -16px rgba(16,24,40,.16); min-width: 0; }
  .vi-h { display: flex; align-items: center; gap: .6rem; font-size: 1.02rem; font-weight: 700; color: var(--color-ink); margin: 0 0 .85rem; }
  .vi-h > span { display: inline-grid; place-items: center; min-width: 1.6rem; height: 1.6rem; padding: 0 .4rem; border-radius: .5rem; font-size: .78rem; font-family: var(--font-mono); color: #fff; background: var(--color-red); }
  .vi-h > span:only-child, .vi-h > span:first-child:not(:only-child) { }
  .vi-h b { font-weight: 700; }
  .vi-sub { margin: -.4rem 0 .8rem; font-size: .85rem; color: var(--color-muted); }
  .vi-note { margin: .7rem 0 0; font-size: .82rem; color: var(--color-muted); line-height: 1.5; }
  .vi-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .vi-chip { padding: .5rem .85rem; font-size: .84rem; font-weight: 600; color: var(--color-ink); background: var(--color-cloud); border: 1px solid var(--color-border); border-radius: 999px; cursor: pointer; transition: all .18s; text-align: left; }
  .vi-chip:hover { border-color: var(--color-red); color: var(--color-red); background: #fff; }
  .vi-chip:focus-visible, .vi-seg button:focus-visible, .vi-opt:focus-visible, .vi-btn:focus-visible { outline: 2px solid var(--color-red); outline-offset: 2px; }

  .vi-seg { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: .4rem; padding: .3rem; background: var(--color-cloud); border-radius: .8rem; }
  .vi-seg button { padding: .6rem .4rem; font-size: .86rem; font-weight: 600; color: var(--color-muted); border-radius: .6rem; cursor: pointer; transition: all .15s; line-height: 1.2; }
  .vi-seg button small { display: block; font-size: .68rem; font-family: var(--font-mono); font-weight: 500; opacity: .8; margin-top: .15rem; }
  .vi-seg button[aria-checked="true"] { background: var(--color-ink); color: #fff; box-shadow: 0 2px 8px rgba(10,14,20,.25); }
  .vi-seg--2 { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .vi-seg--3 { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .vi-seg--4 { grid-template-columns: repeat(4, minmax(0,1fr)); }
  .pos path { stroke: #fff; transition: stroke .2s; } .pos:hover path { stroke: #ffd27a; } .pos.on path { stroke: #ffb83a; }
  .vi-seg--sm { max-width: 13rem; }
  .vi-check { display: flex; align-items: center; gap: .6rem; margin-top: .8rem; font-size: .88rem; color: var(--color-ink); cursor: pointer; }
  .vi-check input { width: 1.05rem; height: 1.05rem; accent-color: var(--color-red); }
  .vi-check[hidden] { display: none; }

  .vi-opts { display: grid; gap: .5rem; }
  .vi-opt { display: flex; flex-direction: column; gap: .15rem; width: 100%; padding: .7rem .9rem; text-align: left; border: 1px solid var(--color-border); border-radius: .8rem; background: #fff; cursor: pointer; transition: all .15s; }
  .vi-opt:hover { border-color: #b9c0cc; }
  .vi-opt[aria-checked="true"] { border-color: var(--color-red); background: #fff6f6; box-shadow: 0 0 0 3px rgba(224,37,46,.12); }
  .vi-opt strong { font-size: .92rem; color: var(--color-ink); }
  .vi-opt span { font-size: .8rem; color: var(--color-muted); line-height: 1.4; }
  .vi-slider { margin-top: .9rem; }
  .vi-slider label { display: flex; justify-content: space-between; font-size: .84rem; font-weight: 600; color: var(--color-ink); margin-bottom: .35rem; }
  .vi-slider label output { font-family: var(--font-mono); color: var(--color-red); }
  .vi-slider input[type=range] { width: 100%; accent-color: var(--color-red); }
  .vi-qc { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .6rem; }
  .vi-qc button { padding: .3rem .65rem; font-size: .76rem; font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-cloud); cursor: pointer; }
  .vi-qc button[aria-checked="true"] { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  .vi-qc button:hover { border-color: var(--color-red); color: var(--color-red); }

  .vi-live { background: #0b1118; border-color: #1b2530; color: #cbd5e1; }
  .vi-live .vi-h { color: #fff; }
  .vi-status { font-size: .92rem; line-height: 1.6; color: #cbd5e1; min-height: 4.5rem; }
  .vi-status p { margin: 0 0 .55rem; } .vi-status p:last-child { margin: 0; }
  .vi-status strong { color: #fff; }
  .vi-status .warn { color: #ffb4b8; } .vi-status .ok { color: #7ee2b0; }
  .vi-table { width: 100%; margin-top: .9rem; border-collapse: collapse; font-size: .84rem; }
  .vi-table td, .vi-table th { padding: .38rem .5rem; border-bottom: 1px solid rgba(255,255,255,.09); text-align: left; font-weight: 500; }
  .vi-table th { color: #7b8794; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  .vi-table td:last-child { font-family: var(--font-mono); color: #fff; text-align: right; }
  .vi-badge { display: inline-block; margin-left: .45rem; padding: .08rem .5rem; font-size: .7rem; font-weight: 700; border-radius: 999px; font-family: var(--font-sans); }
  .vi-badge.bad { background: rgba(224,37,46,.2); color: #ff9aa0; } .vi-badge.warn { background: rgba(245,158,11,.2); color: #fbbf24; } .vi-badge.good { background: rgba(16,185,129,.2); color: #34d399; }
  #chart { display: block; width: 100%; height: auto; margin-top: .9rem; background: rgba(255,255,255,.03); border-radius: .7rem; }
  #chart text { font-family: var(--font-mono); font-size: 9px; fill: #7b8794; }
  .vi-spec { margin-top: .8rem; font-size: .76rem; font-family: var(--font-mono); color: #7b8794; line-height: 1.5; }

  .vi-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-bottom: 1px solid var(--color-border); }
  .vi-row:last-child { border-bottom: 0; padding-bottom: 0; }
  .vi-lbl { font-size: .9rem; font-weight: 600; color: var(--color-ink); }
  .vi-btn { padding: .45rem 1rem; font-size: .85rem; font-weight: 600; border: 1px solid var(--color-border); border-radius: .6rem; background: var(--color-cloud); cursor: pointer; }
  .vi-btn:hover { border-color: var(--color-red); color: var(--color-red); }
  .vi-switch { position: relative; width: 2.8rem; height: 1.6rem; display: inline-block; }
  .vi-switch input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; margin: 0; z-index: 1; }
  .vi-switch span { position: absolute; inset: 0; border-radius: 999px; background: #cdd3dd; transition: background .2s; }
  .vi-switch span::after { content: ''; position: absolute; top: .2rem; left: .2rem; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: #fff; transition: transform .2s; box-shadow: 0 1px 3px rgba(0,0,0,.3); }
  .vi-switch input:checked + span { background: var(--color-red); } .vi-switch input:checked + span::after { transform: translateX(1.2rem); }
  .vi-switch input:focus-visible + span { outline: 2px solid var(--color-red); outline-offset: 2px; }

  .vi-prose h2 { font-size: 1.5rem; font-weight: 800; margin: 0 0 1rem; color: var(--color-ink); }
  .vi-prose ul { display: grid; gap: .8rem; padding-left: 1.1rem; list-style: disc; line-height: 1.65; color: var(--color-muted); }
  .vi-prose strong { color: var(--color-ink); }
  .vi-fine { margin-top: 1.4rem; font-size: .84rem; line-height: 1.6; color: var(--color-muted); }

  @media (prefers-reduced-motion: reduce) { #knob, #vi-svg .btn { transition: none; } .hv-glow { animation: none; } }
</style>
