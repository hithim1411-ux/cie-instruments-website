---
import { u } from '../utils/url';
import categories from '../data/categories.json';
import site from '../data/site.json';
import Icon from './Icon.astro';
import { categoryIcon } from '../utils/categoryIcons';

interface Props {
  transparentHero?: boolean;
}
const { transparentHero = false } = Astro.props;

// Nav dropdown: split CIE-manufactured vs Vartech authorised-dealer categories.
// vartech-multimeters and vartech-clamp-meters excluded (CIE already covers those types).
const DROPDOWN_EXCLUDE = new Set(['vartech-multimeters', 'vartech-clamp-meters']);
const cieCategories     = categories.filter((c: any) => (!c.brand || c.brand !== 'vartech') && !DROPDOWN_EXCLUDE.has(c.id));
const vartechCategories = categories.filter((c: any) => c.brand === 'vartech' && !DROPDOWN_EXCLUDE.has(c.id));

const otherNav = [
  { label: 'Insights',  href: u('/blog')    },
  { label: 'About Us',  href: u('/about')   },
  { label: 'Contact',   href: u('/contact') },
];

const currentPath = Astro.url.pathname;
const isHome      = currentPath === '/' || currentPath === u('/');
const onProducts  = currentPath.startsWith(u('/products'));
const onInsights  = currentPath.startsWith(u('/blog'));

// Generic mailto for header button
const genericMailto = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent('Quote Request — CIE Instruments')}&body=${encodeURIComponent('Hello CIE team,\n\nI would like to request a quote for: [PRODUCT / MODEL].\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.')}`;
---


<header
  id="site-header"
  data-transparent-hero={transparentHero ? 'true' : 'false'}
  class={`fixed top-0 inset-x-0 z-50 transition-[background-color,box-shadow] duration-300 [transition-timing-function:var(--ease-premium)] ${transparentHero ? 'bg-transparent' : 'bg-ink'}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="site-header-bar" class="flex items-center justify-between h-16 lg:h-20 transition-[height] duration-300 [transition-timing-function:var(--ease-premium)]">

      <!-- Logo + wordmark -->
      <a href={u('/')} id="site-logo" class="flex items-center gap-2.5 shrink-0 min-w-0 origin-left transition-transform duration-300 [transition-timing-function:var(--ease-premium)]" aria-label="CIE Instruments — Home">
        <img
          src={u('/logo/cie-logo-transparent.webp')}
          alt="CIE® logo"
          width="800"
          height="502"
          class="h-8 sm:h-9 w-auto shrink-0"
        />
        <span class="hidden sm:flex flex-col leading-tight min-w-0">
          <span class="text-white font-semibold text-[13px] lg:text-sm tracking-tight leading-snug">Cambridge Instruments &amp; Engg. Co.</span>
          <span class="text-muted-dark text-[10px] font-mono uppercase tracking-widest leading-tight hidden lg:block">Instruments for Accuracy and Reliability</span>
        </span>
      </a>

      <!-- ── Desktop Nav ── -->
      <nav class="hidden lg:flex items-center gap-7" aria-label="Main navigation">

        <!-- Home -->
        <a href={u('/')}
           class={`text-[13.5px] font-medium tracking-wide transition-colors ${isHome ? 'text-white' : 'text-muted-dark hover:text-white'}`}>
          Home
        </a>

        <!-- Products + dropdown -->
        <div id="products-nav" class="relative">
          <div class="flex items-center">
            <!-- Clicking the text navigates to /products/ -->
            <a href={u('/products/')}
               class={`text-[13.5px] font-medium tracking-wide transition-colors ${onProducts ? 'text-white' : 'text-muted-dark hover:text-white'}`}>
              Products
            </a>
            <!-- Chevron toggle (keyboard / click entry-point for dropdown) -->
            <button
              id="products-toggle"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="Browse product categories"
              class="ml-1 p-0.5 text-muted-dark hover:text-white transition-colors focus:outline-none focus:ring-1 focus:ring-red rounded"
            >
              <svg id="products-chevron" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          </div>

          <!-- Dropdown panel — quiet, typographic, Apple-style. No imagery, no badges. -->
          <div
            id="products-dropdown"
            role="region"
            aria-label="Product categories"
            class="absolute left-1/2 -translate-x-1/2 top-[calc(100%+14px)] w-[440px]
                   opacity-0 invisible translate-y-1
                   transition-all duration-200 ease-out"
          >
            <div class="bg-ink border border-white/10 rounded-2xl shadow-2xl overflow-hidden">
              <div class="grid grid-cols-2 gap-x-8 px-6 py-6">

                <!-- ── CIE column ── -->
                <div>
                  <span class="block text-[11px] font-mono text-muted-dark uppercase tracking-widest mb-4">CIE — Manufactured in India</span>
                  <ul class="space-y-1.5" role="menu">
                    {cieCategories.map((cat) => (
                      <li role="none">
                        <a href={u(`/products/${cat.id}/`)} role="menuitem" data-dropdown-item tabindex="-1"
                          class="block text-[12.5px] font-medium text-muted-dark hover:text-white leading-tight transition-colors">
                          {cat.shortName}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={u('/products/')} data-dropdown-item tabindex="-1"
                    class="inline-block mt-4 text-xs font-semibold text-red hover:text-white transition-colors">
                    All Products →
                  </a>
                </div>

                <!-- ── Vartech column ── -->
                <div>
                  <span class="block text-[11px] font-mono text-muted-dark uppercase tracking-widest mb-4">Vartech — Authorised Dealer</span>
                  <ul class="space-y-1.5" role="menu">
                    {vartechCategories.map((cat) => (
                      <li role="none">
                        <a href={u(`/products/${cat.id}/`)} role="menuitem" data-dropdown-item tabindex="-1"
                          class="block text-[12.5px] font-medium text-muted-dark hover:text-white leading-tight transition-colors">
                          {cat.shortName}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={u('/authorised-dealership/')} data-dropdown-item tabindex="-1"
                    class="inline-block mt-4 text-xs font-semibold text-emerald-400 hover:text-white transition-colors">
                    All Vartech →
                  </a>
                </div>

              </div>
            </div>
          </div>
        </div>

        <!-- Other nav links -->
        {otherNav.map(({ label, href }) => (
          <a href={href}
             class={`text-[13.5px] font-medium tracking-wide transition-colors ${(label === 'Insights' ? onInsights : currentPath.startsWith(href)) ? 'text-white' : 'text-muted-dark hover:text-white'}`}>
            {label}
          </a>
        ))}

        <!-- Search trigger -->
        <button
          id="search-trigger"
          aria-label="Search products"
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-muted-dark hover:text-white transition-colors text-sm"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
          </svg>
          <span class="text-xs">Search</span>
          <kbd class="hidden xl:inline-flex items-center gap-0.5 px-1.5 py-0.5 bg-white/10 rounded text-[9px] font-mono text-muted border border-white/10">⌘K</kbd>
        </button>

        <a href={genericMailto}
           class="px-4 py-2 bg-red hover:bg-red-dark text-white text-[13.5px] font-semibold rounded-lg transition-colors">
          Request a Quote
        </a>
      </nav>

      <!-- Mobile: search + hamburger grouped right -->
      <div class="lg:hidden flex items-center gap-1">
        <button
          id="search-trigger-mobile"
          aria-label="Search products"
          class="p-2 rounded text-muted-dark hover:text-white focus:outline-none"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/>
          </svg>
        </button>
        <button
          id="nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded text-muted-dark hover:text-white focus:outline-none focus:ring-2 focus:ring-red"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ── Mobile Menu ── -->
  <div id="mobile-menu" class="hidden lg:hidden bg-ink border-t border-white/10 max-h-[calc(100vh-4rem)] overflow-y-auto">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1" aria-label="Mobile navigation">

      <!-- Home -->
      <a href={u('/')} class="text-sm font-medium text-muted-dark hover:text-white hover:bg-white/5 px-3 py-2 rounded transition-colors">
        Home
      </a>

      <!-- Products accordion -->
      <div>
        <div class="flex items-center">
          <a href={u('/products/')} class="flex-1 text-sm font-medium text-muted-dark hover:text-white hover:bg-white/5 px-3 py-2 rounded-l transition-colors">
            All Products
          </a>
          <button
            id="mobile-products-toggle"
            aria-expanded="false"
            aria-controls="mobile-products-dropdown"
            aria-label="Show product categories"
            class="px-3 py-2 text-muted-dark hover:text-white hover:bg-white/5 rounded-r transition-colors"
          >
            <svg id="mobile-products-chevron" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>

        <!-- Category accordion panel -->
        <div id="mobile-products-dropdown" class="hidden ml-3 border-l border-white/10 pl-3 py-1 mt-0.5">
          <p class="px-2 pt-1 pb-0.5 text-[10px] font-mono text-muted uppercase tracking-widest">CIE — Manufactured</p>
          {cieCategories.map(cat => (
            <a href={u(`/products/${cat.id}/`)}
               class="flex items-center gap-2.5 px-2 py-2 text-xs text-muted-dark hover:text-muted-dark hover:bg-white/5 rounded transition-colors">
              <Icon name={categoryIcon(cat.id)} class="w-3.5 h-3.5 shrink-0 text-muted-dark" />
              {cat.shortName}
            </a>
          ))}
          <p class="px-2 pt-3 pb-0.5 text-[10px] font-mono text-emerald-500 uppercase tracking-widest border-t border-white/10 mt-1">Vartech® — Authorised Dealer</p>
          {vartechCategories.map(cat => (
            <a href={u(`/products/${cat.id}/`)}
               class="flex items-center gap-2.5 px-2 py-2 text-xs text-emerald-400/80 hover:text-emerald-300 hover:bg-white/5 rounded transition-colors">
              <Icon name={categoryIcon(cat.id)} class="w-3.5 h-3.5 shrink-0 text-emerald-500/70" />
              {cat.shortName}
            </a>
          ))}
          <a href={u('/authorised-dealership/')}
             class="flex items-center gap-2.5 px-2 py-2 text-xs text-emerald-400 hover:text-emerald-300 hover:bg-white/5 rounded transition-colors mt-1 border-t border-white/10 pt-2">
            <Icon name="store" class="w-3.5 h-3.5 shrink-0" />
            All Vartech — Authorised Dealership
          </a>
        </div>
      </div>

      {otherNav.map(({ label, href }) => (
        <a href={href} class="text-sm font-medium text-muted-dark hover:text-white hover:bg-white/5 px-3 py-2 rounded transition-colors">
          {label}
        </a>
      ))}

      <a href={genericMailto}
         class="mt-2 px-4 py-2.5 bg-red hover:bg-red-dark text-white text-sm font-semibold rounded text-center transition-colors">
        Request a Quote
      </a>
    </nav>
  </div>
</header>

<script>
// ── Desktop dropdown: hover-intent + keyboard ──────────────────────────────
const container  = document.getElementById('products-nav') as HTMLElement;
const toggle     = document.getElementById('products-toggle') as HTMLButtonElement;
const dropdown   = document.getElementById('products-dropdown') as HTMLElement;
const chevron    = document.getElementById('products-chevron') as SVGElement;
const menuItems  = Array.from(dropdown?.querySelectorAll<HTMLElement>('[data-dropdown-item]') ?? []);

let openTimer: ReturnType<typeof setTimeout>;
let closeTimer: ReturnType<typeof setTimeout>;

function openDropdown() {
  clearTimeout(closeTimer);
  dropdown.classList.remove('opacity-0', 'invisible', 'translate-y-1');
  dropdown.classList.add('opacity-100', 'visible', 'translate-y-0');
  toggle.setAttribute('aria-expanded', 'true');
  chevron.classList.add('rotate-180');
  menuItems.forEach(el => el.setAttribute('tabindex', '0'));
}

function closeDropdown() {
  clearTimeout(openTimer);
  dropdown.classList.add('opacity-0', 'invisible', 'translate-y-1');
  dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
  toggle.setAttribute('aria-expanded', 'false');
  chevron.classList.remove('rotate-180');
  menuItems.forEach(el => el.setAttribute('tabindex', '-1'));
}

// Hover-intent: 100 ms open delay, 150 ms close delay (keeps panel open while cursor moves into it)
container?.addEventListener('mouseenter', () => {
  clearTimeout(closeTimer);
  openTimer = setTimeout(openDropdown, 100);
});
container?.addEventListener('mouseleave', () => {
  clearTimeout(openTimer);
  closeTimer = setTimeout(closeDropdown, 150);
});

// Click / Enter / Space on chevron button
toggle?.addEventListener('click', (e) => {
  e.stopPropagation();
  toggle.getAttribute('aria-expanded') === 'true' ? closeDropdown() : openDropdown();
});
toggle?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    toggle.getAttribute('aria-expanded') === 'true' ? closeDropdown() : (() => { openDropdown(); menuItems[0]?.focus(); })();
  }
  if (e.key === 'Escape') { closeDropdown(); }
  if (e.key === 'ArrowDown') { e.preventDefault(); openDropdown(); menuItems[0]?.focus(); }
});

// Arrow-key nav inside dropdown
menuItems.forEach((item, i) => {
  item.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); (menuItems[i + 1] ?? menuItems[0]).focus(); }
    if (e.key === 'ArrowUp')   { e.preventDefault(); i === 0 ? toggle?.focus() : menuItems[i - 1].focus(); }
    if (e.key === 'Escape')    { closeDropdown(); toggle?.focus(); }
    if (e.key === 'Tab' && !e.shiftKey && i === menuItems.length - 1) { closeDropdown(); }
  });
});

// Click outside → close
document.addEventListener('click', (e) => {
  if (container && !container.contains(e.target as Node)) closeDropdown();
});

// ── Mobile accordion ───────────────────────────────────────────────────────
const mobileToggle   = document.getElementById('mobile-products-toggle') as HTMLButtonElement;
const mobileDropdown = document.getElementById('mobile-products-dropdown') as HTMLElement;
const mobileChevron  = document.getElementById('mobile-products-chevron') as SVGElement;

mobileToggle?.addEventListener('click', () => {
  const isHidden = mobileDropdown.classList.contains('hidden');
  mobileDropdown.classList.toggle('hidden', !isHidden);
  mobileToggle.setAttribute('aria-expanded', String(isHidden));
  mobileChevron.classList.toggle('rotate-180', isHidden);
});

// ── Mobile hamburger (already wired in Base.astro, keep in sync) ──────────
const navToggle  = document.getElementById('nav-toggle') as HTMLButtonElement;
const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
navToggle?.addEventListener('click', () => {
  const open = mobileMenu?.classList.toggle('hidden');
  navToggle.setAttribute('aria-expanded', String(!open));
});

// ── Search triggers ────────────────────────────────────────────────────────
function openSearch() {
  const fn = (window as any).__openCIESearch;
  if (fn) fn();
}
document.getElementById('search-trigger')?.addEventListener('click', openSearch);
document.getElementById('search-trigger-mobile')?.addEventListener('click', openSearch);

// ── Scroll-condense: shrink height + add blur/shadow once scrolled ────────
// On pages with a dark full-bleed hero (transparentHero), the header starts
// fully transparent and blended into the hero; everywhere else it keeps its
// existing solid dark background at all times. Either way, past a small
// scroll threshold it condenses to a solid blurred bar.
const header = document.getElementById('site-header') as HTMLElement;
const headerBar = document.getElementById('site-header-bar') as HTMLElement;
const siteLogo = document.getElementById('site-logo') as HTMLElement | null;
const isTransparentHero = header?.dataset.transparentHero === 'true';

function updateScrollState() {
  const scrolled = window.scrollY > 8;
  header?.classList.toggle('bg-ink/80', scrolled);
  header?.classList.toggle('backdrop-blur-xl', scrolled);
  header?.classList.toggle('shadow-lg', scrolled);
  if (isTransparentHero) {
    header?.classList.toggle('bg-transparent', !scrolled);
  } else {
    header?.classList.toggle('bg-ink', !scrolled);
  }
  headerBar?.classList.toggle('h-14', scrolled);
  headerBar?.classList.toggle('lg:h-16', scrolled);
  headerBar?.classList.toggle('h-16', !scrolled);
  headerBar?.classList.toggle('lg:h-20', !scrolled);
  siteLogo?.classList.toggle('scale-90', scrolled);
}
updateScrollState();
window.addEventListener('scroll', updateScrollState, { passive: true });
</script>
