---
---
<style is:global>
  .tpl-crumbs .text-ink { color: #fff; }
  .tpl-pill { padding: .25rem .7rem; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(255,255,255,.04); }
  .tpl-card { padding: 1.4rem; border: 1px solid var(--color-border); border-radius: 1.2rem; background: #fff; box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 16px 40px -24px rgba(16,24,40,.22); scroll-margin-top: 6rem; }
  @media (min-width: 640px) { .tpl-card { padding: 2rem; } }
  .tpl-head { display: grid; gap: 1.4rem; }
  @media (min-width: 720px) { .tpl-head { grid-template-columns: 11rem minmax(0, 1fr); gap: 2rem; align-items: start; } }
  .tpl-thumb { display: block; border: 1px solid var(--color-border); border-radius: .5rem; overflow: hidden; box-shadow: 0 10px 28px -14px rgba(10,14,20,.35); transition: transform .25s var(--ease-premium), box-shadow .25s; max-width: 11rem; }
  .tpl-thumb:hover { transform: translateY(-3px); box-shadow: 0 16px 34px -14px rgba(10,14,20,.45); }
  .tpl-thumb img { display: block; width: 100%; height: auto; }
  .tpl-std { margin: 0 0 .35rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--color-red); font-weight: 700; }
  .tpl-name { margin: 0; font-size: 1.5rem; font-weight: 800; color: var(--color-ink); line-height: 1.2; }
  .tpl-sum { margin: .5rem 0 0; max-width: 40rem; color: var(--color-muted); line-height: 1.6; }
  .tpl-dl { display: inline-flex; align-items: center; gap: .6rem; margin-top: 1.1rem; }
  .tpl-dl-sub { font-family: var(--font-mono); font-size: .7rem; opacity: .8; }
  .tpl-body { display: grid; gap: 1.6rem; margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid var(--color-border); }
  @media (min-width: 900px) { .tpl-body { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 2.4rem; } }
  .tpl-h { margin: 0 0 .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--color-muted); font-weight: 700; }
  .tpl-list { margin: 0; padding-left: 1.1rem; list-style: disc; display: grid; gap: .45rem; font-size: .92rem; line-height: 1.6; color: var(--color-ink); }
  .tpl-text { margin: 0; font-size: .9rem; line-height: 1.6; color: var(--color-muted); }
  .tpl-rel { margin: 0; padding: 0; list-style: none; display: grid; gap: .35rem; font-size: .9rem; font-weight: 600; }
  .tpl-rel a { color: var(--color-red); } .tpl-rel a:hover { text-decoration: underline; }
  .tpl-notes { margin-top: 2.4rem; max-width: 52rem; }
  .tpl-notes h2 { font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin: 0 0 .7rem; }
  .tpl-notes ul { margin: 0; padding-left: 1.1rem; list-style: disc; display: grid; gap: .5rem; font-size: .92rem; line-height: 1.65; color: var(--color-muted); }
</style>
<style is:global>
  .tpl-grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .tpl-tile { display: flex; flex-direction: column; gap: .9rem; padding: 1.1rem; border: 1px solid var(--color-border); border-radius: 1.1rem; background: #fff; scroll-margin-top: 6rem; box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 14px 34px -24px rgba(16,24,40,.22); }
  .tpl-tile .tpl-thumb { max-width: none; }
  .tpl-tile h2 { margin: 0; font-size: 1.1rem; font-weight: 800; line-height: 1.25; color: var(--color-ink); }
  .tpl-tile p { margin: 0; font-size: .88rem; line-height: 1.55; color: var(--color-muted); }
  .tpl-tile .tpl-links { margin-top: auto; display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; font-size: .86rem; font-weight: 700; }
  .tpl-tile .tpl-links a { color: var(--color-red); } .tpl-tile .tpl-links a:hover { text-decoration: underline; }
  .tpl-faq { margin-top: 2rem; max-width: 52rem; }
  .tpl-faq h2 { font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin: 0 0 .8rem; }
  .tpl-faq details { border-top: 1px solid var(--color-border); padding: .8rem 0; }
  .tpl-faq summary { cursor: pointer; font-weight: 700; color: var(--color-ink); }
  .tpl-faq details p { margin: .5rem 0 0; color: var(--color-muted); line-height: 1.65; font-size: .92rem; }
  .tpl-more { margin-top: 2.4rem; }
  .tpl-more h2 { font-size: 1.25rem; font-weight: 800; color: var(--color-ink); margin: 0 0 1rem; }
</style>
