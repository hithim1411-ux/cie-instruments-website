---
interface Props {
  model: string;
  name: string;
  tagline: string;
  categoryId: string;
  id: string;
  featured?: boolean;
  image?: string;
  hideImage?: boolean;
}
const { model, name, tagline, categoryId, id, featured = false, image, hideImage = false } = Astro.props;
import site from '../data/site.json';
import { u } from '../utils/url';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
const waMsg = encodeURIComponent(`Hi, I'd like to enquire about the ${model} — ${name}`);
// Vartech images live at /images/vartech/... not /images/products/vartech/...
const imgSrc = image
  ? (image.startsWith('vartech/') ? u(`/images/${image}`) : u(`/images/products/${image}`))
  : u(`/images/products/${id}.webp`);
// Vartech products live under /authorised-dealership/{slug}/, not /products/{categoryId}/
// categoryId pattern: "vartech-oscilloscopes" → dealer slug: "oscilloscopes"
const detailHref = categoryId.startsWith('vartech-')
  ? u(`/authorised-dealership/${categoryId.replace('vartech-', '')}/${id}/`)
  : u(`/products/${categoryId}/${id}/`);
const isVartech = categoryId.startsWith('vartech-');
---

<article class="card card-interactive group overflow-hidden flex flex-col">
  <!-- Product image -->
  {!hideImage && (
    <div class="bg-cloud h-56 flex items-center justify-center relative overflow-hidden">
      <img
        src={imgSrc}
        alt={`${model} — ${name}`}
        width="600"
        height="600"
        class="object-contain h-44 w-auto transition-transform duration-300 [transition-timing-function:var(--ease-premium)] group-hover:scale-105"
        loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
      />
      <!-- Placeholder when no image supplied -->
      <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 text-muted/60">
        <svg class="w-12 h-12 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"/>
          <path d="M3 9l4-4 4 4 4-4 4 4" stroke-width="1.5"/>
        </svg>
        <span class="text-xs font-mono uppercase tracking-wider opacity-50">Image coming soon</span>
      </div>
      {isVartech ? (
        <Badge variant="emerald" class="absolute top-3 left-3">Vartech®</Badge>
      ) : featured && (
        <Badge variant="red" class="absolute top-3 right-3">Featured</Badge>
      )}
    </div>
  )}

  <div class="p-6 flex flex-col flex-1">
    <p class="model-code text-xs mb-1.5">{model}</p>
    <h3 class="font-bold text-ink text-lg mb-2 leading-snug tracking-tight">{name}</h3>
    <p class="text-sm text-muted mb-5 flex-1 line-clamp-2 leading-relaxed">{tagline}</p>

    <div class="flex flex-col gap-2 mt-auto">
      <a href={detailHref} class="btn-primary btn-primary--sm">
        View Specifications
      </a>
      <a
        href={`https://wa.me/${site.whatsapp}?text=${waMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary btn-secondary--sm text-ink"
      >
        <Icon name="message-circle" class="w-4 h-4 shrink-0" />
        Enquire on WhatsApp
      </a>
    </div>
  </div>
</article>
