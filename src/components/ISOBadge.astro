---
import { u } from '../utils/url';

interface Props { class?: string; }
const { class: cls = '' } = Astro.props;
---
<a href={u('/about/#iso-certificate')} class:list={['font-mono text-xs uppercase tracking-wider font-semibold text-ink hover:text-red transition-colors', cls]} aria-label="ISO 9001:2015 certified - view certificate">ISO 9001:2015 Certified →</a>
