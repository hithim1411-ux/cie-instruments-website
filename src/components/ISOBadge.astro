---
import { u } from '../utils/url';

interface Props { class?: string; link?: boolean; }
const { class: cls = '', link = true } = Astro.props;
const src = u('/certificates/iso-9001-badge.svg');
---
{link ? (
  <a href={`${u('/about/')}#iso-certificate`} class:list={['inline-block', cls]} aria-label="ISO 9001:2015 certified - view certificate">
    <img src={src} alt="ISO 9001:2015 Certified" width="150" height="50" class="h-14 w-auto" loading="lazy" />
  </a>
) : (
  <span class:list={['inline-block', cls]}>
    <img src={src} alt="ISO 9001:2015 Certified" width="150" height="50" class="h-14 w-auto" loading="lazy" />
  </span>
)}
