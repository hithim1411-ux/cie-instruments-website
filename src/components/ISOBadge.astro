---
import { u } from '../utils/url';

interface Props { dark?: boolean; class?: string; link?: boolean; }
const { dark = false, class: cls = '', link = true } = Astro.props;
const src = u(dark ? '/certificates/iso-9001-badge-dark.svg' : '/certificates/iso-9001-badge.svg');
---
{link ? (
  <a href={u('/about/#iso-9001')} class:list={['inline-block', cls]} aria-label="ISO 9001:2015 certified - view certificate">
    <img src={src} alt="ISO 9001:2015 certified quality management system" width="96" height="96" class="h-16 w-16" loading="lazy" />
  </a>
) : (
  <img src={src} alt="ISO 9001:2015 certified quality management system" width="96" height="96" class:list={['h-16 w-16', cls]} loading="lazy" />
)}
