---
// Adds prev/next arrows, a counter, swipe and arrow-key navigation to any
// product gallery (#gallery-main + .gallery-thumb buttons) with 2+ images.
// Works with each page's existing thumbnail click handler.
---
<script>
  const main = document.getElementById('gallery-main') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));
  const stage = main?.parentElement as HTMLElement | null;
  if (main && stage && thumbs.length > 1) {
    stage.classList.add('relative', 'select-none');
    stage.style.touchAction = 'pan-y';
    main.draggable = false;
    const arrow = (dir: 'prev' | 'next') => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', dir === 'prev' ? 'Previous image' : 'Next image');
      b.className = `absolute ${dir === 'prev' ? 'left-2' : 'right-2'} top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 border border-border shadow flex items-center justify-center text-ink hover:bg-white active:scale-95 transition`;
      b.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${dir === 'prev' ? 'M15 18l-6-6 6-6' : 'M9 18l6-6-6-6'}"/></svg>`;
      return b;
    };
    const prev = arrow('prev'), next = arrow('next');
    const count = document.createElement('span');
    count.className = 'absolute bottom-2 right-3 text-xs font-mono bg-white/90 border border-border rounded-full px-2 py-0.5 text-ink';
    stage.append(prev, next, count);

    let cur = Math.max(0, thumbs.findIndex(t => t.classList.contains('border-ink')));
    const render = () => { count.textContent = `${cur + 1} / ${thumbs.length}`; };
    const go = (i: number) => { cur = (i + thumbs.length) % thumbs.length; thumbs[cur].click(); };
    thumbs.forEach((t, i) => t.addEventListener('click', () => { cur = i; render(); }));
    prev.addEventListener('click', () => go(cur - 1));
    next.addEventListener('click', () => go(cur + 1));
    render();

    let x0 = 0, y0 = 0;
    stage.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? cur + 1 : cur - 1);
    }, { passive: true });
    document.addEventListener('keydown', e => {
      if (/INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement).tagName)) return;
      if (e.key === 'ArrowLeft') go(cur - 1);
      if (e.key === 'ArrowRight') go(cur + 1);
    });
  }
</script>
