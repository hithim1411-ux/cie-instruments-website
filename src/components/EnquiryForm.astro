---
import Icon from './Icon.astro';
import site from '../data/site.json';
import categories from '../data/categories.json';
import products from '../data/products.json';
import configCatalogues from '../data/config-catalogues.json';
import vartechMultimeters from '../data/vartech-multimeters.json';
import vartechClampMeters from '../data/vartech-clamp-meters.json';
import vartechOscilloscopes from '../data/vartech-oscilloscopes.json';
import vartechFunctionGenerators from '../data/vartech-function-generators.json';
import vartechLcrMeters from '../data/vartech-lcr-meters.json';
import vartechDcLoads from '../data/vartech-dc-loads.json';
import vartechSoundLevelMeters from '../data/vartech-sound-level-meters.json';
import vartechAnemometers from '../data/vartech-anemometers.json';
import vartechCalibrators from '../data/vartech-calibrators.json';
import vartechLuxMeters from '../data/vartech-lux-meters.json';
import vartechThermometers from '../data/vartech-thermometers.json';
import vartechSolderingStations from '../data/vartech-soldering-stations.json';
import vartechReworkStations from '../data/vartech-rework-stations.json';
import vartechSolderingIrons from '../data/vartech-soldering-irons.json';
import vartechMagnifiers from '../data/vartech-magnifiers.json';
import vartechSolderingAccessories from '../data/vartech-soldering-accessories.json';
import vartechDcPowerSupplies from '../data/vartech-dc-power-supplies.json';

interface Props {
  productName?: string;
}
const { productName = '' } = Astro.props;

const vartechByCategory: Record<string, {id: string, model: string, name: string}[]> = {
  'vartech-multimeters':          vartechMultimeters.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-clamp-meters':         vartechClampMeters.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-oscilloscopes':        vartechOscilloscopes.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-function-generators':  vartechFunctionGenerators.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-lcr-meters':           vartechLcrMeters.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-dc-loads':             vartechDcLoads.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-sound-level-meters':   vartechSoundLevelMeters.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-anemometers':          vartechAnemometers.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-calibrators':          vartechCalibrators.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-lux-meters':           vartechLuxMeters.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-thermometers':         vartechThermometers.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-soldering-stations': vartechSolderingStations.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-rework-stations': vartechReworkStations.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-soldering-irons': vartechSolderingIrons.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-magnifiers': vartechMagnifiers.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-soldering-accessories': vartechSolderingAccessories.map(p => ({ id: p.id, model: p.model, name: p.name })),
  'vartech-dc-power-supplies':    vartechDcPowerSupplies.map(p => ({ id: p.id, model: p.model, name: p.name })),
};

const productsByCategory = categories.map(cat => ({
  id:   cat.id,
  name: cat.name,
  products: [
    ...products.filter(p => p.categoryId === cat.id).map(p => ({ id: p.id, model: p.model, name: p.name })),
    ...(vartechByCategory[cat.id] ?? []),
  ],
}));

// Standard configurations offered per model (reuses the data behind the product-page
// catalogue picker, minus the PDF paths), keyed by model so the form can offer
// them as selects. Models with a fixed spec (clamp meters, multimeters, etc.) have none.
const configByModel: Record<string, any> = {};
for (const p of products as any[]) {
  const c = (configCatalogues as Record<string, any>)[p.id];
  if (!c) continue;
  if (c.type === 'vr') {
    configByModel[p.model] = { type: 'vr', options: c.options.map((o: any) => ({ voltage: o.voltage, ranges: o.ranges.map((r: any) => r.range) })) };
  } else if (c.type === 'series') {
    configByModel[p.model] = { type: 'list', label: 'Series', options: c.options.map((o: any) => `${o.series} (${o.detail})`) };
  } else if (c.type === 'grp') {
    const data: Record<string, Record<string, { range: string; bto: boolean }[]>> = {};
    for (const [lvl, groups] of Object.entries(c.data as Record<string, any>)) {
      data[lvl] = {};
      for (const [g, rs] of Object.entries(groups as Record<string, any[]>)) data[lvl][g] = rs.map((r) => ({ range: r.range, bto: !!r.bto }));
    }
    configByModel[p.model] = { type: 'grp', levelLabel: c.levelLabel ?? null, levels: c.levels ?? null, data };
  }
}
const table = (id: string, i = 0) => (products as any[]).find((p) => p.id === id)?.specTables?.[i];
const hv5050 = table('cie-5050a');
if (hv5050) configByModel['CIE/5050A'] = { type: 'list', label: 'Variant', options: hv5050.rows.map((r: any) => `${r.col0} - ${r.col1}, trip ${r.col2}`) };
const oil = table('cie-7050');
if (oil) configByModel['CIE/7000 Series'] = { type: 'list', label: 'Output voltage / model',
  options: oil.rows.flatMap((r: any) => [`${r.col2} - ${r.col0}, ${r.col1} (manual)`, `${r.col3} - ${r.col0}, ${r.col1} (motorised)`]) };

const waMsg = productName
  ? encodeURIComponent(`Hi, I'd like a quote for: ${productName}`)
  : encodeURIComponent("Hi, I'd like to enquire about CIE instruments.");
---

<!-- Products data is passed via define:vars in the script below -->

<div class="bg-white rounded-xl border border-border p-6 sm:p-8">
  <h2 class="text-xl font-bold text-ink mb-6">Request a Quote</h2>

  <form id="quote-form" novalidate class="space-y-5">

    <!-- ── Row 1: Category + Product ── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="qf-category" class="block text-sm font-medium text-ink mb-1">
          Product Category <span class="text-red">*</span>
        </label>
        <select
          id="qf-category"
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors text-ink"
        >
          <option value="">Select a category</option>
          {categories.map(cat => (
            <option value={cat.id}>{cat.name}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="qf-product" class="block text-sm font-medium text-ink mb-1">
          Model / Instrument <span class="text-red">*</span>
        </label>
        <select
          id="qf-product"
          disabled
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors text-ink disabled:bg-cloud disabled:text-muted disabled:cursor-not-allowed"
        >
          <option value="">Select category first</option>
        </select>
      </div>
    </div>

    <!-- ── Standard configurations for the chosen model (filled by script) ── -->
    <div id="qf-config" style="display:none" class="grid grid-cols-1 sm:grid-cols-2 gap-4 rounded-lg border border-border bg-cloud p-4">
      <div id="qf-cfg-a-wrap">
        <label for="qf-cfg-a" id="qf-cfg-a-label" class="block text-sm font-medium text-ink mb-1">Standard option</label>
        <select id="qf-cfg-a" class="w-full px-3 py-2.5 border border-border rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors text-ink"></select>
      </div>
      <div id="qf-cfg-b-wrap">
        <label for="qf-cfg-b" id="qf-cfg-b-label" class="block text-sm font-medium text-ink mb-1">Range</label>
        <select id="qf-cfg-b" class="w-full px-3 py-2.5 border border-border rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors text-ink disabled:bg-cloud disabled:text-muted"></select>
      </div>
      <p class="sm:col-span-2 text-xs text-muted -mt-1">Pick a standard configuration, or choose Other and describe what you need below. Non-standard ranges can be built to order.</p>
    </div>

    <!-- ── Rated voltage / range (context-sensitive hint) ── -->
    <div id="qf-spec-row">
      <label for="qf-spec" class="block text-sm font-medium text-ink mb-1">
        Rated Voltage &amp; Range
      </label>
      <input
        type="text"
        id="qf-spec"
        name="spec"
        placeholder="e.g. 500 V / 0–1000 MΩ - leave blank if unsure, we'll advise"
        class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
      />
      <p id="qf-spec-hint" class="mt-1 text-xs text-muted hidden"></p>
    </div>

    <!-- ── Row 2: Name + Company ── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="qf-name" class="block text-sm font-medium text-ink mb-1">
          Full Name <span class="text-red">*</span>
        </label>
        <input
          type="text" id="qf-name" autocomplete="name" required
          placeholder="Your name"
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
        />
      </div>
      <div>
        <label for="qf-company" class="block text-sm font-medium text-ink mb-1">
          Company / Organisation
        </label>
        <input
          type="text" id="qf-company" autocomplete="organization"
          placeholder="Your company"
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
        />
      </div>
    </div>

    <!-- ── Row 3: Phone + Quantity ── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="qf-phone" class="block text-sm font-medium text-ink mb-1">
          Phone Number
        </label>
        <input
          type="tel" id="qf-phone" autocomplete="tel"
          placeholder="+91 ..."
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
        />
      </div>
      <div>
        <label for="qf-qty" class="block text-sm font-medium text-ink mb-1">
          Quantity Required
        </label>
        <input
          type="text" id="qf-qty"
          placeholder="e.g. 2 nos."
          class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink transition-colors"
        />
      </div>
    </div>

    <!-- ── Message / Requirement ── -->
    <div>
      <label for="qf-message" class="block text-sm font-medium text-ink mb-1">
        Additional Requirement / Notes
      </label>
      <textarea
        id="qf-message" rows="3"
        placeholder="Any special specifications, delivery requirements, or questions…"
        class="w-full px-3 py-2.5 border border-border rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-ink/20 focus:border-ink resize-y transition-colors"
      ></textarea>
    </div>

    <!-- Validation message -->
    <p id="qf-error" class="hidden text-sm text-red font-medium"></p>

    <!-- ── Preview of email body ── -->
    <div id="qf-preview-wrap" class="hidden">
      <p class="text-xs font-mono font-bold text-muted uppercase tracking-widest mb-2">Preview - email that will open</p>
      <pre
        id="qf-preview"
        class="bg-cloud border border-border rounded-lg px-4 py-3 text-xs text-ink leading-relaxed whitespace-pre-wrap break-words font-mono max-h-52 overflow-y-auto"
      ></pre>
    </div>

    <!-- ── Actions ── -->
    <div class="flex flex-col sm:flex-row gap-3 pt-1">
      <button type="submit" class="btn-primary flex-1">
        <Icon name="mail" class="w-4 h-4 shrink-0" />
        Open in Email
      </button>
      <a
        href={`https://wa.me/${site.whatsapp}?text=${waMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary flex-1 text-ink"
      >
        <Icon name="message-circle" class="w-4 h-4 shrink-0" />
        Enquire on WhatsApp
      </a>
    </div>

  </form>
</div>

<script define:vars={{ productsByCategory, configByModel }}>
// ── Data (injected at build time via define:vars) ─────────────────────────────
const catData = productsByCategory;

// ── Elements ─────────────────────────────────────────────────────────────────
const form        = document.getElementById('quote-form');
const catSel      = document.getElementById('qf-category');
const prodSel     = document.getElementById('qf-product');
const specInput   = document.getElementById('qf-spec');
const specHint    = document.getElementById('qf-spec-hint');
const nameInput   = document.getElementById('qf-name');
const compInput   = document.getElementById('qf-company');
const phoneInput  = document.getElementById('qf-phone');
const qtyInput    = document.getElementById('qf-qty');
const msgInput    = document.getElementById('qf-message');
const errorEl     = document.getElementById('qf-error');
const previewWrap = document.getElementById('qf-preview-wrap');
const previewEl   = document.getElementById('qf-preview');

const cfgWrap  = document.getElementById('qf-config');
const cfgA     = document.getElementById('qf-cfg-a');
const cfgB     = document.getElementById('qf-cfg-b');
const cfgAWrap = document.getElementById('qf-cfg-a-wrap');
const cfgBWrap = document.getElementById('qf-cfg-b-wrap');
const cfgALbl  = document.getElementById('qf-cfg-a-label');
const cfgBLbl  = document.getElementById('qf-cfg-b-label');
const OTHER = '__other';
let cfg = null;

function opt(value, text) { const o = document.createElement('option'); o.value = value; o.textContent = text; return o; }
function resetSelect(sel, placeholder) { sel.innerHTML = ''; sel.appendChild(opt('', placeholder)); }
function showA(on) { cfgAWrap.classList.toggle('hidden', !on); }
function showB(on) { cfgBWrap.classList.toggle('hidden', !on); }

function clearConfig() {
  cfg = null;
  cfgWrap.style.display = 'none';
  resetSelect(cfgA, ''); resetSelect(cfgB, '');
}

// Write the picked configuration into the (still editable) spec field.
function applyConfig() {
  if (!cfg) return;
  let text = '';
  const a = cfgA.value, b = cfgB.value;
  if (cfg.type === 'vr') {
    if (a === OTHER || b === OTHER) text = '';
    else if (a && b) text = `${a} V, ${b}`;
    else if (a) text = `${a} V`;
  } else if (cfg.type === 'list') {
    text = a && a !== OTHER ? cfgA.selectedOptions[0].textContent : '';
  } else if (cfg.type === 'grp') {
    const lvl = cfg.levels && a && a !== OTHER ? cfgA.selectedOptions[0].textContent : '';
    const rng = b && b !== OTHER ? cfgB.selectedOptions[0].textContent : '';
    text = [lvl, rng].filter(Boolean).join(', ');
    if (a === OTHER || b === OTHER) text = '';
  }
  specInput.value = text;
  if ((a === OTHER || b === OTHER)) specInput.focus();
  updatePreview();
}

function buildConfig(model) {
  clearConfig();
  const c = configByModel[model];
  if (!c) return;
  cfg = c;
  cfgWrap.style.display = '';
  if (c.type === 'vr') {
    cfgALbl.textContent = 'Rated voltage'; cfgBLbl.textContent = 'Insulation range';
    resetSelect(cfgA, 'Select voltage'); resetSelect(cfgB, 'Select voltage first');
    c.options.forEach(o => cfgA.appendChild(opt(String(o.voltage), `${o.voltage} V`)));
    cfgA.appendChild(opt(OTHER, 'Other / custom voltage'));
    cfgB.disabled = true; showA(true); showB(true);
  } else if (c.type === 'list') {
    cfgALbl.textContent = c.label; resetSelect(cfgA, `Select ${c.label.toLowerCase()}`);
    c.options.forEach(o => cfgA.appendChild(opt(o, o)));
    cfgA.appendChild(opt(OTHER, 'Other / custom'));
    showA(true); showB(false);
  } else if (c.type === 'grp') {
    cfgBLbl.textContent = 'Measuring range';
    if (c.levels) {
      cfgALbl.textContent = c.levelLabel; resetSelect(cfgA, `Select ${c.levelLabel.toLowerCase()}`);
      c.levels.forEach(l => cfgA.appendChild(opt(l.key, l.label)));
      resetSelect(cfgB, 'Select terminals first'); cfgB.disabled = true; showA(true);
    } else {
      showA(false); resetSelect(cfgB, 'Select range'); cfgB.disabled = false; fillGroups(c.data['_']);
    }
    showB(true);
  }
}

function fillGroups(groups) {
  Object.entries(groups).forEach(([g, rs]) => {
    const og = document.createElement('optgroup'); og.label = g;
    rs.forEach(r => og.appendChild(opt(r.range, r.range + (r.bto ? ' (built to order)' : ''))));
    cfgB.appendChild(og);
  });
  cfgB.appendChild(opt(OTHER, 'Other / custom range'));
}

cfgA.addEventListener('change', () => {
  if (!cfg) return;
  if (cfg.type === 'vr') {
    resetSelect(cfgB, 'Select range');
    const o = cfg.options.find(x => String(x.voltage) === cfgA.value);
    cfgB.disabled = !o;
    if (o) { o.ranges.forEach(r => cfgB.appendChild(opt(r, r))); cfgB.appendChild(opt(OTHER, 'Other / custom range')); }
  } else if (cfg.type === 'grp' && cfg.levels) {
    resetSelect(cfgB, 'Select range');
    const groups = cfg.data[cfgA.value];
    cfgB.disabled = !groups;
    if (groups) fillGroups(groups);
  }
  applyConfig();
});
cfgB.addEventListener('change', applyConfig);
prodSel.addEventListener('change', () => buildConfig(prodSel.value));

// Spec hints per category
const specHints = {
  'insulation-testers-hand':         'Specify rated voltage (e.g. 500 V) and resistance range (e.g. 0–1000 MΩ)',
  'multirange-insulation-hand':      'Specify series - MR-1, MR-2, MR-3, or MR-4 (CIE/444/MR) or up to MR-8 (CIE/666/MR)',
  'motor-operated-insulation':       'Specify rated voltage (e.g. 2500 V) and resistance range (e.g. 0–10000 MΩ)',
  'multirange-motorised-insulation': 'Specify series - MR-A, MR-B, MR-C, MR-D, or MR-E',
  'compact-insulation-testers':      'Specify rated voltage (e.g. 500 V) and resistance range',
  'earth-tester':                    'Specify number of terminals (3-terminal or 4-terminal) if known',
  'digital-insulation-testers':      'Specify rated voltage range if known (e.g. up to 5000 V)',
  'digital-earth-micro-ohm':         'Specify measurement type: earth resistance, micro-ohm, or both',
  'clamp-meters':                    'Specify current range and any features required (True RMS, temperature, etc.)',
  'multimeters':                     'Specify any features required (True RMS, capacitance, temperature, etc.)',
  'hv-phase-sequence':               'Specify test voltage (for HV sets) or "phase sequence" for PSI models',
  'oil-test-sets':                   'Specify number of tests per cycle and required breakdown voltage range',
  'relay-test-sets':                 'Specify single-phase (RTS-5/5A) or three-phase (RTS-33)',
};

// ── Cascade: category → product dropdown ─────────────────────────────────────
catSel.addEventListener('change', () => {
  const catId = catSel.value;
  const cat   = catData.find(c => c.id === catId);

  // Reset product dropdown
  clearConfig();
  prodSel.innerHTML = '';
  if (!cat) {
    prodSel.innerHTML = '<option value="">Select category first</option>';
    prodSel.disabled = true;
    specHint.classList.add('hidden');
    specHint.textContent = '';
    updatePreview();
    return;
  }

  const placeholder = document.createElement('option');
  placeholder.value = '';
  placeholder.textContent = 'Select a model';
  prodSel.appendChild(placeholder);

  cat.products.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.model;
    opt.textContent = `${p.model} - ${p.name}`;
    prodSel.appendChild(opt);
  });

  prodSel.disabled = false;

  // Show spec hint for this category
  const hint = specHints[catId];
  if (hint) {
    specHint.textContent = hint;
    specHint.classList.remove('hidden');
  } else {
    specHint.classList.add('hidden');
  }

  updatePreview();
});

// ── Live preview builder ──────────────────────────────────────────────────────
function buildBody() {
  const catId    = catSel.value;
  const cat      = catData.find(c => c.id === catId);
  const catName  = cat?.name ?? '';
  const model    = prodSel.value;
  const spec     = specInput.value.trim();
  const name     = nameInput.value.trim();
  const company  = compInput.value.trim();
  const phone    = phoneInput.value.trim();
  const qty      = qtyInput.value.trim();
  const msg      = msgInput.value.trim();

  const subject = model
    ? `Quote Request - ${model}`
    : catName
      ? `Quote Request - ${catName}`
      : 'Quote Request - CIE Instruments';

  const lines = [
    'Hello CIE team,',
    '',
    'I would like to request a quote for the following:',
    '',
  ];

  if (catName)  lines.push(`Category : ${catName}`);
  if (model)    lines.push(`Model    : ${model}`);
  if (spec)     lines.push(`Spec     : ${spec}`);
  if (qty)      lines.push(`Quantity : ${qty}`);

  lines.push('');

  if (name)    lines.push(`Name     : ${name}`);
  if (company) lines.push(`Company  : ${company}`);
  if (phone)   lines.push(`Phone    : ${phone}`);

  if (msg) {
    lines.push('');
    lines.push('Notes:');
    lines.push(msg);
  }

  lines.push('');
  lines.push('Thank you.');

  return { subject, body: lines.join('\n') };
}

function updatePreview() {
  const { subject, body } = buildBody();
  const hasSomething = catSel.value || nameInput.value.trim();
  if (hasSomething) {
    previewWrap.classList.remove('hidden');
    previewEl.textContent = `To: cieinstruments@gmail.com\nSubject: ${subject}\n\n${body}`;
  } else {
    previewWrap.classList.add('hidden');
  }
}

// Update preview on any input change
[prodSel, specInput, nameInput, compInput, phoneInput, qtyInput, msgInput].forEach(el =>
  el?.addEventListener('input', updatePreview)
);

// ── Submit → open mailto ──────────────────────────────────────────────────────
form.addEventListener('submit', (e) => {
  e.preventDefault();

  const name  = nameInput.value.trim();
  const model = prodSel.value;
  const cat   = catSel.value;

  if (!name) {
    errorEl.textContent = 'Please enter your name.';
    errorEl.classList.remove('hidden');
    nameInput.focus();
    return;
  }
  if (!cat) {
    errorEl.textContent = 'Please select a product category.';
    errorEl.classList.remove('hidden');
    catSel.focus();
    return;
  }
  if (!model) {
    errorEl.textContent = 'Please select a model from the dropdown.';
    errorEl.classList.remove('hidden');
    prodSel.focus();
    return;
  }
  errorEl.classList.add('hidden');

  const { subject, body } = buildBody();
  const mailto = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  window.location.href = mailto;
});

// ── Pre-fill from URL param (?product=RTS-33) ─────────────────────────────────
const urlProduct = new URLSearchParams(window.location.search).get('product') ?? '';
if (urlProduct) {
  // Find which category this product belongs to
  for (const cat of catData) {
    const match = cat.products.find(p => p.model === urlProduct || p.id === urlProduct);
    if (match) {
      catSel.value = cat.id;
      catSel.dispatchEvent(new Event('change'));
      // Wait for options to populate then select
      setTimeout(() => {
        prodSel.value = match.model;
        buildConfig(match.model);
        updatePreview();
      }, 0);
      break;
    }
  }
}
</script>
