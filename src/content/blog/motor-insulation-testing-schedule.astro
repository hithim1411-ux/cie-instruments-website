        <th class="text-left px-4 py-3 text-blue-200 font-semibold text-xs">Shorter interval when...</th>
        <th class="text-left px-4 py-3 text-blue-200 font-semibold text-xs">Longer interval when...</th>
      </tr>
    </thead>
    <tbody>
      {[
        ['Criticality', 'The motor drives a process that cannot tolerate unplanned downtime', 'A spare or non-critical motor is readily available'],
