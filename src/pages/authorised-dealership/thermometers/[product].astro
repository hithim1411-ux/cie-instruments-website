---
import Base from '../../../layouts/Base.astro';
import { u } from '../../../utils/url';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import CTABand from '../../../components/CTABand.astro';
import site from '../../../data/site.json';
import products from '../../../data/vartech-thermometers.json';

export async function getStaticPaths() {
  return products.map(p => ({ params: { product: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const waMsg = encodeURIComponent(`Hi, I'd like to enquire about the Vartech ${product.model} — ${product.name}. Please send me details and pricing.`);
const quoteMailto = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent(`Quote Request — Vartech ${product.model}`)}&body=${encodeURIComponent(`Hello CIE team,\n\nI would like to request a quote for:\nBrand: Vartech\nModel: ${product.model} — ${product.name}\n\nQuantity:\nApplication:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.`)}`;
const canonicalPath = `https://www.cieinstruments.in/authorised-dealership/thermometers/${product.id}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cieinstruments.in/' },
    { '@type': 'ListItem', position: 2, name: 'Authorised Dealership', item: 'https://www.cieinstruments.in/authorised-dealership/' },
    { '@type': 'ListItem', position: 3, name: 'Vartech Digital Thermometers & Thermo-Hygrometers', item: 'https://www.cieinstruments.in/authorised-dealership/thermometers/' },
    { '@type': 'ListItem', position: 4, name: product.model, item: canonicalPath },
  ],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Vartech ${product.model} — ${product.name}`,
  description: product.description,
  brand: { '@type': 'Brand', name: 'Vartech' },
  model: product.model,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: canonicalPath,
    seller: { '@type': 'Organization', name: 'Cambridge Instruments & Engg. Co.' },
  },
  ...(product.specs && product.specs.length > 0 && {
    additionalProperty: product.specs.map((s: { label: string; value: string }) => ({
      '@type': 'PropertyValue', name: s.label, value: s.value,
    })),
  }),
};
---

<Base
  title={`Vartech ${product.model} — ${product.name} `}
  description={`${product.model} ${product.name} — ${product.tagline} Available from CIE Instruments, authorised Vartech dealer in India.`}
  rawTitle
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[
        { label: 'Authorised Dealership', href: u('/authorised-dealership/') },
        { label: 'Vartech Digital Thermometers & Thermo-Hygrometers', href: u('/authorised-dealership/thermometers/') },
        { label: product.model },
      ]} />
      <p class="eyebrow mt-4 mb-3">— Vartech® Digital Thermometers & Thermo-Hygrometers</p>
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">
        <span class="model-code text-xl block mb-1">{product.model}</span>
        {product.name}
      </h1>
      <p class="mt-3 text-muted max-w-2xl">{product.tagline}</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 section-pad-sm">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <div class="lg:col-span-1">
        <div class="bg-cloud border border-border rounded-xl overflow-hidden mb-3">
          <img id="gallery-main"
            src={u(`/images/vartech/thermometers/${product.images[0]}`)}
            alt={`Vartech ${product.model} — ${product.name}`}
            width="600" height="600"
            class="w-full object-contain h-64 lg:h-72 p-4"
            loading="eager" onerror="this.style.opacity='0.2'" />
        </div>

        {product.images.length > 1 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {product.images.map((img: string, i: number) => (
              <button type="button"
                data-src={u(`/images/vartech/thermometers/${img}`)}
                data-alt={`Vartech ${product.model} — image ${i + 1}`}
                class:list={['gallery-thumb w-16 h-16 rounded-lg border-2 overflow-hidden bg-cloud transition-all', i === 0 ? 'border-ink' : 'border-border hover:border-ink/50']}
                aria-label={`View image ${i + 1}`}>
                <img src={u(`/images/vartech/thermometers/${img}`)} alt="" aria-hidden="true" width="64" height="64" class="w-full h-full object-contain p-1" loading="lazy" />
              </button>
            ))}
          </div>
        )}

        <div class="space-y-3">
          <a href={u(`/downloads/vartech/thermometers/${product.catalogue}`)} target="_blank" rel="noopener noreferrer"
            class="btn-secondary w-full text-ink">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a1 1 0 001 1h16a1 1 0 001-1v-3"/>
            </svg>
            Download Catalogue (PDF)
          </a>
          <a href={quoteMailto}
            class="btn-primary w-full">
            <Icon name="mail" class="w-4 h-4 shrink-0" />
            Request a Quote
          </a>
          <a href={`https://wa.me/${site.whatsapp}?text=${waMsg}`} target="_blank" rel="noopener noreferrer"
            class="btn-secondary w-full text-ink">
            <Icon name="message-circle" class="w-4 h-4 shrink-0" />
            Enquire on WhatsApp
          </a>
        </div>

        <div class="mt-6 bg-cloud rounded-lg p-4 border border-border">
          <div class="flex items-center gap-2 mb-3">
            <img src={u('/images/vartech/vartech-logo.avif')} alt="Vartech logo" width="80" height="30" class="h-7 w-auto object-contain" loading="lazy" />
            <span class="text-xs font-mono font-bold text-red uppercase tracking-widest">Authorised Dealer</span>
          </div>
          <ul class="space-y-2">
            {['Genuine Vartech product', 'Expert technical support', 'Pan-India delivery', 'Competitive pricing'].map(f => (
              <li class="flex items-center gap-2 text-xs text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-ink shrink-0"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 class="text-xl font-bold text-ink mb-3">About This Instrument</h2>
          <p class="text-muted leading-relaxed">{product.description}</p>
        </div>

        {product.features && (product.features as string[]).length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-ink mb-4">Key Features</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
              {(product.features as string[]).map((f: string) => (
                <li class="flex items-start gap-3 text-sm text-muted">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-ink shrink-0"></span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        )}

        {product.specs && (product.specs as {label:string;value:string}[]).length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-ink mb-4">Technical Specifications</h2>
            <div class="border border-border rounded-lg overflow-hidden">
              <table class="w-full text-sm">
                <tbody>
                  {(product.specs as {label:string;value:string}[]).map((row, i) => (
                    <tr class={i % 2 === 0 ? 'bg-white' : 'bg-cloud'}>
                      <td class="py-2.5 px-4 font-semibold text-ink w-2/5 align-top border-b border-border">{row.label}</td>
                      <td class="py-2.5 px-4 text-muted align-top border-b border-border">{row.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-muted">Specifications sourced from the official Vartech product catalogue. Download above for the full datasheet.</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <CTABand
    heading={`Interested in the Vartech ${product.model}? Get a quote today.`}
    body="Email us with your model, quantity and application — we respond within one business day."
    primaryLabel="Request a Quote"
    primaryHref={quoteMailto}
    secondaryLabel="← All Vartech Thermometers"
    secondaryHref={u('/authorised-dealership/thermometers/')}
  />
</Base>

<script>
{
  const mainImg = document.getElementById('gallery-main') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
  thumbs.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!mainImg) return;
      mainImg.src = btn.dataset.src ?? '';
      mainImg.alt = btn.dataset.alt ?? '';
      thumbs.forEach(t => t.classList.replace('border-ink', 'border-border'));
      btn.classList.replace('border-border', 'border-ink');
    });
  });
}
</script>
