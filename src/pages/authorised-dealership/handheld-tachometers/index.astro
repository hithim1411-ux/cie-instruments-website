---
import Base from '../../../layouts/Base.astro';
import { u, downloadUrl } from '../../../utils/url';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import products from '../../../data/systems-tech-handheld-tachometers.json';

const pageTitle = 'Systems Tech Handheld Digital Tachometers - Authorised Distributor India | CIE Instruments';
const pageDesc =
  'Buy Systems Tech HTM 590, HTM 560 and HTM 890 handheld digital tachometers in India - contact, non-contact and photo + contact RPM meters. CIE Instruments is an authorised distributor, Howrah and Kolkata.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cieinstruments.in/' },
    { '@type': 'ListItem', position: 2, name: 'Authorised Distributor', item: 'https://www.cieinstruments.in/authorised-dealership/' },
    { '@type': 'ListItem', position: 3, name: 'Systems Tech Handheld Digital Tachometers', item: 'https://www.cieinstruments.in/authorised-dealership/handheld-tachometers/' },
  ],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Systems Tech Handheld Digital Tachometers',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `${p.model} - ${p.name}`,
      description: p.description,
      image: `https://www.cieinstruments.in/images/systems-tech/handheld-tachometers/${p.images[0]}`,
      brand: { '@type': 'Brand', name: 'Systems Tech' },
    },
  })),
};
---

<Base title={pageTitle} description={pageDesc} ogImage={u('/images/systems-tech/systems-tech-logo.webp')} rawTitle canonicalOverride="https://www.cieinstruments.in/products/systems-tech-handheld-tachometers/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[
        { label: 'Authorised Distributor', href: u('/authorised-dealership/') },
        { label: 'Systems Tech Handheld Digital Tachometers' },
      ]} />
      <p class="eyebrow mt-4 mb-3">Systems Tech Handheld Digital Tachometers</p>
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Systems Tech Handheld Digital Tachometers</h1>
      <p class="mt-3 text-muted max-w-2xl leading-relaxed">
        CIE Instruments supplies the Systems Tech range of handheld digital tachometers - the HTM 590 contact type, the HTM 560 non-contact (photo) type and the HTM 890 combined photo and contact type - for RPM and surface speed checks on motors, fans, pumps, belts and machine shafts.
      </p>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-lg font-bold text-ink">{products.length} Systems Tech product{products.length !== 1 ? 's' : ''}</h2>
        <a href={u('/authorised-dealership/')} class="text-sm text-muted hover:text-ink transition-colors">← Authorised Distributor</a>
      </div>

      <div class="product-slider gap-5">
        {products.map(p => (
          <article class="card card-interactive group overflow-hidden flex flex-col">
            <div class="bg-cloud h-52 flex items-center justify-center relative overflow-hidden">
              <img
                src={u(`/images/systems-tech/handheld-tachometers/${p.images[0]}`)}
                alt={`${p.model} - ${p.name}`}
                width="400" height="400"
                class="object-contain h-40 w-auto transition-transform duration-300 [transition-timing-function:var(--ease-premium)] group-hover:scale-105"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 text-muted/60">
                <svg class="w-12 h-12 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"/>
                  <path d="M3 9l4-4 4 4 4-4 4 4" stroke-width="1.5"/>
                </svg>
                <span class="text-xs font-mono uppercase tracking-wider opacity-50">Image coming soon</span>
              </div>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <p class="model-code text-xs mb-1">{p.model}</p>
              <h3 class="font-bold text-ink text-base mb-2 leading-snug">{p.name}</h3>
              <p class="text-sm text-muted mb-4 flex-1 line-clamp-3">{p.tagline}</p>
              <div class="flex flex-col gap-2 mt-auto">
                <a href={u(`/authorised-dealership/handheld-tachometers/${p.id}/`)}
                  class="btn-primary btn-primary--sm">
                  View Details & Specs
                </a>
                {p.catalogue && (<a href={downloadUrl(`/downloads/systems-tech/handheld-tachometers/${p.catalogue}`)}
                  target="_blank" rel="noopener noreferrer"
                  class="btn-secondary btn-secondary--sm text-ink">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a1 1 0 001 1h16a1 1 0 001-1v-3"/>
                  </svg>
                  Download Catalogue
                </a>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cloud section-pad-sm border-t border-border">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-ink mb-6">About Systems Tech Handheld Digital Tachometers</h2>
      <div class="space-y-4 text-sm text-muted leading-relaxed">
        <p>
          All three handheld models share a micro-controller based design, a 5-digit red LED display, a quartz crystal time base and an accuracy of 0.05% + 1 digit. The last, maximum and minimum readings are stored automatically and can be recalled, and the unit runs on four AA cells with auto shut-off. Each comes in a padded carrying case.
        </p>
        <p>
          The HTM 590 measures by contact from 60 to 50,000 RPM and also reads surface speed from 6 to 5000 m/min using rubber contact tips. The HTM 560 reads 60 to 1,00,000 RPM without touching the shaft, from 75 mm to 300 mm away, using reflective tape. The HTM 890 combines both in one body: contact side for RPM and surface speed, photo side for non-contact RPM.
        </p>
        <p>
          CIE Instruments (Cambridge Instruments &amp; Engg. Co., Howrah) is an authorised distributor of Systems Tech tachometers and sensors for India. We supply them to factories, motor and pump service workshops, power plants, test labs, colleges and OEMs across India - including Kolkata, Howrah, Bhubaneswar, Delhi, Mumbai, Bengaluru, Hyderabad, Chennai, Ahmedabad, Pune, Lucknow and Chandigarh.
        </p>
        <p>
          For pricing and availability, <a href="/contact/" class="text-ink hover:underline font-medium">contact our team</a> or enquire via WhatsApp.
        </p>
      </div>
      <div class="mt-8 pt-6 border-t border-border">
        <p class="text-xs text-muted">
          Cambridge Instruments &amp; Engg. Co. (CIE) - manufacturer of precision electrical test instruments in Howrah since 1963, and authorised distributor for Systems Tech.
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
