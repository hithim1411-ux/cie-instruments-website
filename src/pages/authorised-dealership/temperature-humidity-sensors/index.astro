---
import Base from '../../../layouts/Base.astro';
import { u, downloadUrl } from '../../../utils/url';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CTABand from '../../../components/CTABand.astro';
import products from '../../../data/systems-tech-temperature-humidity-sensors.json';

const pageTitle = 'Systems Tech Wireless Temperature & Humidity Sensors - Authorised Distributor India | CIE Instruments';
const pageDesc =
  'Buy Systems Tech TS-200 wireless temperature sensor and TS-201 temperature and humidity sensor in India. CIE Instruments is an authorised distributor, Howrah and Kolkata.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cieinstruments.in/' },
    { '@type': 'ListItem', position: 2, name: 'Authorised Distributor', item: 'https://www.cieinstruments.in/authorised-dealership/' },
    { '@type': 'ListItem', position: 3, name: 'Systems Tech Wireless Temperature & Humidity Sensors', item: 'https://www.cieinstruments.in/authorised-dealership/temperature-humidity-sensors/' },
  ],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Systems Tech Wireless Temperature & Humidity Sensors',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: `${p.model} - ${p.name}`,
      description: p.description,
      image: `https://www.cieinstruments.in/images/systems-tech/temperature-humidity-sensors/${p.images[0]}`,
      brand: { '@type': 'Brand', name: 'Systems Tech' },
    },
  })),
};
---

<Base title={pageTitle} description={pageDesc} ogImage={u('/images/systems-tech/systems-tech-logo.webp')} rawTitle canonicalOverride="https://www.cieinstruments.in/products/systems-tech-temperature-humidity-sensors/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[
        { label: 'Authorised Distributor', href: u('/authorised-dealership/') },
        { label: 'Systems Tech Wireless Temperature & Humidity Sensors' },
      ]} />
      <p class="eyebrow mt-4 mb-3">Systems Tech Wireless Temperature &amp; Humidity Sensors</p>
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Systems Tech Wireless Temperature &amp; Humidity Sensors</h1>
      <p class="mt-3 text-muted max-w-2xl leading-relaxed">
        CIE Instruments supplies the Systems Tech TS-200 wireless temperature sensor and TS-201 2-in-1 temperature and humidity sensor for monitoring refrigerators, freezers, cold rooms and storage areas, with on-device alarms and remote alerts.
      </p>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-lg font-bold text-ink">{products.length} Systems Tech product{products.length !== 1 ? 's' : ''}</h2>
        <a href={u('/authorised-dealership/')} class="text-sm text-muted hover:text-ink transition-colors">← Authorised Distributor</a>
      </div>

      <div class="product-slider gap-5">
        {products.map(p => (
          <article class="card card-interactive group overflow-hidden flex flex-col">
            <div class="bg-cloud h-52 flex items-center justify-center relative overflow-hidden">
              <img
                src={u(`/images/systems-tech/temperature-humidity-sensors/${p.images[0]}`)}
                alt={`${p.model} - ${p.name}`}
                width="400" height="400"
                class="object-contain h-40 w-auto transition-transform duration-300 [transition-timing-function:var(--ease-premium)] group-hover:scale-105"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
              />
              <div class="hidden absolute inset-0 flex-col items-center justify-center gap-2 text-muted/60">
                <svg class="w-12 h-12 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"/>
                  <path d="M3 9l4-4 4 4 4-4 4 4" stroke-width="1.5"/>
                </svg>
                <span class="text-xs font-mono uppercase tracking-wider opacity-50">Image coming soon</span>
              </div>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <p class="model-code text-xs mb-1">{p.model}</p>
              <h3 class="font-bold text-ink text-base mb-2 leading-snug">{p.name}</h3>
              <p class="text-sm text-muted mb-4 flex-1 line-clamp-3">{p.tagline}</p>
              <div class="flex flex-col gap-2 mt-auto">
                <a href={u(`/authorised-dealership/temperature-humidity-sensors/${p.id}/`)}
                  class="btn-primary btn-primary--sm">
                  View Details & Specs
                </a>
                {p.catalogue && (<a href={downloadUrl(`/downloads/systems-tech/temperature-humidity-sensors/${p.catalogue}`)}
                  target="_blank" rel="noopener noreferrer"
                  class="btn-secondary btn-secondary--sm text-ink">
                  <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a1 1 0 001 1h16a1 1 0 001-1v-3"/>
                  </svg>
                  Download Catalogue
                </a>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cloud section-pad-sm border-t border-border">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-ink mb-6">About Systems Tech Wireless Temperature & Humidity Sensors</h2>
      <div class="space-y-4 text-sm text-muted leading-relaxed">
        <p>
          The TS-200 is a WiFi enabled temperature sensor with a flat ribbon probe and a double-sided sticker mount, covering -55 °C to +125 °C with 0.0625 °C resolution, an on-device audible and visual alarm, and a live feed that can be integrated through an API.
        </p>
        <p>
          The TS-201 adds humidity (0 to 100 %RH) to the temperature reading with +/- 0.2 °C and +/- 2 %RH accuracy, an OLED display, 200 samples of on-device storage, WhatsApp and email alerts on breaches, and Android and iOS apps for the dashboard.
        </p>
        <p>
          CIE Instruments (Cambridge Instruments &amp; Engg. Co., Howrah) is an authorised distributor of Systems Tech tachometers and sensors for India. We supply them to factories, motor and pump service workshops, power plants, test labs, colleges and OEMs across India - including Kolkata, Howrah, Bhubaneswar, Delhi, Mumbai, Bengaluru, Hyderabad, Chennai, Ahmedabad, Pune, Lucknow and Chandigarh.
        </p>
        <p>
          For pricing and availability, <a href="/contact/" class="text-ink hover:underline font-medium">contact our team</a> or enquire via WhatsApp.
        </p>
      </div>
      <div class="mt-8 pt-6 border-t border-border">
        <p class="text-xs text-muted">
          Cambridge Instruments &amp; Engg. Co. (CIE) - manufacturer of precision electrical test instruments in Howrah since 1963, and authorised distributor for Systems Tech.
        </p>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
