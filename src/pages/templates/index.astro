---
import Base from '../../layouts/Base.astro';
import EyebrowLabel from '../../components/EyebrowLabel.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import TemplateCss from '../../components/TemplateCss.astro';
import { u, downloadUrl } from '../../utils/url';
import { templates, TEMPLATE_V as V } from '../../data/templates';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free printable test report forms (PDF)',
  itemListElement: templates.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `https://www.cieinstruments.in/templates/${t.slug}/` })),
};
---

<Base title="Free Printable Test Report Forms (PDF): Insulation, Earth, Transformer, Cable, Relay" description="Free printable PDF test report formats with worksheets: insulation resistance, earth resistance, earth pit register, transformer oil BDV, transformer megger, cable, micro-ohm, hi-pot, house wiring, motor winding, LV panel maintenance and relay tests.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="blueprint-bg bg-ink text-white pt-10 pb-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="tpl-crumbs"><Breadcrumbs crumbs={[{ label: 'Tools', href: u('/tools/') }, { label: 'Test report forms' }]} /></div>
      <EyebrowLabel text="Free downloads" class="mt-5 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold leading-[1.1] tracking-tight max-w-4xl">Test report forms for the field</h1>
      <p class="mt-3 text-muted-dark max-w-2xl text-body-lg">{templates.length} printable PDF forms for the people who test on site. Print one, fill it in by hand, and use the worksheet page for the formulas, tables and limits.</p>
      <ul class="mt-5 flex flex-wrap gap-2 text-xs text-muted-dark">
        <li class="tpl-pill">Free</li><li class="tpl-pill">No sign-up</li><li class="tpl-pill">Prints on A4</li><li class="tpl-pill">Formulas and limits included</li>
      </ul>
    </div>
  </section>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="tpl-grid">
        {templates.map(t => (
          <article class="tpl-tile" id={t.slug}>
            <a href={u(`/templates/${t.slug}/`)} class="tpl-thumb" aria-label={`Open the ${t.name} form page`}><img src={`${u(`/images/templates/${t.slug}.webp`)}?v=${V}`} alt={`Preview of the ${t.name} form`} width="720" height="1019" loading="lazy" /></a>
            <p class="tpl-std">{t.std}</p>
            <h2>{t.name}</h2>
            <p>{t.summary}</p>
            <div class="tpl-links">
              <a href={u(`/templates/${t.slug}/`)}>Details →</a>
              <a href={`${downloadUrl(`/downloads/templates/${t.file}`)}?v=${V}`} rel="noopener">PDF, {t.pages} pages ↓</a>
            </div>
          </article>
        ))}
      </div>

      <div class="tpl-notes">
        <h2>Using the forms</h2>
        <ul>
          <li>Print on A4 at 100 % (no scaling). Page 1 of each form is the report you fill in. The following pages are worksheets and reference tables to keep with it.</li>
          <li>Limits and constants come from the standards named on each form, as commonly quoted. Check them against the edition you work to, and use the stricter of those and your plant or customer specification.</li>
          <li>Where a value is a common guide rather than a limit from a standard, the form says so.</li>
          <li>These are calculation aids for qualified people. They do not replace the standard, the instrument manual or your site safety procedure.</li>
        </ul>
      </div>
    </div>
  </section>

  <CTABand heading="Need the instrument as well?" body="CIE supplies insulation testers, earth testers, oil BDV testers, micro-ohm meters and relay test sets, with test certificate available on request." />
  <TemplateCss />
</Base>
