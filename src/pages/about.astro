---
import Base from '../layouts/Base.astro';
import { u } from '../utils/url';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import CTABand from '../components/CTABand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../utils/iconNames';
---

<Base
  title="About Cambridge Instruments & Engg. Co. - Electrical Test Instruments Supplier, Kolkata"
  description="Cambridge Instruments & Engg. Co. (CIE) - established 1963, Howrah, West Bengal. Manufacturer and supplier of insulation testers, earth testers, relay test sets, oil BDV testers, HV test sets. Trusted by various State Electricity Boards, Indian Railways, and cement and metal industries."
>
  <!-- ══ Hero: dark graphite, title left, one big 60+ feature right ══ -->
  <div class="blueprint-bg bg-ink text-white relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-14 lg:pb-20">
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="flex items-center gap-2 text-xs text-muted-dark font-mono">
          <li><a href={u('/')} class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-white/30">›</li>
          <li class="text-white/80" aria-current="page">About Us</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-7 min-w-0">
          <EyebrowLabel text="Est. 1963 · Howrah, India" class="mb-4" />
          <h1 class="text-[length:var(--text-display)] font-extrabold leading-[1.06] tracking-tight">Cambridge Instruments &amp; Engg. Co.</h1>
          <p class="mt-5 text-lg lg:text-xl text-gray-300 max-w-xl font-medium leading-relaxed">Also known as CIE Instruments - Instruments for Accuracy and Reliability since 1963.</p>
          <p class="mt-5 text-muted-dark max-w-xl leading-relaxed">Preferred by various State Electricity Boards, Indian Railways and EPC contractors across India.</p>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="about-years">
            <div class="about-years__glow" aria-hidden="true"></div>
            <p class="about-years__num"><span>60</span><sup>+</sup></p>
            <p class="about-years__lbl">Years of making instruments you can trust</p>
            <div class="about-years__rule" aria-hidden="true"></div>
            <p class="about-years__meta"><span>1963</span><i aria-hidden="true"></i><span>Today</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ Opening statement + timeline ══ -->
  <section class="section-pad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <EyebrowLabel text="Who We Are" class="mb-4" />
          <h2 class="text-2xl lg:text-3xl font-black text-ink mb-5 leading-tight">An Indian manufacturer built on engineering, craftsmanship, and trust.</h2>
          <div class="space-y-4 text-muted leading-relaxed text-[1.0625rem]">
            <p>
              Cambridge Instruments &amp; Engineering Co. (CIE) is an Indian manufacturer of
              Electrical &amp; Electronic Test &amp; Measuring Instruments, built upon a legacy of
              engineering, craftsmanship, and trust.
            </p>
            <p>
              Established in <strong class="text-ink">1963</strong>, the company has spent
              decades serving professionals who depend on accurate measurements and reliable instruments
              to perform their work with confidence.
            </p>
            <p>
              From its beginnings in Howrah - one of India's historic industrial centres - to its
              presence today across industries and institutions, CIE has remained committed to the
              principles that shaped its foundation: <strong class="text-ink">accuracy,
              reliability, and integrity.</strong>
            </p>
          </div>
        </div>

        <!-- Timeline -->
        <div class="card p-6 lg:p-8">
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-red mb-6">Six decades, in brief</p>
          <ol class="about-timeline">
            {[
              { year: '1963', text: 'Founded in Howrah by Late Shri Prakash Chandra Sharma. First instruments: hand-driven insulation testers.' },
              { year: '1970s', text: 'Product range expanded to include earth testers and motorised insulation testers.' },
              { year: '1980s', text: 'CIE® trade mark registered. Oil BDV test sets and relay test sets introduced.' },
              { year: '1990s', text: 'Digital instrument range launched - digital insulation and earth testers.' },
              { year: '2000s', text: 'Three-phase relay test set RTS-33 becomes a preferred instrument at major utilities.' },
              { year: 'Today', text: '60+ years. Trusted by various State Electricity Boards, Indian Railways, and hundreds of EPC contractors. Led by Mr. Manoj Sharma and Mr. Rajesh Sharma.' },
            ].map((item, i, a) => (
              <li class={`about-tl ${i === a.length - 1 ? 'is-now' : ''}`}>
                <span class="about-tl__year">{item.year}</span>
                <p class="about-tl__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Founder story: dark ══ -->
  <section class="blueprint-bg bg-ink text-white section-pad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <EyebrowLabel text="Where It All Began" class="mb-4" />
          <h2 class="text-2xl lg:text-3xl font-black text-white mb-6 leading-tight">A physicist with a practical vision.</h2>
          <div class="space-y-4 text-muted leading-relaxed text-[1.0625rem]">
            <p>
              The story of CIE began in Howrah in 1963 when <strong class="text-white">Late Shri Prakash Chandra Sharma</strong>,
              a Physics Honours graduate from the University of Calcutta, founded the company with a clear vision -
              to manufacture dependable electrical testing instruments in India.
            </p>
            <p>
              Working from a modest manufacturing setup, he combined scientific knowledge with practical engineering
              to create products designed for real-world use. At a time when India's industrial landscape was still
              developing, CIE focused on building instruments that customers could trust for accurate and consistent
              performance.
            </p>
            <p>
              Those values - precision, reliability, and a refusal to cut corners - continue to define the company
              more than six decades later.
            </p>
          </div>
        </div>

        <div class="flex justify-center">
          <div class="relative about-photo">
            <div class="absolute -inset-6 rounded-[2rem] bg-red/30 blur-3xl" aria-hidden="true"></div>
            <div class="absolute -inset-px rounded-[1.6rem] bg-gradient-to-br from-white/40 via-white/5 to-red/50" aria-hidden="true"></div>
            <img
              src={u('/images/founder.webp')}
              alt="Late Shri Prakash Chandra Sharma - Founder, Cambridge Instruments & Engineering Co."
              width="3840"
              height="5760"
              class="relative rounded-3xl w-72 sm:w-80 h-96 object-cover object-top shadow-2xl"
              style="object-position: center 20%;"
              loading="lazy"
            />
            <div class="about-photo__cap">
              <p class="text-white font-bold text-sm leading-tight">Late Shri Prakash Chandra Sharma</p>
              <p class="text-muted-dark text-xs mt-0.5">Founder, CIE · 1963</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Manufacturing ══ -->
  <section class="section-pad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <EyebrowLabel text="A Manufacturing Heritage" class="mb-4" />
      <h2 class="text-2xl lg:text-3xl font-black text-ink mb-4 leading-tight max-w-3xl">Manufactured in Howrah. Calibrated before despatch. Every instrument.</h2>
      <p class="text-muted leading-relaxed max-w-2xl mb-10 text-[1.0625rem]">
        Manufacturing has always been at the heart of CIE. The company's factory continues to operate from
        Howrah, where generations of experience, technical expertise, and attention to detail come together
        in the production of every instrument.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-reveal-stagger>
        {[
          {
            icon: 'factory' as IconName,
            heading: 'Manufacturing in Howrah',
            body: 'CIE instruments are manufactured at our Howrah works at 23/2, Maulana Abul Kalam Azad Road. Assembly, winding, and finishing are carried out under direct supervision, with quality controlled at every stage.',
          },
          {
            icon: 'ruler' as IconName,
            heading: 'Calibration Before Despatch',
            body: 'Each instrument is calibrated against reference standards at our calibration facility before despatch. A calibration record is maintained for every instrument supplied.',
          },
          {
            icon: 'wrench' as IconName,
            heading: 'Custom Manufacturing',
            body: "Any non-standard voltage range, resistance range, or measurement range can be manufactured to the customer's specific requirement. Custom ranges are a standard service at CIE - we have been making custom instruments for utilities and laboratories since the 1960s.",
          },
        ].map((item, i) => (
          <div class="card card-interactive p-7">
            <div class="about-ico">
              <Icon name={item.icon} class="w-6 h-6" />
            </div>
            <h3 class="mt-5 font-bold text-lg text-ink mb-3">{item.heading}</h3>
            <p class="text-sm text-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>

      <blockquote class="about-quote mt-12">
        <p class="text-white font-bold text-xl lg:text-2xl leading-snug">
          "Build instruments that deliver dependable performance when accuracy matters most."
        </p>
        <cite class="text-sm text-white/80 mt-3 block not-italic font-mono uppercase tracking-widest">Manufacturing philosophy, CIE since 1963</cite>
      </blockquote>
    </div>
  </section>

  <!-- ══ Growth & leadership ══ -->
  <section class="section-pad pt-0 lg:pt-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        <div class="card about-card about-card--ink p-7 lg:p-10">
          <EyebrowLabel text="Growing With Changing Times" class="mb-4" />
          <h2 class="text-2xl font-black text-ink mb-5 leading-tight">Manufacturing experience meets customer focus.</h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              As customer requirements evolved, the company expanded its presence with a dedicated office in
              <strong class="text-ink">Kolkata</strong> to strengthen customer engagement, marketing
              activities, and product distribution.
            </p>
            <p>
              While the business has grown and adapted over the years, its foundation remains firmly rooted
              in the manufacturing excellence established in Howrah. This combination of manufacturing
              experience and customer focus continues to guide the company today.
            </p>
          </div>
        </div>

        <div class="card about-card about-card--red p-7 lg:p-10">
          <EyebrowLabel text="Continuing the Legacy" class="mb-4" />
          <h2 class="text-2xl font-black text-ink mb-5 leading-tight">The next generation, the same commitment.</h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              Today, Cambridge Instruments &amp; Engineering Co. is led by
              <strong class="text-ink">Mr. Manoj Sharma</strong> and
              <strong class="text-ink">Mr. Rajesh Sharma</strong>,
              who continue the vision established by the founder.
            </p>
            <p>
              By combining decades of manufacturing experience with a forward-looking approach, they remain
              committed to delivering quality products, dependable service, and long-term value to customers.
              The continuity of leadership across generations has helped preserve the principles upon which
              the company was built.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CIE mark + closing ══ -->
  <section class="section-pad pt-0 lg:pt-0">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="card p-8 lg:p-12 text-center">
        <img src={u('/logo/cie-logo-transparent.webp')} alt="CIE® - Registered Trade Mark" width="800" height="502" class="h-20 w-auto mx-auto mb-6" />
        <h2 class="text-2xl font-black text-ink mb-4">The Registered CIE® Mark</h2>
        <p class="text-muted leading-relaxed max-w-2xl mx-auto mb-8">
          The <span class="font-mono font-semibold text-ink">CIE®</span> mark is a registered trade mark
          of Cambridge Instruments &amp; Engineering Co. It appears on every instrument we manufacture and is a
          guarantee of origin, quality, and after-sales accountability. When you buy CIE®, you buy direct from
          the manufacturer - not from a reseller stickering someone else's instrument.
        </p>
        <div class="border-t border-ink/10 pt-8 space-y-1 text-sm text-muted">
          <p class="font-semibold text-ink">Cambridge Instruments &amp; Engineering Co.</p>
          <p>Established 1963 &middot; Howrah, India</p>
          <p class="font-mono text-xs tracking-widest uppercase text-red mt-2">Manufacturing Excellence Across Generations · Made in India</p>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading="Speak to us about your requirement."
    body="Our Howrah works and Kolkata office are staffed by people who know the instruments - not a call centre."
  />
</Base>

<style>
  .about-years { position: relative; padding: 2.2rem 2rem 1.8rem; border-radius: 2rem; overflow: hidden; text-align: left;
    background: linear-gradient(160deg, rgba(255,255,255,.10), rgba(255,255,255,.03)); border: 1px solid rgba(255,255,255,.18);
    -webkit-backdrop-filter: var(--glass-blur-lg); backdrop-filter: var(--glass-blur-lg);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 30px 70px -24px rgba(0,0,0,.65); }
  .about-years__glow { position: absolute; width: 22rem; height: 22rem; right: -7rem; top: -8rem; border-radius: 50%; background: radial-gradient(circle, rgba(224,37,46,.55), transparent 65%); pointer-events: none; }
  .about-years__num { position: relative; margin: 0; display: flex; align-items: flex-start; gap: .15rem; font-weight: 800; line-height: .9; letter-spacing: -.05em; color: #fff; }
  .about-years__num span { font-size: clamp(6rem, 13vw, 10rem); }
  .about-years__num sup { font-size: clamp(3rem, 6vw, 5rem); line-height: 1; margin-top: .6rem; color: #FF5A62; letter-spacing: 0; }
  .about-years__lbl { position: relative; margin: .9rem 0 0; font-size: 1.15rem; font-weight: 600; line-height: 1.35; color: #e2e8f0; max-width: 18rem; }
  .about-years__rule { position: relative; margin-top: 1.6rem; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #CC1F29, rgba(204,31,41,.15)); }
  .about-years__meta { position: relative; margin: .9rem 0 0; display: flex; align-items: center; gap: .8rem; font: 600 .75rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: #aeb8c6; }
  .about-years__meta i { flex: 1; height: 1px; background: rgba(255,255,255,.2); }

  .about-timeline { list-style: none; margin: 0; padding: 0 0 0 .25rem; position: relative; }
  .about-timeline::before { content: ''; position: absolute; left: 5.1rem; top: .5rem; bottom: .5rem; width: 2px; border-radius: 2px;
    background: linear-gradient(180deg, #CC1F29, rgba(204,31,41,.15)); }
  .about-tl { display: grid; grid-template-columns: 4.1rem 1fr; column-gap: 1.8rem; padding: .55rem 0 1rem; position: relative; }
  .about-tl::before { content: ''; position: absolute; left: 4.85rem; top: .95rem; width: .6rem; height: .6rem; border-radius: 50%; background: #fff; border: 2px solid #CC1F29; }
  .about-tl.is-now::before { background: #CC1F29; box-shadow: 0 0 0 5px rgba(204,31,41,.18); }
  .about-tl__year { text-align: right; font: 700 .85rem var(--font-mono); color: #A8121B; padding-top: .3rem; }
  .about-tl.is-now .about-tl__year { color: #fff; background: #CC1F29; border-radius: 9999px; padding: .25rem .6rem; text-align: center; justify-self: end; align-self: start; font-size: .72rem; }
  .about-tl__text { margin: 0; font-size: .9rem; line-height: 1.6; color: #3F4A5C; }

  .about-photo__cap { position: absolute; left: .75rem; right: .75rem; bottom: .75rem; padding: .7rem 1rem; border-radius: 1rem;
    background: rgba(10,14,20,.55); border: 1px solid rgba(255,255,255,.2); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); }

  .about-ico { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .9rem; color: #fff;
    background: linear-gradient(145deg, #CC1F29, #7f1017); box-shadow: 0 8px 22px -6px rgba(204,31,41,.55), inset 0 1px 0 rgba(255,255,255,.3); }

  .about-quote { position: relative; padding: 2rem 2rem 2rem 2.4rem; border-radius: 1.5rem; overflow: hidden;
    background: linear-gradient(135deg, #CC1F29 0%, #8f1219 100%); box-shadow: 0 24px 60px -20px rgba(204,31,41,.55), inset 0 1px 0 rgba(255,255,255,.3); }
  .about-quote::before { content: '\201C'; position: absolute; right: 1.2rem; top: -.6rem; font: 800 9rem/1 Georgia, serif; color: rgba(255,255,255,.12); }

  .about-card { position: relative; overflow: hidden; }
  .about-card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px; }
  .about-card--ink::before { background: linear-gradient(90deg, #0A0E14, #3F4A5C); }
  .about-card--red::before { background: linear-gradient(90deg, #CC1F29, #FF5A62); }
</style>
