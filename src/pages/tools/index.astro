---
import Base from '../../layouts/Base.astro';
import EyebrowLabel from '../../components/EyebrowLabel.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../utils/url';
import { tools, categories } from '../../data/tools';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free Electrical Testing Calculators',
  itemListElement: tools.map((t, i) => ({
    '@type': 'ListItem', position: i + 1, name: t.name, url: `https://www.cieinstruments.in/tools/${t.slug}/`,
  })),
};
---

<Base title="Free Electrical Testing Calculators" description={`${tools.length} free calculators from CIE, Howrah: insulation resistance, PI and DAR, three-phase power, power factor correction, voltage drop, motor slip, Ohm's law and more.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="blueprint-bg bg-ink text-white pt-10 pb-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="hub-crumbs"><Breadcrumbs crumbs={[{ label: 'Tools' }]} /></div>
      <EyebrowLabel text="Free Engineering Tools" class="mt-5 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-white leading-[1.1] tracking-tight max-w-4xl">Free Electrical Testing Calculators</h1>
      <p class="mt-3 text-muted-dark max-w-2xl text-body-lg">Small, fast tools for the people who use our instruments, from the team that has been building them in Howrah since 1963. No sign-up, nothing to install.</p>

      <div class="mt-8 flex flex-col md:flex-row md:items-center gap-4 md:justify-between">
        <div class="hub-filters" role="group" aria-label="Filter tools by category">
          <button type="button" class="hub-chip is-on" data-cat="all">All <span>{tools.length}</span></button>
          {categories.map(c => (
            <button type="button" class="hub-chip" data-cat={c}>{c} <span>{tools.filter(t => t.category === c).length}</span></button>
          ))}
        </div>
        <label class="hub-search">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="hub-q" type="search" placeholder="Search tools" autocomplete="off" aria-label="Search tools" />
        </label>
      </div>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="hub-grid" id="hub-grid">
        {tools.map(t => (
          <li data-cat={t.category} data-text={`${t.name} ${t.body} ${t.category}`.toLowerCase()}>
            <a href={u(`/tools/${t.slug}/`)} class="hub-card group">
              <div class="flex items-start justify-between">
                <span class="hub-ico"><Icon name={t.icon} class="w-6 h-6" /></span>
                {t.isNew && <span class="hub-new">New</span>}
              </div>
              <p class="hub-cat">{t.category}</p>
              <h2 class="hub-name">{t.name}</h2>
              <p class="hub-body">{t.body}</p>
              <span class="hub-go">Open calculator <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p id="hub-empty" class="hidden text-center text-muted py-16">No tools match that search. Try a different word.</p>

      <div class="mt-16 rounded-2xl bg-cloud p-8 sm:p-10 flex flex-col md:flex-row md:items-center gap-6 justify-between">
        <div>
          <h2 class="text-xl font-bold text-ink">Missing a calculator you need?</h2>
          <p class="mt-1 text-muted max-w-xl">Tell us what you test and we will build it. These tools come from questions our customers ask every week.</p>
        </div>
        <a href={u('/contact/')} class="btn-primary self-start md:self-auto whitespace-nowrap">Suggest a tool</a>
      </div>
    </div>
  </section>
  <CTABand />

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll('.hub-chip'), items = document.querySelectorAll('#hub-grid > li'), q = document.getElementById('hub-q'), empty = document.getElementById('hub-empty');
      var cat = 'all';
      function apply() {
        var s = q.value.trim().toLowerCase(), n = 0;
        items.forEach(function (li) {
          var ok = (cat === 'all' || li.dataset.cat === cat) && (!s || li.dataset.text.indexOf(s) >= 0);
          li.hidden = !ok; if (ok) n++;
        });
        empty.classList.toggle('hidden', n > 0);
      }
      chips.forEach(function (c) { c.addEventListener('click', function () {
        cat = c.dataset.cat; chips.forEach(function (x) { x.classList.toggle('is-on', x === c); }); apply();
      }); });
      q.addEventListener('input', apply);
      // soft spotlight that follows the pointer
      document.querySelectorAll('.hub-card').forEach(function (el) {
        el.addEventListener('pointermove', function (e) {
          var r = el.getBoundingClientRect();
          el.style.setProperty('--mx', (e.clientX - r.left) + 'px'); el.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });
      });
    })();
  </script>
</Base>

<style is:global>
  .hub-crumbs .text-ink { color: #fff; }
  .hub-filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .hub-chip { display: inline-flex; align-items: center; gap: .45rem; padding: .5rem .9rem; font-size: .85rem; font-weight: 600; color: #cbd5e1; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.14); border-radius: 999px; cursor: pointer; transition: all .2s; }
  .hub-chip span { font-family: var(--font-mono); font-size: .72rem; color: #7b8794; }
  .hub-chip:hover { border-color: var(--color-red); color: #fff; }
  .hub-chip.is-on { background: var(--color-red); border-color: var(--color-red); color: #fff; }
  .hub-chip.is-on span { color: rgba(255,255,255,.8); }
  .hub-chip:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .hub-search { display: flex; align-items: center; gap: .6rem; padding: 0 .9rem; height: 2.6rem; width: 100%; max-width: 18rem; border-radius: 999px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); color: #94a3b8; transition: border-color .2s, box-shadow .2s; }
  .hub-search:focus-within { border-color: var(--color-red); box-shadow: 0 0 0 3px rgba(224,37,46,.28); }
  .hub-search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: #fff; font-size: .9rem; }
  .hub-search input::placeholder { color: #7b8794; }

  .hub-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .hub-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .hub-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; } }
  .hub-grid > li { display: flex; }
  .hub-grid > li[hidden] { display: none; }
  .hub-card { position: relative; overflow: hidden; display: flex; flex-direction: column; width: 100%; padding: 1.6rem; border-radius: 1.1rem; color: #fff; background: rgba(14,18,26,.74); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); box-shadow: var(--glass-rim-dark), 0 16px 40px -16px rgba(10,14,20,.5); border: 1px solid rgba(255,255,255,.1); transition: transform .3s var(--ease-premium), border-color .25s, box-shadow .3s; --mx: 50%; --my: 0%; }
  .hub-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(260px circle at var(--mx) var(--my), rgba(224,37,46,.22), transparent 70%); opacity: 0; transition: opacity .3s; pointer-events: none; }
  .hub-card:hover { transform: translateY(-4px); border-color: var(--color-red); box-shadow: 0 18px 40px rgba(10,14,20,.28); }
  .hub-card:hover::before { opacity: 1; }
  .hub-card:focus-visible { outline: 2px solid var(--color-red); outline-offset: 3px; }
  .hub-ico { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .85rem; color: #fff; background: linear-gradient(145deg, var(--color-red), #8f1219); box-shadow: 0 6px 20px rgba(224,37,46,.3), inset 0 1px 0 rgba(255,255,255,.25); transition: transform .3s var(--ease-premium); }
  .hub-card:hover .hub-ico { transform: rotate(-6deg) scale(1.08); }
  .hub-new { padding: .2rem .6rem; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-radius: 999px; background: rgba(16,185,129,.16); color: #34d399; border: 1px solid rgba(16,185,129,.4); }
  .hub-cat { margin-top: 1.25rem; font-family: var(--font-mono); font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: #7b8794; }
  .hub-name { margin-top: .35rem; font-size: 1.25rem; font-weight: 700; line-height: 1.25; color: #fff; }
  .hub-body { margin-top: .5rem; color: #a3adb8; line-height: 1.55; font-size: .95rem; }
  .hub-go { margin-top: auto; padding-top: 1.25rem; font-weight: 600; font-size: .92rem; color: var(--color-red); }
  .hub-go span { display: inline-block; transition: transform .25s var(--ease-premium); }
  .hub-card:hover .hub-go span { transform: translateX(4px); }
</style>
