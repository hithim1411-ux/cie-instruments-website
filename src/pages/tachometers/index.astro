---
import Base from '../../layouts/Base.astro';
import { u } from '../../utils/url';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import handheld from '../../data/systems-tech-handheld-tachometers.json';
import panel from '../../data/systems-tech-panel-tachometers.json';
import sensors from '../../data/systems-tech-tachometer-sensors.json';

const pageTitle = 'Tachometers India: Handheld, Panel & Sensors | Buy from CIE';
const pageDesc =
  'Digital tachometers for India: Systems Tech handheld contact and non-contact RPM meters, panel mount tachometers and speed sensors. Buy from CIE Instruments, authorised distributor, Howrah and Kolkata.';

const faqs = [
  { q: 'What is a tachometer used for?', a: 'A tachometer measures how fast something rotates, in revolutions per minute (RPM). Maintenance teams use it on motors, fans, pumps, gearboxes, belts and machine spindles. With a wheel tip it can also read surface speed in metres per minute for conveyors, rollers and winders.' },
  { q: 'Which type of tachometer should I buy?', a: 'Choose a handheld contact tachometer (HTM 590) for accessible shafts and surface speed, a handheld non-contact tachometer (HTM 560) for guarded, small or very fast shafts, or the combined HTM 890 if your work varies. For a permanent display on a panel, choose a panel mount tachometer (TM-801 to TM-804) with the matching sensor.' },
  { q: 'What is the difference between a handheld and a panel tachometer?', a: 'A handheld tachometer is a portable instrument you carry to the machine for spot checks. A panel mount tachometer is fixed into a control panel and shows the speed continuously, fed by a sensor on the machine: a tachogenerator, magnetic pick-up, proximity switch or photo-reflective sensor.' },
  { q: 'Who supplies Systems Tech tachometers in India?', a: 'CIE Instruments (Cambridge Instruments & Engg. Co.), Howrah and Kolkata, is an authorised distributor of Systems Tech tachometers and sensors for India. Contact our team for price and availability, or order handheld models online on the OhmKart store.' },
  { q: 'How accurate are the handheld digital tachometers?', a: 'The HTM 590, HTM 560 and HTM 890 use a quartz crystal time base with an accuracy of 0.05% + 1 digit, a 5-digit LED display and automatic last, maximum and minimum memory.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.cieinstruments.in/' },
    { '@type': 'ListItem', position: 2, name: 'Tachometers', item: 'https://www.cieinstruments.in/tachometers/' },
  ],
};

const groups = [
  { slug: 'handheld-tachometers', title: 'Handheld Digital Tachometers', blurb: 'Portable RPM and surface speed meters for spot checks on motors, fans, pumps and belts.', items: handheld },
  { slug: 'panel-tachometers', title: 'Panel Mount Tachometers', blurb: 'Fixed digital displays for control panels, with a choice of sensor input.', items: panel },
  { slug: 'tachometer-sensors', title: 'Tachometer Sensors', blurb: 'Tachogenerator, magnetic pick-up, proximity and photo-reflective sensors for panel tachometers.', items: sensors },
];
const STORE = 'https://ohmkart.cieinstruments.in/c/handheld-tachometers';
---

<Base title={pageTitle} description={pageDesc} rawTitle keywords="tachometer India, digital tachometer, handheld tachometer, buy tachometer, tachometer price India, contact tachometer, non-contact tachometer, photo tachometer, panel mount tachometer, RPM meter, Systems Tech tachometer, HTM 590, HTM 560, HTM 890" ogImage={u('/images/systems-tech/systems-tech-logo.webp')}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: 'Tachometers' }]} />
      <p class="eyebrow mt-4 mb-3">Authorised Distributor - Systems Tech</p>
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Digital Tachometers in India</h1>
      <p class="mt-3 text-muted max-w-2xl leading-relaxed">
        Handheld contact and non-contact RPM meters, panel mount tachometers and speed sensors from Systems Tech, supplied by CIE Instruments to factories, workshops, power plants, labs and colleges across India. Buy direct from us, from Howrah and Kolkata.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={u('/products/systems-tech-handheld-tachometers/')} class="btn-primary">Handheld Tachometers</a>
        <a href={STORE} class="btn-secondary text-ink">Buy online on OhmKart</a>
        <a href={u('/contact/')} class="btn-secondary text-ink">Get a Quote</a>
      </div>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-ink mb-2">Which tachometer do you need?</h2>
      <p class="text-sm text-muted mb-6 max-w-2xl">Start from the job. Every model is a Systems Tech instrument supplied by CIE.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left border border-border rounded-xl overflow-hidden">
          <thead class="bg-cloud text-ink">
            <tr><th class="p-3 font-semibold">If you need to</th><th class="p-3 font-semibold">Choose</th><th class="p-3 font-semibold">Range</th></tr>
          </thead>
          <tbody class="text-muted">
            <tr class="border-t border-border"><td class="p-3">Check a motor or fan shaft you can safely touch</td><td class="p-3"><a class="text-ink font-medium hover:underline" href={u('/authorised-dealership/handheld-tachometers/htm-590/')}>HTM 590</a> contact</td><td class="p-3">60 to 50,000 RPM</td></tr>
            <tr class="border-t border-border"><td class="p-3">Read belts, rollers and conveyors in m/min</td><td class="p-3"><a class="text-ink font-medium hover:underline" href={u('/authorised-dealership/handheld-tachometers/htm-590/')}>HTM 590</a> or <a class="text-ink font-medium hover:underline" href={u('/authorised-dealership/handheld-tachometers/htm-890/')}>HTM 890</a></td><td class="p-3">6 to 5000 m/min</td></tr>
            <tr class="border-t border-border"><td class="p-3">Measure a guarded, small or very fast shaft without touching it</td><td class="p-3"><a class="text-ink font-medium hover:underline" href={u('/authorised-dealership/handheld-tachometers/htm-560/')}>HTM 560</a> non-contact</td><td class="p-3">60 to 1,00,000 RPM</td></tr>
            <tr class="border-t border-border"><td class="p-3">One instrument for contact, surface speed and non-contact</td><td class="p-3"><a class="text-ink font-medium hover:underline" href={u('/authorised-dealership/handheld-tachometers/htm-890/')}>HTM 890</a> combined</td><td class="p-3">Both ranges</td></tr>
            <tr class="border-t border-border"><td class="p-3">Show speed continuously on a control panel</td><td class="p-3"><a class="text-ink font-medium hover:underline" href={u('/products/systems-tech-panel-tachometers/')}>TM-801 to TM-804</a> panel tachometers</td><td class="p-3">By sensor type</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {groups.map((g, gi) => (
    <section class={`${gi % 2 === 0 ? 'bg-cloud' : 'bg-white'} section-pad-sm border-t border-border`}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between flex-wrap gap-3 mb-6">
          <div>
            <h2 class="text-xl font-bold text-ink">{g.title}</h2>
            <p class="text-sm text-muted mt-1 max-w-2xl">{g.blurb}</p>
          </div>
          <a href={u(`/products/systems-tech-${g.slug}/`)} class="text-sm font-semibold text-ink hover:underline">View all {g.items.length} →</a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
          {g.items.slice(0, 5).map((p: any) => (
            <a href={u(`/authorised-dealership/${g.slug}/${p.id}/`)} class="card card-interactive group overflow-hidden flex flex-col">
              <div class="bg-cloud h-40 flex items-center justify-center overflow-hidden">
                <img src={u(`/images/systems-tech/${g.slug}/${p.images[0]}`)} alt={`${p.model} ${p.name}`} width="240" height="240" loading="lazy"
                  class="object-contain h-32 w-auto transition-transform duration-300 group-hover:scale-105" />
              </div>
              <div class="p-4">
                <p class="text-[11px] font-mono text-red mb-1">{p.model}</p>
                <h3 class="font-bold text-ink text-sm leading-snug">{p.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="bg-white section-pad-sm border-t border-border">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-ink mb-5">Tachometer questions</h2>
      <div class="space-y-3">
        {faqs.map(f => (
          <details class="border border-border rounded-xl p-4 group">
            <summary class="font-semibold text-ink cursor-pointer">{f.q}</summary>
            <p class="mt-3 text-sm text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
      <h2 class="text-xl font-bold text-ink mt-10 mb-4">Guides and tools</h2>
      <ul class="space-y-2 text-sm">
        <li><a class="text-ink font-medium hover:underline" href={u('/blog/how-to-buy-a-digital-tachometer-in-india/')}>How to buy a digital tachometer in India</a></li>
        <li><a class="text-ink font-medium hover:underline" href={u('/blog/contact-vs-non-contact-tachometer/')}>Contact vs non-contact tachometer</a></li>
        <li><a class="text-ink font-medium hover:underline" href={u('/blog/how-to-measure-motor-rpm-with-a-tachometer/')}>How to measure motor RPM with a tachometer</a></li>
        <li><a class="text-ink font-medium hover:underline" href={u('/tools/rpm-surface-speed-pulley-calculator/')}>RPM, pulley and belt speed calculator</a></li>
        <li><a class="text-ink font-medium hover:underline" href={u('/tools/motor-speed-slip-calculator/')}>Motor speed and slip calculator</a></li>
      </ul>
    </div>
  </section>

  <CTABand heading="Need a tachometer? Buy it from CIE." body="Tell us the machine, the speed range and whether the shaft is guarded. We will suggest the model and send a quote." primaryLabel="Request a Quote" primaryHref={u('/contact/')} />
</Base>
