    ['Lose the trigger', function () { S.src = ['fg', 'off']; S.fg = { shape: 'sine', f: 1000, a: 4, off: 0, duty: 50, phase: 60 }; S.tdi = 14; S.vi[0] = 9; S.tl = 3.5; S.mode = 'auto'; S.run = true; }]
  ];
  var sc = $('scen'); SC.forEach(function (s) { var b = document.createElement('button'); b.type = 'button'; b.className = 'vi-chip'; b.textContent = s[0]; b.addEventListener('click', function () { S = fresh(); s[1](); if (S.src.indexOf('mic') < 0) micStop(); S.armed = false; S.pos = [0, 0]; syncAll(); }); sc.appendChild(b); });

  $('runstop').addEventListener('click', function () { S.run = !S.run; if (S.run && S.mode === 'single') S.armed = true; syncAll(); });
  $('autoset').addEventListener('click', autoset);
  $('reset').addEventListener('click', function () { micStop(); S = fresh(); syncAll(); });
  document.addEventListener('keydown', function (e) { if (/INPUT|SELECT|TEXTAREA/.test((e.target || {}).tagName || '')) return; if (e.key === 'a' || e.key === 'A') autoset(); else if (e.key === ' ' && !(e.target && e.target.getAttribute && e.target.getAttribute('role') === 'button')) { e.preventDefault(); S.run = !S.run; syncAll(); } });
  window.addEventListener('pagehide', micStop);

  syncAll(); autoset(); VI.rafLoop(frame);
})();
</script>
