          <div class="vi-seg" id="lead-seg" role="radiogroup" aria-label="Test lead sockets">
            <button type="button" data-v="none" role="radio">No leads</button>
            <button type="button" data-v="ins" role="radio">Insulation<small>LINE + EARTH</small></button>
            <button type="button" data-v="dmm" role="radio">Multimeter<small>V&Omega; + COM</small></button>
          </div>
          <label class="vi-check" id="guard-row"><input type="checkbox" id="guard" /> <span>Add a lead to GUARD (bypasses surface leakage)</span></label>
          <p class="vi-note" id="lead-note"></p>
        </section>

        <section class="vi-card">
          <h2 class="vi-h"><span>2</span><b id="obj-title">What are you connecting to?</b></h2>
          <div id="obj-panel"></div>
        </section>

        <section class="vi-card vi-live">
          <h2 class="vi-h"><span>3</span>What the instrument is doing</h2>
          <div class="vi-status" id="status" aria-live="polite"></div>
          <div id="res-wrap" hidden>
            <table class="vi-table" id="res-table"></table>
            <svg id="chart" viewBox="0 0 420 170" role="img" aria-label="Insulation resistance against time"></svg>
          </div>
          <div class="vi-spec" id="spec"></div>
        </section>

        <section class="vi-card">
          <h2 class="vi-h"><span>4</span>Simulator settings</h2>
          <div class="vi-row">
            <span class="vi-lbl">Test speed</span>
            <div class="vi-seg vi-seg--sm" id="speed-seg" role="radiogroup" aria-label="Simulation speed">
              <button type="button" data-v="1" role="radio">1×</button>
              <button type="button" data-v="10" role="radio">10×</button>
              <button type="button" data-v="60" role="radio">60×</button>
            </div>
          </div>
          <div class="vi-row">
            <span class="vi-lbl">Sound (buzzer, clicks)</span>
            <label class="vi-switch"><input type="checkbox" id="sound" checked /><span></span></label>
          </div>
          <div class="vi-row">
            <span class="vi-lbl">Reset everything</span>
            <button type="button" class="vi-btn" id="reset">Reset</button>
          </div>
        </section>
  </Fragment>
  <Fragment slot="about">
      <ul>
        <li><strong>Insulation side (100, 250, 500, 1000 and 2500 V):</strong> turn the dial to a test voltage, connect the leads to LINE and EARTH, and press TEST. The tester applies that DC voltage and reports the resistance, from 0.1 MΩ up to 50 GΩ depending on the voltage.</li>
        <li><strong>Why the reading climbs:</strong> when you first apply voltage, a charging and absorption current flows. It decays over minutes, so the resistance rises. A dry, healthy winding climbs steadily. A damp or dirty one stays flat. That is the idea behind the DAR and PI tests.</li>
        <li><strong>DAR and PI:</strong> DAR compares the 1-minute reading with the 15 s or 30 s reading. PI compares the 10-minute reading with the 1-minute reading. Use the speed setting to run a full 10-minute test in about ten seconds.</li>
        <li><strong>Discharge:</strong> after any insulation test the object holds a charge. The display shows the voltage decaying. Keep the leads on until it reaches zero.</li>
        <li><strong>Multimeter side:</strong> AC and DC voltage up to 1500 V (True-RMS on AC), resistance up to 60 MΩ, capacitance up to 100 mF, frequency, diode test and continuity buzzer.</li>
      </ul>
      <p class="vi-fine">This is a training simulation. The ranges, accuracy figures and test voltages come from the DIT-2500 specification. Test objects are idealised models, so real readings will differ. The exact button behaviour, display layout and timings of the physical instrument are approximated, so always follow the instruction manual and your site safety procedure. Never test live circuits.</p>
  </Fragment>
</VIShell>

<script is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var NS = 'http://www.w3.org/2000/svg';
  var svg = $('vi-svg');
  function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; }

  /* ───────────── audio ───────────── */
  var AC = null, buzzOsc = null, buzzGain = null;
  function ctx() { if (!AC) { try { AC = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } } if (AC.state === 'suspended') AC.resume(); return AC; }
  function tick(f, dur, vol) {
    if (!S.sound) return; var a = ctx(); if (!a) return;
    var o = a.createOscillator(), g = a.createGain(); o.type = 'square'; o.frequency.value = f; g.gain.value = vol || .03;
    o.connect(g); g.connect(a.destination); o.start(); g.gain.exponentialRampToValueAtTime(.0001, a.currentTime + dur); o.stop(a.currentTime + dur + .02);
  }
  function buzz(on) {
    var a = AC;
    if (on && S.sound) {
      a = ctx(); if (!a) return;
      if (!buzzOsc) { buzzOsc = a.createOscillator(); buzzGain = a.createGain(); buzzOsc.type = 'square'; buzzOsc.frequency.value = 2400; buzzGain.gain.value = .035; buzzOsc.connect(buzzGain); buzzGain.connect(a.destination); buzzOsc.start(); }
    } else if (buzzOsc) { try { buzzOsc.stop(); } catch (e) {} buzzOsc.disconnect(); buzzGain.disconnect(); buzzOsc = null; }
  }

  /* ───────────── seven-segment display ───────────── */
  var SEGMAP = { '0': 'abcdef', '1': 'bc', '2': 'abdeg', '3': 'abcdg', '4': 'bcfg', '5': 'acdfg', '6': 'acdefg', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg', '-': 'g', ' ': '', 'L': 'def', 'O': 'abcdef', 'E': 'adefg', 'r': 'eg', 'n': 'ceg', 'o': 'cdeg', 'P': 'abefg', 'A': 'abcefg', 'F': 'aefg', 't': 'defg', 'U': 'bcdef' };
  function poly(pts, parent) { return el('polygon', { 'class': 'seg', points: pts.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ') }, parent); }
  function build(parent, n, x0, y0, pitch, w, h, t, skew) {
    var g = el('g', { transform: 'translate(' + x0 + ' ' + y0 + ') skewX(' + (-skew) + ')' }, parent), out = [], gap = t * .55, mid = h / 2;
    for (var i = 0; i < n; i++) {
      var x = i * pitch, s = {};
      var H = function (cy) { var xa = x + gap, xb = x + w - gap; return poly([[xa, cy], [xa + t / 2, cy - t / 2], [xb - t / 2, cy - t / 2], [xb, cy], [xb - t / 2, cy + t / 2], [xa + t / 2, cy + t / 2]], g); };
      var V = function (cx, ya, yb) { return poly([[cx, ya], [cx + t / 2, ya + t / 2], [cx + t / 2, yb - t / 2], [cx, yb], [cx - t / 2, yb - t / 2], [cx - t / 2, ya + t / 2]], g); };
      var u0 = t * .5 + gap * .7, u1 = mid - gap * .7, l0 = mid + gap * .7, l1 = h - t * .5 - gap * .7;
      s.a = H(t / 2); s.d = H(h - t / 2); s.g = H(mid);
      s.f = V(x + t / 2, u0, u1); s.b = V(x + w - t / 2, u0, u1); s.e = V(x + t / 2, l0, l1); s.c = V(x + w - t / 2, l0, l1);
      s.dp = el('circle', { 'class': 'seg', cx: x + w + t * .75, cy: h - t * .35, r: t * .55 }, g);
      out.push(s);
    }
    return out;
  }
  function setDigits(d, str, dp) {
