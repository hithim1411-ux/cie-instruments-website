    var d = S.dial;
    if (d === 6) h += '<p>Measuring DC voltage: <strong>' + eng(S.dcv, 'V') + '</strong>.' + (S.dcv > 1000 && S.dcv <= 1500 ? ' Above the 1000 V CAT III rating, take care.' : '') + '</p>' + (S.dcv > 1500 ? '<p class="warn">Over 1500 V: the display shows OL. Disconnect. This exceeds the maximum input.</p>' : '');
    if (d === 7) { h += '<p>Measuring True-RMS AC voltage: <strong>' + eng(S.acv, 'V') + '</strong> at <strong>' + eng(S.hz, 'Hz') + '</strong>.</p>'; if (S.hz < 40 || S.hz > 1000) h += '<p class="warn">Outside the 40 Hz to 1 kHz band where AC accuracy is specified.</p>'; if (S.acv > 1500) h += '<p class="warn">Over 1500 V: OL. Disconnect.</p>'; }
    if (d === 8) h += S.ohmFn === 'R' ? '<p>Measuring resistance: <strong>' + eng(S.rOhm, 'Ω') + '</strong>' + (S.rOhm > 60e6 ? ' (above 60 MΩ, so OL)' : '') + '. Make sure the circuit is dead.</p>' : '<p>Measuring capacitance: <strong>' + eng(S.cap, 'F') + '</strong>.</p>';
    if (d === 9) h += S.dFn === 'D' ? '<p>Diode test: <strong>' + DIODES[S.dio].name + '</strong>.</p>' : '<p>Continuity: <strong>' + CONTS[S.cont].name + '</strong>' + (m.beep ? ', buzzer <strong class="ok">ON</strong>.' : ', no buzzer.') + '</p>';
    if (S.hold) h += '<p>Display is on <strong>HOLD</strong>.</p>';
    return h;
  }

  function drawResults() {
    var o = curObj(), V = vNom(), t = S.t, rows = [];
    var pts = [15, 30, 60, 600], key = {};
    pts.forEach(function (p) { if (t + 1e-6 >= p) { var r = Rt(o, V, p); key[p] = r > MAXR[S.dial - 1] ? Infinity : r; } });
    function f(p) { if (key[p] === undefined) return '-'; var r = key[p]; if (!isFinite(r)) return '> ' + (MAXR[S.dial - 1] >= 1000 ? MAXR[S.dial - 1] / 1000 + ' GΩ' : MAXR[S.dial - 1] + ' MΩ'); r = Math.min(r, MAXR[S.dial - 1]); var q = insFmt(r); return (+q.v.toFixed(q.d)) + ' ' + q.u; }
    var h = '<tr><th>Reading</th><th style="text-align:right">Value</th></tr>';
    pts.forEach(function (p) { h += '<tr><td>' + (p === 15 ? 'IR at 15 s' : p === 30 ? 'IR at 30 s' : p === 60 ? 'IR at 1 min' : 'IR at 10 min') + '</td><td>' + f(p) + '</td></tr>'; });
    function ratio(a, b) { return key[a] !== undefined && key[b] !== undefined && isFinite(key[a]) && isFinite(key[b]) && key[b] > 0 ? key[a] / key[b] : NaN; }
    var d15 = ratio(60, 15), d30 = ratio(60, 30), pi = ratio(600, 60);
    function darV(d) { return d < 1 ? badge('bad', 'Poor') : d < 1.25 ? badge('warn', 'Questionable') : d < 1.6 ? badge('good', 'Acceptable') : badge('good', 'Excellent'); }
    if (isFinite(d15)) h += '<tr><td>DAR (1 min : 15 s)</td><td>' + d15.toFixed(2) + '</td></tr>';
    if (isFinite(d30)) h += '<tr><td>DAR (1 min : 30 s)</td><td>' + d30.toFixed(2) + darV(d30) + '</td></tr>';
    if (isFinite(pi)) h += '<tr><td>PI (10 min : 1 min)</td><td>' + pi.toFixed(2) + (pi < 1 ? badge('bad', 'Dangerous') : pi < 2 ? badge('warn', 'Questionable') : pi < 4 ? badge('good', 'Good') : badge('good', 'Excellent')) + '</td></tr>';
    $('res-table').innerHTML = h;
    S.res.ratio = S.pd === 1 ? d15 : S.pd === 2 ? d30 : S.pd === 3 ? pi : undefined;
    drawChart(o, V);
  }
  function drawChart(o, V) {
    var c = $('chart'), W = 420, H = 170, L = 38, Rr = 10, T = 12, B = 24;
    var tmax = S.pd === 3 || S.t > 70 ? 600 : 60, vals = S.samples;
    var ymax = 0; vals.forEach(function (p) { if (isFinite(p[1]) && p[1] > ymax) ymax = p[1]; });
    var ymaxRange = MAXR[S.dial - 1]; if (!isFinite(o.r60)) ymax = ymaxRange;
    ymax = Math.min(Math.max(ymax, .001) * 1.15, ymaxRange);
    var X = function (t) { return L + (W - L - Rr) * Math.min(t, tmax) / tmax; }, Y = function (r) { return T + (H - T - B) * (1 - Math.min(r, ymax) / ymax); };
    var s = '<line x1="' + L + '" y1="' + (H - B) + '" x2="' + (W - Rr) + '" y2="' + (H - B) + '" stroke="#334155"/><line x1="' + L + '" y1="' + T + '" x2="' + L + '" y2="' + (H - B) + '" stroke="#334155"/>';
    (tmax === 600 ? [60, 600] : [15, 30, 60]).forEach(function (p) { if (p <= tmax) s += '<line x1="' + X(p) + '" y1="' + T + '" x2="' + X(p) + '" y2="' + (H - B) + '" stroke="#334155" stroke-dasharray="3 4"/><text x="' + X(p) + '" y="' + (H - 9) + '" text-anchor="middle">' + (p >= 60 ? p / 60 + 'm' : p + 's') + '</text>'; });
    var q = insFmt(ymax); s += '<text x="' + (L - 4) + '" y="' + (T + 8) + '" text-anchor="end">' + (+q.v.toPrecision(2)) + q.u.charAt(0) + '</text><text x="' + (L - 4) + '" y="' + (H - B) + '" text-anchor="end">0</text>';
    var pts = vals.filter(function (p) { return isFinite(p[1]); }).map(function (p) { return X(p[0]).toFixed(1) + ',' + Y(p[1]).toFixed(1); }).join(' ');
    if (pts) s += '<polyline points="' + pts + '" fill="none" stroke="#ff5a62" stroke-width="2.2" stroke-linejoin="round"/>';
    if (vals.length) { var lp = vals[vals.length - 1]; if (isFinite(lp[1])) s += '<circle cx="' + X(lp[0]).toFixed(1) + '" cy="' + Y(lp[1]).toFixed(1) + '" r="3.5" fill="#fff"/>'; }
    s += '<text x="' + (W - Rr) + '" y="' + (T + 8) + '" text-anchor="end">IR vs time</text>';
    c.innerHTML = s;
  }

  /* object / source panel */
  function opt(group, key, name, desc) { return '<button type="button" class="vi-opt" role="radio" data-g="' + group + '" data-k="' + key + '"><strong>' + name + '</strong><span>' + desc + '</span></button>'; }
  function slider(id, label, min, max, step) { return '<div class="vi-slider"><label for="' + id + '">' + label + '<output id="' + id + '-o"></output></label><input type="range" id="' + id + '" min="' + min + '" max="' + max + '" step="' + step + '"></div>'; }
  function qc(id, items) { return '<div class="vi-qc">' + items.map(function (i) { return '<button type="button" data-q="' + id + '" data-val=\'' + JSON.stringify(i[1]) + '\'>' + i[0] + '</button>'; }).join('') + '</div>'; }
  function buildObj(fam) {
    var h = '', title = 'What are you connecting to?';
    if (fam === 'ins') { title = 'Choose the test object'; h = '<div class="vi-opts">' + Object.keys(OBJS).map(function (k) { return opt('obj', k, OBJS[k].name, OBJS[k].desc); }).join('') + '</div>'; }
    else if (fam === 'dc') { title = 'Set the DC source'; h = slider('s-dcv', 'DC voltage', 0, 1600, 1) + qc('dcv', [['1.5 V cell', 1.5], ['12 V battery', 12.6], ['24 V supply', 24.2], ['600 V DC bus', 600], ['1000 V PV string', 1000], ['1600 V (too high)', 1600]]); }
    else if (fam === 'ac') { title = 'Set the AC source'; h = slider('s-acv', 'AC voltage (RMS)', 0, 1600, 1) + slider('s-hz', 'Frequency (log scale)', 0, 1000, 1) + qc('ac', [['230 V, 50 Hz', [230, 50]], ['415 V, 50 Hz', [415, 50]], ['110 V, 60 Hz', [110, 60]], ['12 V, 400 Hz', [12, 400]], ['24 V, 20 kHz', [24, 20000]]]); }
    else if (fam === 'ohmR') { title = 'Set the resistance'; h = '<p class="vi-note" style="margin:0 0 .4rem">Function: <strong>Resistance</strong>. Press TIME (SELECT) on the instrument to switch to capacitance.</p>' + slider('s-r', 'Resistance (log scale)', 0, 1000, 1) + qc('r', [['10 Ω', 10], ['470 Ω', 470], ['4.7 kΩ', 4700], ['100 kΩ', 1e5], ['1 MΩ', 1e6], ['22 MΩ', 22e6], ['100 MΩ (over)', 1e8]]); }
    else if (fam === 'ohmC') { title = 'Set the capacitor'; h = '<p class="vi-note" style="margin:0 0 .4rem">Function: <strong>Capacitance</strong>. Press TIME (SELECT) to switch back to resistance.</p>' + slider('s-c', 'Capacitance (log scale)', 0, 1000, 1) + qc('c', [['100 nF', 1e-7], ['4.7 µF', 4.7e-6], ['100 µF', 1e-4], ['4700 µF', 4.7e-3], ['47 mF', .047]]); }
    else if (fam === 'diodeD') { title = 'Choose the component'; h = '<p class="vi-note" style="margin:0 0 .6rem">Function: <strong>Diode test</strong>. Press TIME (SELECT) for continuity.</p><div class="vi-opts">' + Object.keys(DIODES).map(function (k) { return opt('dio', k, DIODES[k].name, DIODES[k].desc); }).join('') + '</div>'; }
    else if (fam === 'diodeC') { title = 'Choose the circuit'; h = '<p class="vi-note" style="margin:0 0 .6rem">Function: <strong>Continuity</strong>. Press TIME (SELECT) for diode test.</p><div class="vi-opts">' + Object.keys(CONTS).map(function (k) { return opt('cont', k, CONTS[k].name, CONTS[k].desc); }).join('') + '</div>'; }
    else h = '<p class="vi-note" style="margin:0">Turn the dial to a function to see what you can connect.</p>';
    $('obj-title').textContent = title; $('obj-panel').innerHTML = h;
  }
  function logToVal(v, lo, hi) { return Math.pow(10, lo + (hi - lo) * v / 1000); }
  function valToLog(x, lo, hi) { return Math.round(1000 * (Math.log10(x) - lo) / (hi - lo)); }
  function syncObj() {
    Array.prototype.forEach.call(document.querySelectorAll('#obj-panel .vi-opt'), function (b) { b.setAttribute('aria-checked', S[b.getAttribute('data-g')] === b.getAttribute('data-k')); });
    var q = function (id) { return $(id); };
    if (q('s-dcv')) { q('s-dcv').value = S.dcv; q('s-dcv-o').textContent = eng(S.dcv, 'V'); }
    if (q('s-acv')) { q('s-acv').value = S.acv; q('s-acv-o').textContent = eng(S.acv, 'V'); q('s-hz').value = valToLog(S.hz, 1, 4.3); q('s-hz-o').textContent = eng(S.hz, 'Hz'); }
    if (q('s-r')) { q('s-r').value = valToLog(S.rOhm, 0, 8); q('s-r-o').textContent = eng(S.rOhm, 'Ω'); }
    if (q('s-c')) { q('s-c').value = valToLog(S.cap, -9, -1); q('s-c-o').textContent = eng(S.cap, 'F'); }
  }

  /* ───────────── actions ───────────── */
  function stopTest(done) {
    if (!S.testing) return;
    S.testing = false; S.done = !!done; S.have = true;
    var o = curObj(); S.dis = { v: S.lastV || 0, tau: o.tau || 2 };
    if (S.dis.v < 5) S.dis = null;
    tick(520, .12);
  }
  function resetTestState() { S.testing = false; S.have = false; S.done = false; S.t = 0; S.dis = null; S.samples = []; S.res = {}; S.lastR = NaN; S.hold = false; S.frozen = null; }
  function setDial(i, silent) {
    i = Math.max(0, Math.min(10, i)); if (i === S.dial) return;
    S.dial = i; resetTestState(); S.pd = 0; S.timerSel = 0;
    if (!silent) tick(900, .04, .025);
    render();
  }
  function pressTest() {
    tick(700, .06);
    if (!isIns()) return;
    if (S.testing) { stopTest(false); render(); return; }
    S.have = false; S.done = false; S.dis = null; S.t = 0; S.samples = []; S.res = {}; S.hold = false; S.frozen = null; S.testing = true; lastTs = 0; render();
  }
  function pressPD() { tick(700, .05); if (!isIns() || S.testing) return; S.pd = (S.pd + 1) % 4; if (S.pd) S.timerSel = 0; if (S.have) { resetTestState(); } render(); }
  function pressTime() {
    tick(700, .05);
    if (isIns()) { if (S.testing) return; S.timerSel = (S.timerSel + 1) % 5; if (S.timerSel) S.pd = 0; if (S.have) resetTestState(); render(); return; }
    if (S.dial === 8) { S.ohmFn = S.ohmFn === 'R' ? 'C' : 'R'; S.hold = false; S.frozen = null; render(); }
    else if (S.dial === 9) { S.dFn = S.dFn === 'D' ? 'C' : 'D'; S.hold = false; S.frozen = null; render(); }
  }
  function pressHold() { tick(700, .05); if (S.dial === 0 || S.dial === 10) return; S.hold = !S.hold; S.frozen = null; render(); }
  function backlight() { if (S.dial === 0 || S.dial === 10) return; S.bl = !S.bl; tick(1100, .05); render(); }

  /* button wiring: press feedback, short vs long press */
  [['btn-test', pressTest], ['btn-pidar', pressPD], ['btn-time', pressTime], ['btn-hold', pressHold]].forEach(function (b) {
    var e = $(b[0]), timer = null, long = false, active = false;
    e.addEventListener('pointerdown', function (ev) { ev.preventDefault(); active = true; long = false; e.classList.add('down'); ctx(); if (b[0] === 'btn-hold') timer = setTimeout(function () { long = true; backlight(); }, 750); });
    function up(cancel) { if (!active) return; active = false; e.classList.remove('down'); clearTimeout(timer); if (!cancel && !long) b[1](); }
    e.addEventListener('pointerup', function () { up(false); });
    e.addEventListener('pointerleave', function () { up(true); });
    e.addEventListener('pointercancel', function () { up(true); });
    e.addEventListener('keydown', function (ev) { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); if (!ev.repeat) { e.classList.add('down'); b[1](); } } });
    e.addEventListener('keyup', function () { e.classList.remove('down'); });
  });

  /* dial: drag, click, keys */
  (function () {
    var dial = $('dial'), dragging = false;
    function ang(ev) { var pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY; var p = pt.matrixTransform(svg.getScreenCTM().inverse()); var a = Math.atan2(p.x - 607, -(p.y - 845)) * 180 / Math.PI; if (a > 90) a = 90; if (a < -90) a = -90; if (Math.hypot(p.x - 607, p.y - 845) < 25) return null; return a; }
    dial.addEventListener('pointerdown', function (ev) { ev.preventDefault(); ctx(); dragging = true; dial.classList.add('drag'); try { dial.setPointerCapture(ev.pointerId); } catch (e) {} var a = ang(ev); if (a !== null) setDial(Math.round((a + 90) / 18)); });
    dial.addEventListener('pointermove', function (ev) { if (!dragging) return; var a = ang(ev); if (a !== null) setDial(Math.round((a + 90) / 18)); });
    function end() { dragging = false; dial.classList.remove('drag'); }
    dial.addEventListener('pointerup', end); dial.addEventListener('pointercancel', end);
    dial.addEventListener('keydown', function (ev) { if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') { ev.preventDefault(); setDial(S.dial + 1); } else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') { ev.preventDefault(); setDial(S.dial - 1); } else if (ev.key === 'Home') setDial(0); else if (ev.key === 'End') setDial(10); });
    Array.prototype.forEach.call(document.querySelectorAll('.pos'), function (p) { p.addEventListener('click', function () { ctx(); setDial(+p.getAttribute('data-i')); }); });
  })();
  document.addEventListener('keydown', function (ev) {
    if (ev.target && /INPUT|TEXTAREA|SELECT/.test(ev.target.tagName) || ev.metaKey || ev.ctrlKey || ev.altKey) return;
    var k = ev.key.toLowerCase();
    if (k === 't') pressTest(); else if (k === 'p') pressPD(); else if (k === 'i') pressTime(); else if (k === 'h') pressHold(); else if (k === 'b') backlight();
    else if (ev.key === 'ArrowRight' && !(ev.target && ev.target.id === 'dial')) setDial(S.dial + 1); else if (ev.key === 'ArrowLeft' && !(ev.target && ev.target.id === 'dial')) setDial(S.dial - 1);
  });

  /* control panel wiring */
  $('lead-seg').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; S.leads = b.getAttribute('data-v'); if (S.testing) { stopTest(false); } tick(600, .04); render(); });
  $('guard').addEventListener('change', function (e) { S.guard = e.target.checked; $('leads').removeAttribute('data-k'); render(); });
  $('speed-seg').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; S.speed = +b.getAttribute('data-v'); render(); });
  $('sound').addEventListener('change', function (e) { S.sound = e.target.checked; if (!S.sound) buzz(false); render(); });
  $('reset').addEventListener('click', function () { var snd = S.sound; S = fresh(); S.sound = snd; $('leads').removeAttribute('data-k'); lastSig = ''; render(); });
  $('obj-panel').addEventListener('click', function (e) {
    var b = e.target.closest('.vi-opt');
    if (b) { S[b.getAttribute('data-g')] = b.getAttribute('data-k'); if (b.getAttribute('data-g') === 'obj' && (S.testing || S.have)) { if (S.testing) stopTest(false); } render(); return; }
    var q = e.target.closest('[data-q]'); if (!q) return; var v = JSON.parse(q.getAttribute('data-val')), id = q.getAttribute('data-q');
    if (id === 'dcv') S.dcv = v; else if (id === 'ac') { S.acv = v[0]; S.hz = v[1]; } else if (id === 'r') S.rOhm = v; else if (id === 'c') S.cap = v;
    S.frozen = null; S.hold = false; render();
  });
  $('obj-panel').addEventListener('input', function (e) {
    var id = e.target.id, v = +e.target.value; S.frozen = null; S.hold = false;
    if (id === 's-dcv') S.dcv = v; else if (id === 's-acv') S.acv = v; else if (id === 's-hz') S.hz = logToVal(v, 1, 4.3); else if (id === 's-r') S.rOhm = logToVal(v, 0, 8); else if (id === 's-c') S.cap = logToVal(v, -9, -1);
    render();
  });

  /* scenarios */
  var SCEN = [
    ['500 V test, healthy motor', function () { S.dial = 3; S.leads = 'ins'; S.obj = 'motor-ok'; S.pd = 0; S.timerSel = 0; S.speed = 10; }],
    ['10-minute PI test', function () { S.dial = 4; S.leads = 'ins'; S.obj = 'motor-ok'; S.pd = 3; S.timerSel = 0; S.speed = 60; }],
    ['Damp winding, DAR', function () { S.dial = 3; S.leads = 'ins'; S.obj = 'motor-damp'; S.pd = 2; S.timerSel = 0; S.speed = 10; }],
    ['Open circuit at 2500 V', function () { S.dial = 5; S.leads = 'ins'; S.obj = 'open'; S.pd = 0; S.timerSel = 0; S.speed = 10; }],
    ['Earth fault', function () { S.dial = 3; S.leads = 'ins'; S.obj = 'fault'; S.pd = 0; S.timerSel = 0; S.speed = 10; }],
    ['Surface leakage and GUARD', function () { S.dial = 4; S.leads = 'ins'; S.obj = 'surface'; S.guard = false; S.pd = 0; S.timerSel = 2; S.speed = 10; }],
    ['Mains voltage (AC)', function () { S.dial = 7; S.leads = 'dmm'; S.acv = 230; S.hz = 50; }],
    ['Cable continuity', function () { S.dial = 9; S.leads = 'dmm'; S.dFn = 'C'; S.cont = 'wire'; }]
  ];
  $('scen').innerHTML = SCEN.map(function (s, i) { return '<button type="button" class="vi-chip" data-s="' + i + '">' + s[0] + '</button>'; }).join('');
  $('scen').addEventListener('click', function (e) {
    var b = e.target.closest('[data-s]'); if (!b) return; ctx();
    var bl = S.bl, snd = S.sound; S = fresh(); S.bl = bl; S.sound = snd; SCEN[+b.getAttribute('data-s')][1](); $('leads').removeAttribute('data-k'); lastSig = ''; tick(900, .05); render();
  });

  /* ───────────── loop ───────────── */
  var lastTs = 0, lastDraw = 0, lastSample = -1;
  function frame(ts) {
    if (!lastTs) lastTs = ts;
    var dt = Math.min((ts - lastTs) / 1000, .25) * S.speed; lastTs = ts;
    var dirty = false;
    if (S.testing) {
      S.t += dt; dirty = true;
      var dur = testDur();
      if (S.t >= dur) { S.t = dur; stopTest(true); }
      var floorT = Math.floor(S.t * 2) / 2;
      if (floorT !== lastSample) { lastSample = floorT; var r = Rt(curObj(), vNom(), S.t); if (S.samples.length < 1300) S.samples.push([S.t, isNaN(r) ? NaN : Math.min(r, MAXR[S.dial - 1])]); }
    } else lastSample = -1;
    if (S.dis) { S.dis.v *= Math.exp(-dt / S.dis.tau); if (S.dis.v < 3) S.dis = null; dirty = true; }
    if (dirty && ts - lastDraw > 90) { lastDraw = ts; render(); }
    requestAnimationFrame(frame);
  }
  render();
  requestAnimationFrame(frame);
})();
</script>
