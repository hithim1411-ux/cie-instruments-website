---
import VIShell from '../../components/VIShell.astro';
import { u } from '../../utils/url';
---

<VIShell
  slug="dit-2500" model="DIT-2500"
  pageTitle="DIT-2500 Playground: Try the Insulation Tester Online"
  description="Just for fun: a free interactive playground version of the CIE DIT-2500 digital insulation tester and multimeter. Turn the dial, press TEST, run DAR and PI tests on a virtual motor or cable, and try the multimeter modes."
  h1="DIT-2500, in your browser"
  intro="Turn the dial, press the buttons and watch the display and see what happens. Connect the leads to a virtual motor or cable, run a 10-minute PI test in seconds, then switch to the multimeter side."
  productHref={u('/products/digital-insulation-testers/dit-2500/')}
  extraLink={{ href: u('/tools/pi-dar-calculator/'), label: 'PI and DAR calculator' }}
  ctaBody="The DIT-2500 is made and supported by CIE in Howrah, with test certificate available on request."
>
