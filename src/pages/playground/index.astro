---
import Base from '../../layouts/Base.astro';
import EyebrowLabel from '../../components/EyebrowLabel.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { u } from '../../utils/url';
---

<Base title="Instrument Playground: Play with CIE Testers Online" description="A just-for-fun playground. Twist the dials, crank the handle and press the buttons on playful, beta versions of CIE instruments.">
  <div class="blueprint-bg bg-ink text-white pt-10 pb-12 lg:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="vi-crumbs"><Breadcrumbs crumbs={[{ label: 'Instrument Playground' }]} /></div>
      <EyebrowLabel text="Just for fun" class="mt-5 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-white leading-[1.1] tracking-tight max-w-4xl">Instrument Playground <span class="vi-beta">Beta</span></h1>
      <p class="mt-3 text-muted-dark max-w-2xl text-body-lg">Play with our instruments, and the Vartech range we supply, right in your browser. Twist the dials, crank the handle, press the buttons and see what happens. No sign-up, nothing to install, and nothing to break.</p>
      <p class="vi-disc vi-disc--dark mt-6 max-w-3xl" role="note"><strong>Beta, just for fun.</strong> These are playful beta versions, for illustration only. They are not training tools and not a substitute for the real instruments, which can differ in appearance, display, button behaviour, ranges and readings. Everything is simulated. Always follow the instruction manual.</p>
      <a href={u('/playground/challenges/')} class="vi-hubcard vi-hubcard--wide mt-8">
        <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Games for engineers</span>
        <span class="vi-hubname">Find the fault, and the 10-question quiz</span>
        <span class="vi-hubbody">Six site cases to diagnose from the readings, then a quiz you can send to a colleague to beat. Insulation, earthing, clamp meters and multimeters.</span>
        <span class="vi-hubgo">Take the challenge →</span>
      </a>
      <div class="vi-brand"><img src={u('/logo/cie-logo-transparent.webp')} alt="CIE" height="48" /></div>
      <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={u('/playground/dit-2500/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> Insulation tester + multimeter</span>
          <span class="vi-hubname">DIT-2500</span>
          <span class="vi-hubbody">100, 250, 500, 1000 and 2500 V insulation tests with DAR and PI, plus a True-RMS multimeter. Run a 10-minute test in ten seconds.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/dit-5000/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> Digital insulation tester</span>
          <span class="vi-hubname">DIT-5000</span>
          <span class="vi-hubbody">Up to 5000 V and 200 GΩ. Watch the HV LED, the voltage collapse on a fault, and the effect of the guard lead.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/cie-444/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> Hand-driven insulation tester</span>
          <span class="vi-hubname">CIE/444</span>
          <span class="vi-hubbody">Turn the crank, hold 160 rpm and watch the cross-coil pointer. Choose any of the 27 voltage and range versions.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/det-2000/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> Earth resistance tester</span>
          <span class="vi-hubname">DET-2000</span>
          <span class="vi-hubbody">Plant the spikes, wire four terminals and see the fall-of-potential curve. Measure soil resistivity too.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/dcm-2250-tr/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> True-RMS AC clamp multimeter</span>
          <span class="vi-hubname">DCM 2250 TR</span>
          <span class="vi-hubbody">Clamp a conductor up to 1000 A, beat ghost voltage with Low-Z, and find live cables with NCV.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/dcm-5410-tr/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">Beta</em> True-RMS AC/DC clamp multimeter</span>
          <span class="vi-hubname">DCM 5410 TR</span>
          <span class="vi-hubbody">AC and DC current, zero the Hall offset, capture motor inrush, plus frequency, capacitance and temperature.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/cie-7000/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Transformer oil BDV tester</span>
          <span class="vi-hubname">CIE/7000</span>
          <span class="vi-hubbody">Pour the oil, wait for the bubbles, raise the voltage at 2 kV per second and catch the spark. Wet and dirty oil fail early.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/psi-1/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Phase sequence indicator</span>
          <span class="vi-hubname">PSI-1</span>
          <span class="vi-hubbody">Connect the R, Y and B leads, watch the disc turn, swap two leads and see why a motor would run backwards.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
      </div>
      <div class="vi-brand"><img src={u('/images/vartech/vartech-logo.avif')} alt="Vartech" height="40" /></div>
      <div class="mt-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <a href={u('/playground/ss-5100ds1b/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Vartech 100 MHz digital oscilloscope</span>
          <span class="vi-hubname">SS-5100DS1B</span>
          <span class="vi-hubbody">Trigger, V/div, time/div, probe compensation and the x10 probe mistake. Look at your own voice through the microphone.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/vartech-3005-b/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Vartech linear bench power supply</span>
          <span class="vi-hubname">Vartech 3005 B</span>
          <span class="vi-hubbody">Flip between constant voltage and constant current. Save an LED, light a lamp, charge a battery, short the output.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
        <a href={u('/playground/v-6700-b/')} class="vi-hubcard">
          <span class="vi-hubtag"><em class="vi-hubbeta">New</em> Vartech digital sound level meter</span>
          <span class="vi-hubname">V 6700 B</span>
          <span class="vi-hubbody">Noise scenes or your own microphone, with real A-weighting, Fast and Slow response, Max hold and the 85 dB line.</span>
          <span class="vi-hubgo">Play with it →</span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  .vi-crumbs .text-ink { color: #fff; }
  .vi-beta { display: inline-block; vertical-align: middle; margin-left: .4rem; padding: .2rem .6rem; font-size: .8rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #fbbf24; background: rgba(245,158,11,.16); border: 1px solid rgba(245,158,11,.5); border-radius: 999px; }
  .vi-disc--dark { padding: .9rem 1.1rem; font-size: .9rem; line-height: 1.55; color: #fde7b0; background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.4); border-radius: .75rem; }
  .vi-disc--dark strong { color: #fbbf24; }
  .vi-hubbeta { font-style: normal; margin-right: .4rem; padding: .1rem .45rem; border-radius: 999px; color: #fbbf24; border: 1px solid rgba(245,158,11,.5); }
  .vi-hubcard { display: flex; flex-direction: column; gap: .4rem; padding: 1.6rem; border-radius: 1.1rem; color: #fff; background: rgba(12,16,24,.94); border: 1px solid rgba(255,255,255,.1); transition: transform .3s var(--ease-premium), border-color .25s; }
  .vi-hubcard--wide { border-color: rgba(224,37,46,.5); background: linear-gradient(120deg, rgba(224,37,46,.16), rgba(12,16,24,.94) 60%); }
  .vi-hubcard:hover { transform: translateY(-4px); border-color: var(--color-red); }
  .vi-brand { display: inline-flex; margin-top: 2.6rem; padding: .6rem 1.1rem; background: #fff; border-radius: .8rem; }
  .vi-brand img { height: 2.6rem; width: auto; object-fit: contain; }
  .vi-hubh { margin-top: 2.6rem; font-size: 1.6rem; font-weight: 800; color: #fff; }
  .vi-hubp { margin-top: .3rem; color: #a3adb8; }
  .vi-hubtag { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .16em; text-transform: uppercase; color: #7b8794; }
  .vi-hubname { font-size: 1.5rem; font-weight: 800; }
  .vi-hubbody { color: #a3adb8; line-height: 1.55; font-size: .95rem; }
  .vi-hubgo { margin-top: .8rem; font-weight: 600; color: #FF5A62; }
</style>
