---
import Base from '../../layouts/Base.astro';
import { u } from '../../utils/url';
import Icon from '../../components/Icon.astro';
import posts from '../../data/blog.json';

const sorted = [...posts].sort((a, b) => b.publishDate.localeCompare(a.publishDate));

const catBar: Record<string, string> = {
  'Guides':       'bg-violet-500',
  'How-To':       'bg-blue-500',
  'Physics':      'bg-amber-500',
  'Buying Guide': 'bg-emerald-500',
};
const catChip: Record<string, string> = {
  'Guides':       'text-violet-700 bg-violet-50 border-violet-200',
  'How-To':       'text-blue-700 bg-blue-50 border-blue-200',
  'Physics':      'text-amber-700 bg-amber-50 border-amber-200',
  'Buying Guide': 'text-emerald-700 bg-emerald-50 border-emerald-200',
};

// ── The Library: subject shelves ─────────────────────────────────────────
// Groups all posts into a fixed set of subject shelves (like a library's
// card catalog) instead of one flat, undifferentiated list. Order here is
// the display order - fundamentals first, then instrument families,
// broadest first.
interface Shelf { id: string; label: string; blurb: string; icon: string }
const SHELVES: Shelf[] = [
  { id: 'physics',           label: 'Physics & Electrical Fundamentals',   blurb: 'The theory behind every reading - Ohm’s Law, AC/DC, ratings and specs.', icon: 'zap' },
  { id: 'multimeters',       label: 'Multimeters',                         blurb: 'Choosing, using and understanding the most essential bench and field tool.', icon: 'gauge' },
  { id: 'clamp-meters',      label: 'Clamp Meters',                        blurb: 'Current measurement without breaking a circuit, including leakage testing.', icon: 'circle-dot' },
  { id: 'insulation-earthing', label: 'Insulation, Earthing & Motor Testing', blurb: 'Meggers, earth testers and the tests that catch a fault before it does damage.', icon: 'shield-check' },
  { id: 'scopes-signal',     label: 'Oscilloscopes, Signal & Component Testing', blurb: 'Waveforms, function generators and LCR meters for signal-level work.', icon: 'activity' },
  { id: 'power-supplies',    label: 'DC Power Supplies & Electronic Loads', blurb: 'Linear vs SMPS, programmable control, and bench power selection.', icon: 'plug' },
  { id: 'calibration',       label: 'Calibration & Process Instruments',   blurb: '4-20 mA loops, temperature calibration and calibration-interval practice.', icon: 'settings' },
  { id: 'environmental',     label: 'Environmental & Safety Instruments',  blurb: 'Light, sound, airflow, temperature and humidity measurement.', icon: 'wind' },
  { id: 'power-quality',     label: 'Power Quality & Circuit Diagnostics', blurb: 'Phase sequence, harmonics, power factor and field fault-finding.', icon: 'waves' },
  { id: 'relay-hv',          label: 'Relay & High-Voltage Testing',        blurb: 'Protection relays, dielectric withstand and HV safety fundamentals.', icon: 'flask' },
  { id: 'bench-tools',       label: 'Bench & Repair Tools',                blurb: 'Soldering, desoldering, fuses and batteries - the rest of the toolkit.', icon: 'wrench' },
];

const byDateDesc = (a: any, b: any) => b.publishDate.localeCompare(a.publishDate);
const shelvesWithPosts = SHELVES.map(shelf => ({
  ...shelf,
  posts: sorted.filter(p => (p as any).shelf === shelf.id).sort(byDateDesc),
})).filter(s => s.posts.length > 0);

const PREVIEW_COUNT = 4;
---

<Base
  title="Insights - Technical Resources"
  description="Technical guides, measurement principles, and instrument selection resources from CIE Instruments - established 1963."
>

  <!-- ════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════ -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-18">
      <div class="flex items-center gap-3 mb-5">
        <span class="w-8 h-0.5 bg-red"></span>
        <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-red">Insights</p>
      </div>
      <h1 class="text-5xl sm:text-6xl font-bold text-ink leading-none tracking-tight mb-5">
        Engineering<br/>Knowledge.
      </h1>
      <p class="text-muted text-base leading-relaxed max-w-xl">
        Technical articles on measurement instruments, testing methodology, and the physics behind every reading - written for engineers and electricians.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       FEATURED - dark navy
  ═══════════════════════════════════════════════════════════ -->
  <section class="bg-ink">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <p class="text-[10px] font-mono uppercase tracking-[0.18em] text-muted mb-8">Latest Article</p>
      <a href={u(`/blog/${sorted[0].slug}/`)} class="group block">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
          <div class="max-w-2xl">
            <span class={`inline-block text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded border mb-6 ${catChip[sorted[0].category] ?? 'text-gray-300 bg-white/10 border-white/20'}`}>
              {sorted[0].category}
            </span>
            <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight mb-5 group-hover:text-red transition-colors">
              {sorted[0].title}
            </h2>
            <p class="text-muted text-base leading-relaxed">{sorted[0].excerpt}</p>
          </div>
          <div class="shrink-0 flex flex-col items-start lg:items-end gap-4">
            <div class="text-muted font-mono text-xs">
              <time datetime={sorted[0].publishDate}>
                {new Date(sorted[0].publishDate).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })}
              </time>
              <span class="mx-2">·</span>
              <span>{sorted[0].readTime}</span>
            </div>
            <span class="btn-primary group-hover:bg-red-dark">
              Read Article
              <Icon name="arrow" class="w-4 h-4 shrink-0" />
            </span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       PODCAST - Spotify embed
  ═══════════════════════════════════════════════════════════ -->
  <section class="bg-white border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-col lg:flex-row lg:items-center gap-10">

        <!-- Left: text -->
        <div class="lg:w-80 shrink-0">
          <div class="flex items-center gap-3 mb-5">
            <span class="w-8 h-0.5 bg-[#1DB954]"></span>
            <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#1DB954]">Podcast</p>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink leading-snug mb-4">
            We're on<br/>Spotify.
          </h2>
          <p class="text-muted text-sm leading-relaxed mb-6">
            Deep-dives on measurement instruments, testing methodology, and electrical engineering - for engineers and electricians who want more than just a manual.
          </p>
          <a
            href="https://open.spotify.com/show/033DkaSuC0aDSc2X2TApyV"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 bg-[#1DB954] hover:bg-[#17a349] text-white text-sm font-semibold rounded-full transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
            Follow on Spotify
          </a>
        </div>

        <!-- Right: embed -->
        <div class="flex-1 min-w-0">
          <iframe
            src="https://open.spotify.com/embed/show/033DkaSuC0aDSc2X2TApyV?utm_source=generator"
            width="100%"
            height="352"
            frameborder="0"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            class="rounded-xl w-full"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════
       THE LIBRARY - subject shelves, search, and per-shelf browsing
  ═══════════════════════════════════════════════════════════ -->
  <section class="bg-gray-50 border-b border-gray-200" id="library">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
        <div>
          <p class="text-[10px] font-mono uppercase tracking-[0.18em] text-muted mb-2">The Library</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-ink leading-tight">Browse by subject.</h2>
        </div>
        <div class="relative w-full md:w-80 shrink-0">
          <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
          <input
            id="lib-search"
            type="search"
            placeholder="Search all articles..."
            aria-label="Search articles"
            class="w-full pl-10 pr-4 py-2.5 text-sm rounded-full border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-ink/10 focus:border-ink transition-colors"
          />
        </div>
      </div>

      <!-- Shelf directory (pill nav) -->
      <div id="lib-nav" class="flex flex-wrap gap-2 mb-10">
        <button data-shelf-btn="all" aria-pressed="true"
          class="lib-pill is-active inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full border transition-colors">
          All Topics <span class="lib-pill-count opacity-60">({sorted.length})</span>
        </button>
        {shelvesWithPosts.map(shelf => (
          <button data-shelf-btn={shelf.id} aria-pressed="false"
            class="lib-pill inline-flex items-center gap-1.5 text-xs font-semibold px-3.5 py-2 rounded-full border transition-colors">
            <Icon name={shelf.icon as any} class="w-3.5 h-3.5 shrink-0" />
            {shelf.label} <span class="lib-pill-count opacity-60">({shelf.posts.length})</span>
          </button>
        ))}
      </div>

      <!-- Search results summary (shown only while searching) -->
      <p id="lib-search-summary" class="hidden text-sm text-muted mb-6"></p>

      <!-- No-results state -->
      <div id="lib-empty" class="hidden text-center py-16">
        <p class="text-muted text-sm">No articles match your search. Try a different term.</p>
      </div>

      <!-- Shelves -->
      <div id="lib-shelves" class="space-y-14">
        {shelvesWithPosts.map(shelf => (
          <div class="lib-shelf" data-shelf-section={shelf.id}>
            <div class="flex items-start gap-3 mb-5 pb-4 border-b border-gray-200">
              <div class="w-9 h-9 rounded-lg bg-white border border-gray-200 flex items-center justify-center shrink-0 text-ink">
                <Icon name={shelf.icon as any} class="w-4.5 h-4.5" />
              </div>
              <div class="min-w-0">
                <h3 class="text-base font-bold text-ink leading-snug">{shelf.label}</h3>
                <p class="text-xs text-muted leading-relaxed mt-0.5">{shelf.blurb}</p>
              </div>
            </div>

            <div class="lib-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {shelf.posts.map((post, i) => (
                <a
                  href={u(`/blog/${post.slug}/`)}
                  class:list={['lib-card', 'card', 'card-interactive', 'group', 'overflow-hidden', 'flex', 'flex-col', { 'lib-card--overflow': i >= PREVIEW_COUNT }]}
                  data-search={`${post.title} ${post.excerpt}`.toLowerCase()}
                >
                  <div class={`h-1 w-full ${catBar[post.category] ?? 'bg-gray-300'}`}></div>
                  <div class="p-5 flex flex-col flex-1">
                    <span class={`inline-block self-start text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded border mb-3 ${catChip[post.category] ?? 'text-gray-600 bg-gray-50 border-gray-200'}`}>
                      {post.category}
                    </span>
                    <h4 class="text-sm font-bold text-ink group-hover:text-red transition-colors leading-snug mb-2 flex-1">
                      {post.title}
                    </h4>
                    <p class="text-xs text-muted leading-relaxed mb-4 line-clamp-2">{post.excerpt}</p>
                    <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                      <div class="flex items-center gap-2 text-[10px] text-gray-400 font-mono">
                        <time datetime={post.publishDate}>
                          {new Date(post.publishDate).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })}
                        </time>
                        <span>·</span>
                        <span>{post.readTime}</span>
                      </div>
                      <span class="link-arrow text-xs text-red">
                        Read <Icon name="arrow" class="w-3.5 h-3.5" />
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>

            {shelf.posts.length > PREVIEW_COUNT && (
              <button
                data-shelf-viewall={shelf.id}
                class="lib-viewall mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-red hover:text-red-dark transition-colors"
              >
                View all {shelf.posts.length} articles in {shelf.label}
                <Icon name="arrow" class="w-3.5 h-3.5" />
              </button>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .lib-pill { color: #6b7280; background: #fff; border-color: #e5e7eb; }
    .lib-pill:hover { border-color: #111827; color: #111827; }
    .lib-pill.is-active { background: #111827; border-color: #111827; color: #fff; }
    .lib-shelf[data-hidden] { display: none; }
    .lib-card[data-hidden] { display: none; }
    .lib-card--overflow.is-capped { display: none; }
  </style>

  <script>
  {
    const searchInput = document.getElementById('lib-search') as HTMLInputElement | null;
    const navButtons  = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-shelf-btn]'));
    const shelves     = Array.from(document.querySelectorAll<HTMLElement>('[data-shelf-section]'));
    const emptyState  = document.getElementById('lib-empty');
    const searchSummary = document.getElementById('lib-search-summary');
    const shelvesWrap = document.getElementById('lib-shelves');

    let activeShelf = 'all';

    function setActivePill() {
      navButtons.forEach(btn => {
        const isActive = btn.dataset.shelfBtn === activeShelf;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    function applyFilters() {
      const query = (searchInput?.value ?? '').trim().toLowerCase();
      const searching = query.length > 0;
      let totalVisible = 0;

      shelves.forEach(shelf => {
        const shelfId = shelf.dataset.shelfSection;
        const matchesShelf = activeShelf === 'all' || activeShelf === shelfId;
        const cards = Array.from(shelf.querySelectorAll<HTMLElement>('.lib-card'));
        const viewAllBtn = shelf.querySelector<HTMLElement>('.lib-viewall');
        const isSingleShelfView = activeShelf !== 'all';

        let visibleInShelf = 0;
        cards.forEach(card => {
          const text = card.dataset.search ?? '';
          const matchesSearch = !searching || text.includes(query);
          const show = matchesShelf && matchesSearch;
          card.toggleAttribute('data-hidden', !show);
          // Cap preview cards to 4 only in the default "All Topics" browse view
          const isOverflowCard = card.classList.contains('lib-card--overflow');
          card.classList.toggle('is-capped', show && !searching && !isSingleShelfView && isOverflowCard);
          if (show) visibleInShelf++;
        });

        const shelfHasVisible = matchesShelf && visibleInShelf > 0;
        shelf.toggleAttribute('data-hidden', !shelfHasVisible);
        if (viewAllBtn) {
          viewAllBtn.style.display = (shelfHasVisible && !searching && !isSingleShelfView) ? '' : 'none';
        }
        if (shelfHasVisible) totalVisible++;
      });

      if (searching) {
        const count = shelves.reduce((sum, shelf) => {
          if (shelf.hasAttribute('data-hidden')) return sum;
          return sum + shelf.querySelectorAll('.lib-card:not([data-hidden])').length;
        }, 0);
        if (searchSummary) {
          searchSummary.textContent = `${count} article${count === 1 ? '' : 's'} match "${query}"`;
          searchSummary.classList.remove('hidden');
        }
      } else if (searchSummary) {
        searchSummary.classList.add('hidden');
      }

      const nothingVisible = totalVisible === 0;
      emptyState?.classList.toggle('hidden', !nothingVisible);
      shelvesWrap?.classList.toggle('hidden', nothingVisible);
    }

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeShelf = btn.dataset.shelfBtn ?? 'all';
        setActivePill();
        // A shelf pill browses that subject specifically - clear any active
        // search so it doesn't silently narrow the shelf to a stale query.
        if (searchInput) searchInput.value = '';
        applyFilters();
        if (activeShelf !== 'all') {
          document.getElementById('library')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-shelf-viewall]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeShelf = btn.dataset.shelfViewall ?? 'all';
        setActivePill();
        if (searchInput) searchInput.value = '';
        applyFilters();
      });
    });

    let debounce: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      // Search is global - typing a query resets any single-shelf selection
      // back to "All Topics" so results aren't silently scoped to a shelf
      // the user has forgotten they filtered.
      if (searchInput.value.trim().length > 0 && activeShelf !== 'all') {
        activeShelf = 'all';
        setActivePill();
      }
      clearTimeout(debounce);
      debounce = setTimeout(applyFilters, 80);
    });

    applyFilters();
  }
  </script>

  <!-- ════════════════════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════════════════════ -->
  <section class="bg-white border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="rounded-2xl bg-red overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-center gap-8 px-10 py-10">
          <div class="flex-1">
            <p class="text-red-200 text-[11px] font-mono uppercase tracking-[0.18em] mb-3">Cambridge Instruments &amp; Engg. Co. · Est. 1963</p>
            <p class="text-white font-bold text-2xl md:text-3xl leading-snug mb-3">Looking for an instrument,<br/>not just an answer?</p>
            <p class="text-red-100 text-sm leading-relaxed max-w-md">Multimeters, clamp meters, insulation testers, earth testers - manufactured in Howrah, India. Pan-India supply.</p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href={u('/products/')} class="btn-primary btn-primary--inverse">
              Browse Products
            </a>
            <a href={u('/contact/')} class="btn-secondary text-white">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
