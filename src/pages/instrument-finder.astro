---
import Base from '../layouts/Base.astro';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { u } from '../utils/url';
import categories from '../data/categories.json';
import products from '../data/products.json';
import industries from '../data/industries.json';
import vartechMultimeters from '../data/vartech-multimeters.json';
import vartechClampMeters from '../data/vartech-clamp-meters.json';
import vartechOscilloscopes from '../data/vartech-oscilloscopes.json';
import vartechFunctionGenerators from '../data/vartech-function-generators.json';
import vartechLcrMeters from '../data/vartech-lcr-meters.json';
import vartechDcLoads from '../data/vartech-dc-loads.json';
import vartechSoundLevelMeters from '../data/vartech-sound-level-meters.json';
import vartechAnemometers from '../data/vartech-anemometers.json';
import vartechCalibrators from '../data/vartech-calibrators.json';
import vartechLuxMeters from '../data/vartech-lux-meters.json';
import vartechThermometers from '../data/vartech-thermometers.json';
import vartechDcPowerSupplies from '../data/vartech-dc-power-supplies.json';
import site from '../data/site.json';

const vartechDataMap: Record<string, any[]> = {
  'vartech-multimeters':          vartechMultimeters,
  'vartech-clamp-meters':         vartechClampMeters,
  'vartech-oscilloscopes':        vartechOscilloscopes,
  'vartech-function-generators':  vartechFunctionGenerators,
  'vartech-lcr-meters':           vartechLcrMeters,
  'vartech-dc-loads':             vartechDcLoads,
  'vartech-sound-level-meters':   vartechSoundLevelMeters,
  'vartech-anemometers':          vartechAnemometers,
  'vartech-calibrators':          vartechCalibrators,
  'vartech-lux-meters':           vartechLuxMeters,
  'vartech-thermometers':         vartechThermometers,
  'vartech-dc-power-supplies':    vartechDcPowerSupplies,
};

// Normalised product list (CIE + Vartech) — a flat, uniform shape the
// client-side finder can filter without needing to know which brand a
// product belongs to.
const allProducts = [
  ...products.map((p: any) => ({
    id: p.id, model: p.model, name: p.name, tagline: p.tagline,
    categoryId: p.categoryId, featured: !!p.featured,
    image: p.image ?? null,
    specs: (p.specs ?? []).map((s: any) => `${s.label} ${s.value}`).join(' | '),
  })),
  ...Object.entries(vartechDataMap).flatMap(([catId, items]) => {
    const brandSlug = catId.replace('vartech-', '');
    return items.map((p: any) => {
      const imgFile = p.images?.[0] ?? `${p.id}.webp`;
      return {
        id: p.id, model: p.model, name: p.name, tagline: p.tagline,
        categoryId: catId, featured: false,
        image: `vartech/${brandSlug}/${imgFile}`,
        specs: (p.specs ?? []).map((s: any) => `${s.label} ${s.value}`).join(' | '),
      };
    });
  }),
];

// Task groups — a small taxonomy built from the site's own existing
// category names/eyebrows, not an invented classification scheme.
const taskGroups = [
  {
    id: 'insulation-earthing', label: 'Insulation & Earth Resistance', icon: 'zap',
    description: 'Testing cable, motor, transformer insulation or earth/soil resistance',
    categoryIds: ['insulation-testers-hand', 'multirange-insulation-hand', 'motor-operated-insulation', 'multirange-motorised-insulation', 'compact-insulation-testers', 'digital-insulation-testers', 'earth-tester', 'digital-earth-micro-ohm'],
  },
  {
    id: 'electrical-measurement', label: 'General Electrical Measurement', icon: 'gauge',
    description: 'Voltage, current, resistance — clamp meters and multimeters',
    categoryIds: ['multimeters', 'clamp-meters', 'vartech-multimeters', 'vartech-clamp-meters'],
  },
  {
    id: 'hv-protection', label: 'HV & Protection Testing', icon: 'shield-check',
    description: 'Dielectric withstand, phase sequence, and relay commissioning',
    categoryIds: ['hv-phase-sequence', 'phase-sequence-indicators', 'relay-test-sets'],
  },
  {
    id: 'oil-quality', label: 'Transformer Oil Quality', icon: 'droplet',
    description: 'Breakdown voltage (BDV) testing for transformer oil',
    categoryIds: ['oil-test-sets'],
  },
  {
    id: 'electronics-bench', label: 'Electronics Bench Testing', icon: 'activity',
    description: 'Oscilloscopes, function generators, LCR meters, DC loads & supplies',
    categoryIds: ['vartech-oscilloscopes', 'vartech-function-generators', 'vartech-lcr-meters', 'vartech-dc-loads', 'vartech-dc-power-supplies'],
  },
  {
    id: 'environmental', label: 'Environmental Measurement', icon: 'wind',
    description: 'Sound level, air velocity, light, temperature & process calibration',
    categoryIds: ['vartech-sound-level-meters', 'vartech-anemometers', 'vartech-lux-meters', 'vartech-thermometers', 'vartech-calibrators'],
  },
];

const industryOptions = industries.map(i => ({ slug: i.slug, name: i.name, relatedCategoryIds: i.relatedCategoryIds }));

const rangePresets = ['Up to 500 V', '500 V – 5 kV', '5 kV and above', 'Not applicable / unsure'];
---

<Base
  title="Instrument Finder — Find the Right Test Instrument"
  description="Answer a few quick questions and find the right CIE or Vartech test instrument for your application — insulation testing, earth resistance, oscilloscopes, and more."
>
  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: 'Instrument Finder' }]} />
      <EyebrowLabel text="Tools · Instrument Finder" class="mt-4 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Find the Right Instrument</h1>
      <p class="mt-2 text-muted max-w-2xl">
        Answer three quick questions and we'll show you which CIE or Vartech instruments fit your requirement.
      </p>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Progress -->
      <div class="flex items-center gap-2 mb-10" id="if-progress">
        {[1, 2, 3].map(n => (
          <div class="flex items-center gap-2 flex-1" data-progress-step={n}>
            <div class="w-8 h-8 rounded-full border-2 border-border flex items-center justify-center text-xs font-bold text-muted shrink-0" data-progress-dot={n}>{n}</div>
            {n < 3 && <div class="flex-1 h-0.5 bg-border" data-progress-line={n}></div>}
          </div>
        ))}
      </div>

      <!-- Step 1: task group -->
      <div id="if-step-1" data-if-step="1">
        <h2 class="text-lg font-bold text-ink mb-1">What are you testing?</h2>
        <p class="text-sm text-muted mb-6">Choose the closest match — you can refine after.</p>
        <div class="grid sm:grid-cols-2 gap-4" id="if-groups">
          {taskGroups.map(g => (
            <button type="button" class="if-group-btn text-left card card-interactive p-5 flex items-start gap-4" data-group={g.id}>
              <div class="w-10 h-10 bg-cloud rounded-lg flex items-center justify-center shrink-0">
                <Icon name={g.icon as any} class="w-5 h-5 text-ink" />
              </div>
              <div>
                <p class="font-bold text-ink text-sm mb-1">{g.label}</p>
                <p class="text-xs text-muted leading-relaxed">{g.description}</p>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Step 2: industry -->
      <div id="if-step-2" data-if-step="2" class="hidden">
        <h2 class="text-lg font-bold text-ink mb-1">Which industry or use case?</h2>
        <p class="text-sm text-muted mb-6">Optional — helps us narrow the list further.</p>
        <div class="flex flex-wrap gap-3" id="if-industries">
          {industryOptions.map(ind => (
            <button type="button" class="if-industry-btn px-4 py-2.5 rounded-full border border-border text-sm text-ink hover:border-red hover:text-red transition-colors" data-industry={ind.slug}>
              {ind.name}
            </button>
          ))}
          <button type="button" class="if-industry-btn px-4 py-2.5 rounded-full border border-border text-sm text-muted hover:border-red hover:text-red transition-colors" data-industry="">
            Not sure / skip
          </button>
        </div>
        <button type="button" class="mt-6 text-sm font-semibold text-muted hover:text-ink" data-if-back="1">&larr; Back</button>
      </div>

      <!-- Step 3: range -->
      <div id="if-step-3" data-if-step="3" class="hidden">
        <h2 class="text-lg font-bold text-ink mb-1">Rated voltage or range?</h2>
        <p class="text-sm text-muted mb-6">Optional — we'll show all matches if you're not sure.</p>
        <div class="flex flex-wrap gap-3" id="if-ranges">
          {rangePresets.map(r => (
            <button type="button" class="if-range-btn px-4 py-2.5 rounded-full border border-border text-sm text-ink hover:border-red hover:text-red transition-colors" data-range={r}>
              {r}
            </button>
          ))}
        </div>
        <button type="button" class="mt-6 text-sm font-semibold text-muted hover:text-ink" data-if-back="2">&larr; Back</button>
      </div>

      <!-- Results -->
      <div id="if-results" class="hidden">
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
          <div>
            <h2 class="text-lg font-bold text-ink" id="if-results-heading">Recommended Instruments</h2>
            <p class="text-sm text-muted" id="if-results-count"></p>
          </div>
          <button type="button" class="text-sm font-semibold text-red hover:underline" id="if-restart">Start Over</button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="if-results-grid"></div>
      </div>

    </div>
  </section>

  <template id="if-card-template">
    <article class="card card-interactive overflow-hidden flex flex-col">
      <div class="bg-cloud h-48 flex items-center justify-center relative overflow-hidden">
        <img class="if-card-img object-contain h-36 w-auto" loading="lazy" onerror="this.style.display='none'" />
      </div>
      <div class="p-5 flex flex-col flex-1">
        <p class="model-code text-xs mb-1.5 if-card-model"></p>
        <h3 class="font-bold text-ink text-base mb-2 leading-snug tracking-tight if-card-name"></h3>
        <p class="text-sm text-muted mb-4 flex-1 line-clamp-2 leading-relaxed if-card-tagline"></p>
        <div class="flex flex-col gap-2 mt-auto">
          <a class="btn-primary btn-primary--sm if-card-view">View Specifications</a>
          <a class="btn-secondary btn-secondary--sm text-ink if-card-quote" href="#">Request a Quote</a>
        </div>
      </div>
    </article>
  </template>

  <script define:vars={{ allProducts, taskGroups, industryOptions, whatsapp: site.whatsapp, base: u('/') }}>
    const state = { group: null, industry: null, range: null };

    const dealerIdOverrides = { 'v-8222h-lcr': 'v-8222h', 'ss-5150ds1bfg': 'ss-5150ds1b-fg' };

    function productHref(p) {
      if (p.categoryId.startsWith('vartech-')) {
        const slug = p.categoryId.replace('vartech-', '');
        const id = dealerIdOverrides[p.id] ?? p.id;
        return `${base}authorised-dealership/${slug}/${id}/`;
      }
      return `${base}products/${p.categoryId}/${p.id}/`;
    }

    function imgSrc(p) {
      if (!p.image) return `${base}images/products/${p.id}.webp`;
      return p.image.startsWith('vartech/') ? `${base}images/${p.image}` : `${base}images/products/${p.image}`;
    }

    function showStep(n) {
      document.querySelectorAll('[data-if-step]').forEach(el => {
        el.classList.toggle('hidden', el.getAttribute('data-if-step') !== String(n));
      });
      document.getElementById('if-results').classList.add('hidden');
      document.querySelectorAll('[data-progress-dot]').forEach(dot => {
        const step = Number(dot.getAttribute('data-progress-dot'));
        dot.classList.toggle('bg-red', step <= n);
        dot.classList.toggle('border-red', step <= n);
        dot.classList.toggle('text-white', step <= n);
        dot.classList.toggle('text-muted', step > n);
      });
      document.querySelectorAll('[data-progress-line]').forEach(line => {
        const step = Number(line.getAttribute('data-progress-line'));
        line.classList.toggle('bg-red', step < n);
        line.classList.toggle('bg-border', step >= n);
      });
    }

    document.querySelectorAll('.if-group-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.group = btn.getAttribute('data-group');
        showStep(2);
      });
    });

    document.querySelectorAll('.if-industry-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.industry = btn.getAttribute('data-industry') || null;
        showStep(3);
      });
    });

    document.querySelectorAll('.if-range-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.range = btn.getAttribute('data-range');
        renderResults();
      });
    });

    document.querySelectorAll('[data-if-back]').forEach(btn => {
      btn.addEventListener('click', () => showStep(Number(btn.getAttribute('data-if-back'))));
    });

    document.getElementById('if-restart').addEventListener('click', () => {
      state.group = null; state.industry = null; state.range = null;
      showStep(1);
    });

    function renderResults() {
      const group = taskGroups.find(g => g.id === state.group);
      if (!group) return;

      let categoryIds = group.categoryIds;

      if (state.industry) {
        const ind = industryOptions.find(i => i.slug === state.industry);
        if (ind) {
          const narrowed = categoryIds.filter(c => (ind.relatedCategoryIds || []).includes(c));
          if (narrowed.length > 0) categoryIds = narrowed;
        }
      }

      let matches = allProducts.filter(p => categoryIds.includes(p.categoryId));

      if (state.range && state.range !== 'Not applicable / unsure') {
        const needle = state.range.toLowerCase().replace(/[^a-z0-9]/g, '');
        const narrowed = matches.filter(p => {
          const specText = (p.specs || '').toLowerCase().replace(/[^a-z0-9]/g, '');
          if (state.range.startsWith('Up to 500')) return /\b[1-4]?\d\dv\b/.test(p.specs.toLowerCase()) || specText.includes('500v');
          if (state.range.startsWith('500 V')) return specText.includes('kv') || /[1-4]\d{3}v/.test(p.specs.toLowerCase());
          if (state.range.startsWith('5 kV')) return specText.includes('kv') && /([5-9]|\d{2,})kv/.test(specText);
          return true;
        });
        if (narrowed.length > 0) matches = narrowed;
      }

      const grid = document.getElementById('if-results-grid');
      const tpl = document.getElementById('if-card-template');
      grid.innerHTML = '';

      matches.forEach(p => {
        const node = tpl.content.cloneNode(true);
        const img = node.querySelector('.if-card-img');
        img.src = imgSrc(p);
        img.alt = `${p.model} — ${p.name}`;
        node.querySelector('.if-card-model').textContent = p.model;
        node.querySelector('.if-card-name').textContent = p.name;
        node.querySelector('.if-card-tagline').textContent = p.tagline || '';
        node.querySelector('.if-card-view').href = productHref(p);
        const quoteLink = node.querySelector('.if-card-quote');
        quoteLink.href = `${base}contact/?product=${encodeURIComponent(p.model)}`;
        grid.appendChild(node);
      });

      document.getElementById('if-results-heading').textContent = matches.length > 0
        ? `Recommended: ${group.label}`
        : 'No exact matches — here is the full category';
      document.getElementById('if-results-count').textContent = `${matches.length} instrument${matches.length === 1 ? '' : 's'}`;

      document.querySelectorAll('[data-if-step]').forEach(el => el.classList.add('hidden'));
      document.getElementById('if-results').classList.remove('hidden');
    }

    showStep(1);
  </script>
</Base>
