---
import Base from '../layouts/Base.astro';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';

const productParam = Astro.url.searchParams?.get('product') ?? '';
---

<Base
  title="Contact & Get a Quote — Insulation Tester Supplier, Kolkata & Howrah"
  description="Contact CIE — Cambridge Instruments & Engg. Co., Howrah, West Bengal. Supplier of insulation testers, earth testers, relay test sets, oil BDV testers, HV test sets across India. Call, WhatsApp, or email for a quote."
>
  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: 'Contact' }]} />
      <EyebrowLabel text="Contact · Get a Quote" class="mt-4 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Contact Us</h1>
      <p class="mt-2 text-muted max-w-2xl">
        Enquire about any instrument in the CIE range. We respond within one business day.
        WhatsApp is the fastest channel for a quick query.
      </p>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- Contact details -->
        <div class="space-y-8">
          <!-- WhatsApp highlight -->
          <div class="bg-cloud rounded-xl border border-border p-6">
            <h2 class="font-bold text-ink mb-3">Fastest: WhatsApp</h2>
            <p class="text-sm text-muted mb-4">Send your requirement directly. We respond promptly.</p>
            <a
              href={`https://wa.me/${site.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full"
            >
              <Icon name="message-circle" class="w-4 h-4 shrink-0" />
              Chat on WhatsApp
            </a>
          </div>

          <!-- Addresses -->
          {site.addresses.map(addr => (
            <div>
              <h3 class="text-xs font-mono font-semibold text-red uppercase tracking-widest mb-2">{addr.type}</h3>
              <address class="not-italic text-sm text-muted leading-relaxed">
                {addr.lines.map(line => <span class="block">{line}</span>)}
              </address>
            </div>
          ))}

          <!-- Phone -->
          <div>
            <h3 class="text-xs font-mono font-semibold text-red uppercase tracking-widest mb-2">Phone</h3>
            {site.phones.map(p => (
              <p class="text-sm text-muted">
                <span class="text-muted-dark text-xs">{p.label}: </span>
                <a href={`tel:${p.number.replace(/\s/g,'')}`} class="hover:text-ink transition-colors">{p.number}</a>
              </p>
            ))}
          </div>

          <!-- Email -->
          <div>
            <h3 class="text-xs font-mono font-semibold text-red uppercase tracking-widest mb-2">Email</h3>
            <a href={`mailto:${site.email}`} class="text-sm text-muted hover:text-ink transition-colors">{site.email}</a>
          </div>
        </div>

        <!-- Form -->
        <div class="lg:col-span-2">
          <EnquiryForm productName={productParam} />
        </div>
      </div>
    </div>
  </section>

  <!-- Maps -->
  <section class="bg-cloud border-t border-border section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-ink mb-8">Find Us</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Works -->
        <div>
          <h3 class="text-xs font-mono font-semibold text-red uppercase tracking-widest mb-3">{site.addresses[1].type}</h3>
          <p class="text-sm text-muted mb-3">{site.addresses[1].lines.join(', ')}</p>
          <div class="rounded-xl overflow-hidden border border-border shadow-sm">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3683.6605973384326!2d88.3416385!3d22.591794!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a02774866c27a73%3A0xcc659cd607466a20!2sCambridge%20Instruments%20and%20Engg.%20Co.%20Hwh-works%20(Electrical%20Instruments%20Supplier%2C%20Wholesaler)!5e0!3m2!1sen!2sin!4v1782102612176!5m2!1sen!2sin"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Map — Works"
            ></iframe>
          </div>
        </div>
        <!-- Office -->
        <div>
          <h3 class="text-xs font-mono font-semibold text-red uppercase tracking-widest mb-3">{site.addresses[0].type}</h3>
          <p class="text-sm text-muted mb-3">{site.addresses[0].lines.join(', ')}</p>
          <div class="rounded-xl overflow-hidden border border-border shadow-sm">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3684.100644660059!2d88.35304239999999!3d22.575338799999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a0277a5586e1203%3A0x831b343aea564749!2sCambridge%20Instruments%20%26%20Engg.%20Co.%20-%20Test%20%26%20Measuring%20Instrument%20Manufacturer%20and%20Supplier!5e0!3m2!1sen!2sin!4v1782102579825!5m2!1sen!2sin"
              width="100%"
              height="300"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Map — Office"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
