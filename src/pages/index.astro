<script>
{
  const groups  = document.querySelectorAll<HTMLElement>('.hero-group');
  const dots    = document.querySelectorAll<HTMLButtonElement>('.hero-group-dot');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-hero-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-hero-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current = 0;
  let timer: ReturnType<typeof setInterval>;
  let isTransitioning = false;
  const FADE_MS = 300;

  // Sequential fade: fade the outgoing group fully OUT first, only then bring
  // the incoming group into flow and fade it IN. The old version toggled both
  // groups' opacity in the same tick, so for the whole 700ms transition both
  // sets of product photos (and their labels) sat opacity-0..1 stacked in the
  // exact same spot — a literal double exposure. Guarding with isTransitioning
  // also stops rapid clicks/auto-timer overlap from starting a second
  // transition before the first one has fully settled.
  function goTo(idx: number) {
    if (idx === current || isTransitioning) return;
    isTransitioning = true;

    const outgoing = groups[current];
    const incoming = groups[idx];

    // Phase 1 — fade OUT only. Incoming stays opacity-0/absolute/inert the
    // whole time, so nothing from the next slide is visible yet.
    outgoing.classList.replace('opacity-100', 'opacity-0');
    outgoing.querySelectorAll('a').forEach(a => (a as HTMLAnchorElement).tabIndex = -1);
    dots[current].className = 'hero-group-dot transition-all rounded-full w-1.5 h-1.5 bg-white/20';

    window.setTimeout(() => {
      // Outgoing has now fully reached opacity 0 — safe to pull it out of
      // flow before the incoming group takes that layout space.
      outgoing.classList.replace('relative', 'absolute');
      outgoing.classList.add('inset-0', 'pointer-events-none');

      current = idx;

      incoming.classList.replace('absolute', 'relative');
      incoming.classList.remove('inset-0', 'pointer-events-none');
      // Force a reflow so the browser commits the opacity-0/relative state
      // before we flip to opacity-100 — otherwise both class changes can
      // land in the same frame and the fade-in transition gets skipped.
      void incoming.offsetWidth;

      // Phase 2 — fade IN. Outgoing is now fully hidden, so only one set of
      // photos/labels is ever above 0 opacity at any instant.
      incoming.classList.replace('opacity-0', 'opacity-100');
      incoming.querySelectorAll('a').forEach(a => (a as HTMLAnchorElement).tabIndex = 0);
      dots[idx].className = 'hero-group-dot transition-all rounded-full w-4 h-1.5 bg-red';

      window.setTimeout(() => { isTransitioning = false; }, FADE_MS + 20);
    }, FADE_MS + 20);
  }

  function startTimer() { timer = setInterval(() => goTo((current + 1) % groups.length), 5000); }
  function resetTimer()  { clearInterval(timer); startTimer(); }

  dots.forEach(dot => {
    dot.addEventListener('click', () => { goTo(Number(dot.dataset.heroGroupDot)); resetTimer(); });
  });

  prevBtn?.addEventListener('click', () => { goTo((current - 1 + groups.length) % groups.length); resetTimer(); });
  nextBtn?.addEventListener('click', () => { goTo((current + 1) % groups.length); resetTimer(); });

  if (groups.length > 1 && !reduceMotion) startTimer();
}
</script>
