---
import Base from '../layouts/Base.astro';
import { u } from '../utils/url';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import CTABand from '../components/CTABand.astro';
import ProductCard from '../components/ProductCard.astro';
import Badge from '../components/Badge.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Icon from '../components/Icon.astro';
import { categoryIcon } from '../utils/categoryIcons';
import type { IconName } from '../utils/iconNames';
import categories from '../data/categories.json';
import products from '../data/products.json';
import clients from '../data/clients.json';
import locations from '../data/locations.json';
import vartechThermometers from '../data/vartech-thermometers.json';
import vartechLuxMeters from '../data/vartech-lux-meters.json';
import vartechCalibrators from '../data/vartech-calibrators.json';
import vartechDcPowerSupplies from '../data/vartech-dc-power-supplies.json';
import vartechSoundLevelMeters from '../data/vartech-sound-level-meters.json';
import vartechAnemometers from '../data/vartech-anemometers.json';
import vartechOscilloscopes from '../data/vartech-oscilloscopes.json';
import vartechFunctionGenerators from '../data/vartech-function-generators.json';
import vartechLcrMeters from '../data/vartech-lcr-meters.json';
import vartechDcLoads from '../data/vartech-dc-loads.json';
import vartechMultimetersAll from '../data/vartech-multimeters.json';
import vartechClampMetersAll from '../data/vartech-clamp-meters.json';

const vartechCounts: Record<string, number> = {
  'vartech-sound-level-meters': (vartechSoundLevelMeters as any[]).length,
  'vartech-anemometers':        (vartechAnemometers as any[]).length,
  'vartech-calibrators':        (vartechCalibrators as any[]).length,
  'vartech-lux-meters':         (vartechLuxMeters as any[]).length,
  'vartech-thermometers':       (vartechThermometers as any[]).length,
  'vartech-dc-power-supplies':  (vartechDcPowerSupplies as any[]).length,
  'vartech-oscilloscopes':      (vartechOscilloscopes as any[]).length,
  'vartech-function-generators':(vartechFunctionGenerators as any[]).length,
  'vartech-lcr-meters':         (vartechLcrMeters as any[]).length,
  'vartech-dc-loads':           (vartechDcLoads as any[]).length,
};

// Remove Vartech categories that duplicate an existing CIE category in the slider.
// "Multimeters" and "Clamp Meters" overlap with CIE's "Clamp Meters & Multimeters".
// Vartech-only categories (oscilloscopes, function generators, LCR meters, DC loads) are kept.
// Vartech multimeters/clamp-meters are excluded because CIE now has separate
// "Clamp Meters" and "Digital Multimeters" categories that already cover those types.
const SLIDER_EXCLUDE = new Set(['vartech-multimeters', 'vartech-clamp-meters']);

const categoryCount = categories
  .filter((cat: any) => !SLIDER_EXCLUDE.has(cat.id))
  .map((cat: any) => ({
    ...cat,
    count: products.filter((p: any) => p.categoryId === cat.id).length || vartechCounts[cat.id] || 0,
  }));

const heroCategoryCount = categoryCount.length;

// Real, computed catalogue size (CIE manufactured + full Vartech range) - not
// a marketing round-up. Recalculates itself as products are added/removed.
const heroProductCount =
  (products as any[]).length +
  (vartechThermometers as any[]).length +
  (vartechLuxMeters as any[]).length +
  (vartechCalibrators as any[]).length +
  (vartechDcPowerSupplies as any[]).length +
  (vartechSoundLevelMeters as any[]).length +
  (vartechAnemometers as any[]).length +
  (vartechOscilloscopes as any[]).length +
  (vartechFunctionGenerators as any[]).length +
  (vartechLcrMeters as any[]).length +
  (vartechDcLoads as any[]).length +
  (vartechMultimetersAll as any[]).length +
  (vartechClampMetersAll as any[]).length;

// Hero mosaic. pos = [column, row, colSpan, rowSpan] on a 4 x 6 grid (every
// cell is covered exactly once). bg matches each photo's own backdrop so the
// image blends into its tile: CIE studio shots are #F1F1F1, Vartech are white.
const byId = (arr: any[], id: string) => arr.find((p: any) => p.id === id);
const cieTile = (id: string, pos: number[]) => {
  const p = byId(products as any[], id)!;
  return { kind: 'img', pos, label: p.model, note: p.name, bg: '#F1F1F1',
    href: u(`/products/${p.categoryId}/${p.id}/`),
    src: u(`/images/products/${p.image && !p.image.startsWith('vartech/') ? p.image : p.id + '.webp'}`) };
};
const vtTile = (arr: any[], slug: string, id: string, pos: number[], img?: string) => {
  const p = byId(arr, id)!;
  return { kind: 'img', pos, label: p.model, note: p.name, bg: '#FFFFFF',
    href: u(`/authorised-dealership/${slug}/${p.id}/`),
    src: u(`/images/vartech/${slug}/${img ?? p.images?.[0]}`) };
};
const heroTiles: any[] = [
  cieTile('cie-444',      [1, 1, 2, 2]),
  { kind: 'text', pos: [3, 1, 1, 1], bg: '#0A0E14', fg: '#fff', big: '1963', small: 'Est. Howrah' },
  vtTile(vartechMultimetersAll as any[], 'multimeters', 'v-68', [4, 1, 1, 1]),
  cieTile('det-2000',     [3, 2, 1, 1]),
  cieTile('mr-253a',      [4, 2, 1, 1]),
  cieTile('dit-2500',     [1, 3, 1, 2]),
  cieTile('cie-777',      [2, 3, 2, 1]),
  cieTile('dcm-5410-tr',  [4, 3, 1, 2]),
  cieTile('rts-33',       [2, 4, 2, 2]),
  { kind: 'text', pos: [1, 5, 1, 1], bg: '#F5F5F7', fg: '#0A0E14', big: `${heroProductCount}+`, small: `Instruments, ${heroCategoryCount} categories` },
  cieTile('cie-7050',     [1, 6, 1, 1]),
  vtTile(vartechClampMetersAll as any[], 'clamp-meters', 'm-2101', [4, 5, 1, 1]),
  vtTile(vartechFunctionGenerators as any[], 'function-generators', 'sgda-80m', [2, 6, 2, 1]),
  vtTile(vartechOscilloscopes as any[], 'oscilloscopes', 'ss-5080ds4', [4, 6, 1, 1]),
];

// Priority lines pinned first in the Flagship slider (stock push), then the rest of the featured set.
const priorityIds = ['dit-2500', 'dcm-2250-tr', 'dcm-5410-tr', 'dm-321t'];
const priorityProducts = priorityIds.map(id => products.find(p => p.id === id)!).filter(Boolean).map(p => ({ ...p, featured: true }));
const featured = [...priorityProducts, ...products.filter(p => p.featured && !priorityIds.includes(p.id))];

const newVartechFeatured = [
  { ...vartechThermometers.find(p => p.id === 'v-6500')!,           slug: 'thermometers'     },
  { ...vartechLuxMeters.find(p => p.id === 'v-6610-b')!,            slug: 'lux-meters'       },
  { ...vartechCalibrators.find(p => p.id === 'ms-7221')!,           slug: 'calibrators'      },
  { ...vartechDcPowerSupplies.find(p => p.id === '3010')!,          slug: 'dc-power-supplies'},
  { ...vartechDcPowerSupplies.find(p => p.id === '3020-sr')!,       slug: 'dc-power-supplies'},
  { ...vartechDcPowerSupplies.find(p => p.id === 'pps-3005-s')!,    slug: 'dc-power-supplies'},
];

const genericMailto = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent('Quote Request - CIE Instruments')}&body=${encodeURIComponent('Hello CIE team,\n\nI would like to request a quote for: [PRODUCT / MODEL].\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.')}`;
const rts33Mailto  = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent('Quote Request - RTS-33')}&body=${encodeURIComponent('Hello CIE team,\n\nI would like to request a quote for: RTS-33 - Three-Phase Relay Test Set.\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.')}`;

const trustPoints: { icon: IconName; label: string; body: string }[] = [
  { icon: 'calendar',     label: '60+ Years of Service',     body: "Established 1963. Generations of engineers at India's utilities and railways have relied on the CIE® mark." },
  { icon: 'flag',         label: 'Made in India',            body: 'Designed and assembled in Howrah, West Bengal, under the registered CIE® trade mark.' },
  { icon: 'shield-check', label: '12-Month Warranty',        body: 'Every instrument carries a 12-month warranty against manufacturing defects only, with direct after-sales support.' },
  { icon: 'wrench',       label: 'Custom Ranges to Order',   body: 'Non-standard voltage, resistance, or measurement ranges? We manufacture to your specific requirement.' },
  { icon: 'zap',          label: 'Trusted by Power Utilities',body: 'Preferred by various State Electricity Boards, Indian Railways, and EPC contractors across India.' },
  { icon: 'flask',        label: 'Calibrated Before Despatch',body: 'Every instrument is calibrated against reference standards before leaving our works.' },
];

const industries: { name: string; desc: string; icon: IconName }[] = [
  { name: 'Power Utilities',           desc: 'State Electricity Boards, generation companies, transmission utilities', icon: 'zap' },
  { name: 'Indian Railways',           desc: 'Traction, signalling, and rolling stock testing requirements', icon: 'train' },
  { name: 'Substation Commissioning',  desc: 'EPC contractors and commissioning engineers', icon: 'hard-hat' },
  { name: 'Industry & Manufacturing',  desc: 'Motors, cables, panels, transformers in heavy industry', icon: 'factory' },
  { name: 'Test Laboratories',         desc: 'NABL labs, calibration centres, R&D facilities', icon: 'flask' },
  { name: 'EPC Contractors',           desc: 'Project commissioning and acceptance testing', icon: 'clipboard-check' },
];

---

<Base
  title="Home"
  description="CIE Instruments (Cambridge Instruments & Engg. Co.) - manufacturer of test and measuring instruments in India since 1963. Insulation testers, earth testers, relay test sets, oil BDV testers, clamp meters, HV test sets. Howrah, Kolkata, West Bengal. Trusted by various State Electricity Boards, Indian Railways, and cement and metal industries."
  preloadImage={u('/images/products/rts-33.webp')}
  keywords="test and measurement instruments India, electrical test instruments supplier Kolkata, insulation tester manufacturer India, digital multimeters India, oscilloscopes India, clamp meters India, vartech authorised distributor India, cambridge instruments insulation tester, CIE instruments Howrah, megger supplier India"
>
  <!-- ── HERO ─────────────────────────────────────────────────────────────
       Light, quiet, product-led: a short statement on the left and a
       catalogue-plate mosaic of real instruments on the right. Tiles are
       real links; each shows its model number and reveals the product name
       on hover. Tile backgrounds are sampled from each photo's own studio
       backdrop (CIE shots #F1F1F1, Vartech shots white) so images sit
       seamlessly inside their tile. No scripts: the only motion is the
       one-time staggered fade-in already used site-wide. ── -->
  <section id="home-hero" class="relative bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10 lg:gap-14 items-center min-h-[calc(100svh-4rem)] lg:min-h-[calc(100svh-5rem)]">

      <div class="order-1">
        <p data-hero-anim style="--d: 0ms" class="flex items-center gap-2.5 mb-6 text-[11px] font-mono uppercase tracking-[0.18em] text-muted">
          <span class="w-1.5 h-1.5 bg-red" aria-hidden="true"></span>
          Cambridge Instruments &amp; Engg. Co. &middot; Est. 1963
        </p>
        <h1 data-hero-anim style="--d: 100ms" class="text-balance text-[length:var(--text-display)] font-bold leading-[1.04] tracking-tight text-ink mb-5">
          Precision test instruments,
          <span class="text-muted">made in Howrah.</span>
        </h1>
        <p data-hero-anim style="--d: 200ms" class="text-balance text-base lg:text-lg text-muted leading-[1.65] max-w-lg mb-8">
          Insulation, earth and relay testers and oil BDV sets, manufactured by CIE. Alongside them, the Vartech range of meters, oscilloscopes and power supplies, as authorised distributor.
        </p>
        <div data-hero-anim style="--d: 300ms" class="flex flex-col sm:flex-row gap-3 mb-10">
          <a href={u('/products/')} class="btn-primary link-arrow focus:outline-none focus-visible:ring-2 focus-visible:ring-ink">
            Explore Products
            <Icon name="arrow" class="w-4 h-4 shrink-0" />
          </a>
          <a href={genericMailto} class="btn-secondary text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-ink">
            Request a Quote
          </a>
        </div>
        <ul data-hero-anim style="--d: 400ms" class="flex flex-wrap gap-y-2 text-[11px] font-mono uppercase tracking-wide text-muted">
          {['60+ Years', 'Made in India', '12-Month Warranty', 'In-House Calibration'].map(t => (
            <li class="pr-4 mr-4 border-r border-border last:border-0 last:mr-0 last:pr-0">{t}</li>
          ))}
        </ul>
      </div>

      <div class="hero-mosaic-wrap order-2 w-full max-w-[640px] mx-auto lg:mx-0 lg:ml-auto">
        <div class="hero-mosaic" role="list">
          {heroTiles.map((t, i) => t.kind === 'text' ? (
            <div role="listitem" data-hero-anim style={`--d: ${150 + i * 55}ms; --c:${t.pos[0]}; --r:${t.pos[1]}; --w:${t.pos[2]}; --h:${t.pos[3]}; background:${t.bg}; color:${t.fg};`} class="hero-tile hero-tile--text">
              <span class="hero-tile-big">{t.big}</span>
              <span class="hero-tile-small">{t.small}</span>
            </div>
          ) : (
            <a role="listitem" href={t.href} data-hero-anim style={`--d: ${150 + i * 55}ms; --c:${t.pos[0]}; --r:${t.pos[1]}; --w:${t.pos[2]}; --h:${t.pos[3]}; background:${t.bg};`} class={`hero-tile hero-tile--img group${t.pos[3] === 1 ? ' hero-tile--fill' : ''}`} aria-label={`${t.label} - ${t.note}`}>
              <img src={t.src} alt="" loading={i < 6 ? 'eager' : 'lazy'} decoding="async" width="400" height="400" />
              <span class="hero-tile-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="hero-tile-cap">
                <span class="hero-tile-model">{t.label}</span>
                <span class="hero-tile-note">{t.note}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="mt-3 text-[10px] font-mono uppercase tracking-[0.18em] text-muted lg:text-right">Selected from the range &middot; hover to identify</p>
      </div>
    </div>

    <style>
      .hero-mosaic {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(6, 1fr);
        gap: 8px;
        aspect-ratio: 4 / 4.3;
      }
      /* on desktop, never let the mosaic outgrow the viewport height */
      @media (min-width: 1024px) { .hero-mosaic-wrap { max-width: min(100%, calc((100svh - 8.5rem) * 0.93)); } }
      @media (min-width: 640px) { .hero-mosaic { gap: 10px; } }
      .hero-tile {
        position: relative;
        grid-column: var(--c) / span var(--w);
        grid-row: var(--r) / span var(--h);
        border-radius: 12px;
        border: 1px solid rgba(10, 14, 20, 0.07);
        overflow: hidden;
        min-width: 0; min-height: 0;
        transition: border-color 0.25s var(--ease-premium), box-shadow 0.25s var(--ease-premium);
      }
      .hero-tile--img:hover, .hero-tile--img:focus-visible {
        border-color: var(--color-ink);
        box-shadow: 0 10px 28px rgba(10, 14, 20, 0.10);
        outline: none;
      }
      .hero-tile img {
        position: absolute; inset: 0; width: 100%; height: 100%;
        object-fit: contain; padding: 9%;
        transition: transform 0.6s var(--ease-premium);
      }
      .hero-tile--img:hover img, .hero-tile--img:focus-visible img { transform: scale(1.06); }
      /* single-row tiles are short and wide: fill them so the product isn't a speck */
      .hero-tile--fill img { object-fit: cover; padding: 0; transform: scale(1.18); }
      .hero-tile--fill:hover img, .hero-tile--fill:focus-visible img { transform: scale(1.26); }
      .hero-tile-idx {
        position: absolute; top: 7px; left: 9px;
        font: 500 9px/1 var(--font-mono); letter-spacing: 0.1em; color: rgba(10, 14, 20, 0.35);
      }
      .hero-tile-cap {
        position: absolute; left: 6px; right: 6px; bottom: 6px;
        display: flex; flex-direction: column; gap: 2px;
        padding: 4px 7px; border-radius: 7px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        width: fit-content; max-width: calc(100% - 12px);
      }
      .hero-tile-model { font: 500 10px/1.2 var(--font-mono); letter-spacing: 0.04em; color: var(--color-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .hero-tile-note {
        font: 400 11px/1.3 var(--font-sans); color: var(--color-muted);
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
        max-height: 0; opacity: 0;
        transition: max-height 0.3s var(--ease-premium), opacity 0.3s var(--ease-premium);
      }
      .hero-tile--img:hover .hero-tile-note, .hero-tile--img:focus-visible .hero-tile-note { max-height: 3em; opacity: 1; }
      .hero-tile--text {
        display: flex; flex-direction: column; justify-content: flex-end; gap: 4px;
        padding: 10px 12px;
      }
      .hero-tile-big { font: 600 clamp(1.15rem, 2.6vw, 2rem)/1 var(--font-mono); letter-spacing: -0.02em; }
      .hero-tile-small { font: 500 9px/1.35 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.7; }
      @media (max-width: 639px) {
        .hero-tile-cap { left: 4px; bottom: 4px; padding: 2px 5px; }
        .hero-tile-model { font-size: 8px; }
        .hero-tile-note, .hero-tile-idx { display: none; }
        .hero-tile--text { padding: 7px 8px; }
        .hero-tile-small { font-size: 7px; }
      }
      @media (hover: none) { .hero-tile-note { display: none; } }
    </style>
  </section>

  <!-- ── PRODUCT CATEGORIES (horizontal slider) ───────────────────────────── -->
  <section class="bg-cloud section-pad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10 gap-4" data-reveal>
        <div>
          <EyebrowLabel text="Product Catalogue" class="mb-3" />
          <h2 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Test &amp; Measurement Instruments</h2>
          <p class="mt-3 text-muted max-w-2xl text-lg leading-relaxed">
            CIE manufactured instruments from Howrah, plus the full Vartech range - backed by direct after-sales support.
          </p>
        </div>
        <!-- Slider arrows -->
        <div class="hidden sm:flex items-center gap-2 shrink-0">
          <button id="cat-prev" aria-label="Previous categories"
            class="w-9 h-9 rounded-full border border-border bg-white hover:border-ink hover:bg-ink hover:text-white text-ink transition-all flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="cat-next" aria-label="Next categories"
            class="w-9 h-9 rounded-full border border-border bg-white hover:border-ink hover:bg-ink hover:text-white text-ink transition-all flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Scrollable track -->
      <div id="cat-track"
        class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-3 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
        style="scrollbar-width:none; -ms-overflow-style:none;">
        {categoryCount.map(cat => (
          <a href={u((cat as any).brand === 'vartech' ? `/authorised-dealership/${cat.id.replace('vartech-', '')}/` : `/products/${cat.id}/`)}
            class="card card-interactive group snap-start shrink-0 w-[260px] sm:w-[280px] p-6 flex flex-col">
            <div class="flex items-start gap-3 mb-3">
              <div class="shrink-0 w-11 h-11 bg-cloud rounded-xl flex items-center justify-center transition-colors duration-200 group-hover:bg-red/8">
                <Icon name={categoryIcon(cat.id)} class="w-5 h-5 text-ink transition-colors duration-200 group-hover:text-red" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-ink text-sm leading-snug transition-colors duration-200 group-hover:text-red line-clamp-2">{cat.name}</h3>
                <span class="text-xs font-mono text-muted">{cat.count} {cat.count === 1 ? 'product' : 'products'}</span>
              </div>
            </div>
            <p class="text-xs text-muted leading-relaxed line-clamp-3 flex-1">{cat.description}</p>
            <div class="link-arrow mt-3 pt-3 border-t border-border text-xs text-red">
              View products <Icon name="arrow" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>

      <!-- Dot indicators (aria-hidden: decorative, tabindex=-1 keeps them non-focusable) -->
      <div id="cat-dots" class="flex justify-center gap-1.5 mt-5" aria-hidden="true">
        {categoryCount.map((_, i) => (
          <button data-dot={i}
            tabindex="-1"
            class={`cat-dot w-1.5 h-1.5 rounded-full transition-all ${i === 0 ? 'bg-ink w-4' : 'bg-muted/30'}`}></button>
        ))}
      </div>

      <div class="mt-6 text-center">
        <ArrowLink href="/products/" class="justify-center text-sm text-ink hover:text-red">
          Browse full catalogue
        </ArrowLink>
      </div>
    </div>
  </section>

  <script>
  {
    const track = document.getElementById('cat-track');
    const dots  = document.querySelectorAll<HTMLButtonElement>('.cat-dot');
    const prev  = document.getElementById('cat-prev') as HTMLButtonElement | null;
    const next  = document.getElementById('cat-next') as HTMLButtonElement | null;
    if (track) {
      let cachedSlideW = 296;
      const updateSlideW = () => {
        const first = track.querySelector('a');
        if (first) cachedSlideW = first.offsetWidth + 16;
      };
      // Defer initial measurement out of the critical layout path
      requestAnimationFrame(updateSlideW);
      new ResizeObserver(updateSlideW).observe(track);
      const slideW = () => cachedSlideW;
      const scroll = (dir: number) => {
        track.scrollBy({ left: dir * slideW() * 3, behavior: 'smooth' });
      };
      prev?.addEventListener('click', () => scroll(-1));
      next?.addEventListener('click', () => scroll(1));
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * slideW(), behavior: 'smooth' });
        });
      });
      track.addEventListener('scroll', () => {
        const idx = Math.round(track.scrollLeft / slideW());
        dots.forEach((d, i) => {
          d.classList.toggle('bg-ink', i === idx);
          d.classList.toggle('!w-4', i === idx);
          d.classList.toggle('bg-muted/30', i !== idx);
        });
      }, { passive: true });
    }
  }
  </script>

  <!-- ── FEATURED PRODUCTS ─────────────────────────────────────────────────── -->
  <!-- No top padding here on purpose: this section shares bg-cloud with
       Product Categories directly above it and has no divider between
       them, so stacking a full section-pad top AND the previous section's
       full section-pad bottom read as one oversized, accidental-looking
       gap (128-160px + 128-160px = 256-320px of blank space with nothing
       to signal "new section start"). Bottom padding stays identical to
       section-pad's own values (pb-20/32/40 = 5/8/10rem) since Why CIE
       below uses a different background and still needs the full rhythm
       to read as a real section break. If this section is ever moved
