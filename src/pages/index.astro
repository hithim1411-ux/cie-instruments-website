---
import Base from '../layouts/Base.astro';
import { u } from '../utils/url';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import CTABand from '../components/CTABand.astro';
import ProductCard from '../components/ProductCard.astro';
import Badge from '../components/Badge.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Icon from '../components/Icon.astro';
import { categoryIcon } from '../utils/categoryIcons';
import type { IconName } from '../utils/iconNames';
import categories from '../data/categories.json';
import products from '../data/products.json';
import clients from '../data/clients.json';
import vartechThermometers from '../data/vartech-thermometers.json';
import vartechLuxMeters from '../data/vartech-lux-meters.json';
import vartechCalibrators from '../data/vartech-calibrators.json';
import vartechDcPowerSupplies from '../data/vartech-dc-power-supplies.json';
import vartechSoundLevelMeters from '../data/vartech-sound-level-meters.json';
import vartechAnemometers from '../data/vartech-anemometers.json';
import vartechOscilloscopes from '../data/vartech-oscilloscopes.json';
import vartechFunctionGenerators from '../data/vartech-function-generators.json';
import vartechLcrMeters from '../data/vartech-lcr-meters.json';
import vartechDcLoads from '../data/vartech-dc-loads.json';

const vartechCounts: Record<string, number> = {
  'vartech-sound-level-meters': (vartechSoundLevelMeters as any[]).length,
  'vartech-anemometers':        (vartechAnemometers as any[]).length,
  'vartech-calibrators':        (vartechCalibrators as any[]).length,
  'vartech-lux-meters':         (vartechLuxMeters as any[]).length,
  'vartech-thermometers':       (vartechThermometers as any[]).length,
  'vartech-dc-power-supplies':  (vartechDcPowerSupplies as any[]).length,
  'vartech-oscilloscopes':      (vartechOscilloscopes as any[]).length,
  'vartech-function-generators':(vartechFunctionGenerators as any[]).length,
  'vartech-lcr-meters':         (vartechLcrMeters as any[]).length,
  'vartech-dc-loads':           (vartechDcLoads as any[]).length,
};

// Remove Vartech categories that duplicate an existing CIE category in the slider.
// "Multimeters" and "Clamp Meters" overlap with CIE's "Clamp Meters & Multimeters".
// Vartech-only categories (oscilloscopes, function generators, LCR meters, DC loads) are kept.
// Vartech multimeters/clamp-meters are excluded because CIE now has separate
// "Clamp Meters" and "Digital Multimeters" categories that already cover those types.
const SLIDER_EXCLUDE = new Set(['vartech-multimeters', 'vartech-clamp-meters']);

const categoryCount = categories
  .filter((cat: any) => !SLIDER_EXCLUDE.has(cat.id))
  .map((cat: any) => ({
    ...cat,
    count: products.filter((p: any) => p.categoryId === cat.id).length || vartechCounts[cat.id] || 0,
  }));

const heroCategoryCount = categoryCount.length;

const featured = products.filter(p => p.featured);

const newVartechFeatured = [
  { ...vartechThermometers.find(p => p.id === 'v-6500')!,           slug: 'thermometers'     },
  { ...vartechLuxMeters.find(p => p.id === 'v-6610-b')!,            slug: 'lux-meters'       },
  { ...vartechCalibrators.find(p => p.id === 'ms-7221')!,           slug: 'calibrators'      },
  { ...vartechDcPowerSupplies.find(p => p.id === '3010')!,          slug: 'dc-power-supplies'},
  { ...vartechDcPowerSupplies.find(p => p.id === '3020-sr')!,       slug: 'dc-power-supplies'},
  { ...vartechDcPowerSupplies.find(p => p.id === 'pps-3005-s')!,    slug: 'dc-power-supplies'},
];

const genericMailto = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent('Quote Request - CIE Instruments')}&body=${encodeURIComponent('Hello CIE team,\n\nI would like to request a quote for: [PRODUCT / MODEL].\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.')}`;
const rts33Mailto  = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent('Quote Request - RTS-33')}&body=${encodeURIComponent('Hello CIE team,\n\nI would like to request a quote for: RTS-33 - Three-Phase Relay Test Set.\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.')}`;

const trustPoints: { icon: IconName; label: string; body: string }[] = [
  { icon: 'calendar',     label: '60+ Years of Service',     body: "Established 1963. Generations of engineers at India's utilities and railways have relied on the CIE® mark." },
  { icon: 'flag',         label: 'Made in India',            body: 'Designed and assembled in Howrah, West Bengal, under the registered CIE® trade mark.' },
  { icon: 'shield-check', label: '12-Month Warranty',        body: 'Every instrument carries a 12-month warranty against manufacturing defects, with direct after-sales support.' },
  { icon: 'wrench',       label: 'Custom Ranges to Order',   body: 'Non-standard voltage, resistance, or measurement ranges? We manufacture to your specific requirement.' },
  { icon: 'zap',          label: 'Trusted by Power Utilities',body: 'Preferred by various State Electricity Boards, Indian Railways, and EPC contractors across India.' },
  { icon: 'flask',        label: 'Calibrated Before Despatch',body: 'Every instrument is calibrated against reference standards before leaving our works.' },
];

const industries: { name: string; desc: string; icon: IconName }[] = [
  { name: 'Power Utilities',           desc: 'State Electricity Boards, generation companies, transmission utilities', icon: 'zap' },
  { name: 'Indian Railways',           desc: 'Traction, signalling, and rolling stock testing requirements', icon: 'train' },
  { name: 'Substation Commissioning',  desc: 'EPC contractors and commissioning engineers', icon: 'hard-hat' },
  { name: 'Industry & Manufacturing',  desc: 'Motors, cables, panels, transformers in heavy industry', icon: 'factory' },
  { name: 'Test Laboratories',         desc: 'NABL labs, calibration centres, R&D facilities', icon: 'flask' },
  { name: 'EPC Contractors',           desc: 'Project commissioning and acceptance testing', icon: 'clipboard-check' },
];

---

<Base
  title="Home"
  description="CIE (Cambridge Instruments & Engg. Co.) - manufacturer of test and measuring instruments in India since 1963, and an authorised dealer for Vartech precision digital instruments. Insulation testers, earth testers, relay test sets, oil BDV testers, plus Vartech oscilloscopes, function generators, multimeters and clamp meters. Howrah, Kolkata, West Bengal. Trusted by various State Electricity Boards, Indian Railways, and cement and metal industries."
  preloadImage={u('/images/products/rts-33.webp')}
  keywords="vartech authorised dealer India, vartech oscilloscope India, vartech multimeter price, vartech function generator, vartech distributor India, test and measurement instruments India, electrical test instruments supplier Kolkata, insulation tester manufacturer India, digital multimeters India, oscilloscopes India, clamp meters India, cambridge instruments insulation tester, CIE instruments Howrah, megger supplier India"
  transparentHero
>
  <!-- ── HERO - full viewport, scroll-driven ─────────────────────────────────
       Header floats transparent over this section (transparentHero on Base)
       and only turns solid once scrolled. Copy-only: no product photo. On
       large screens the centered copy sits between two instrument-panel
       rails (ruler ticks + coordinates on the left, an analogue gauge on
       the right) so the wide viewport reads as a designed panel rather than
       empty margin; both rails hide below lg and the layout collapses back
       to the plain centered column already proven on mobile. Headline uses
       text-balance so the browser always picks even line breaks instead of
       orphaning a single short word. Content fades/scales on scroll (see
       script below). ── -->
  <section id="home-hero" class="blueprint-bg text-white relative overflow-hidden min-h-screen flex items-center">
    <!-- Ambient glow - two layered radials for depth: a wide dim wash behind
         the whole panel, plus a tighter, brighter core right behind the
         headline so the copy reads as the lit centre of the instrument. A
         slow conic sweep rotates behind everything, like a radar/gauge scan
         - low-opacity enough to read as ambience, not an effect. -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1400px] h-[800px] rounded-full opacity-[0.09] pointer-events-none"
      style="background: radial-gradient(ellipse at top, #E0252E 0%, transparent 65%);" aria-hidden="true">
    </div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] rounded-full opacity-[0.12] pointer-events-none"
      style="background: radial-gradient(ellipse at center, #E0252E 0%, transparent 70%);" aria-hidden="true">
    </div>
    <div id="hero-radar" class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full pointer-events-none opacity-[0.05]"
      style="background: conic-gradient(from 0deg, transparent 0deg, #E0252E 8deg, transparent 40deg, transparent 360deg);" aria-hidden="true">
    </div>

    <!-- Corner brackets - a calibration-frame motif around the whole panel,
         reinforcing "precision instrument" at the widest breakpoints only. -->
    <div class="hidden lg:block absolute inset-6 xl:inset-10 pointer-events-none z-10" aria-hidden="true">
      <span class="absolute top-0 left-0 w-6 h-6 border-t border-l border-white/20"></span>
      <span class="absolute top-0 right-0 w-6 h-6 border-t border-r border-white/20"></span>
      <span class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-white/20"></span>
      <span class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-white/20"></span>
    </div>

    <div id="hero-content" class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-10 xl:px-16 pt-32 pb-16 lg:pt-40 lg:pb-10 w-full grid grid-cols-1 lg:grid-cols-[minmax(0,120px)_1fr_minmax(0,120px)] xl:grid-cols-[160px_1fr_160px] items-center gap-y-10 lg:gap-x-8 will-change-[transform,opacity]">

      <!-- ── Left rail: ruler ticks + works coordinates - hidden below lg ── -->
      <div data-hero-fade style="--d: 200ms" class="hidden lg:flex flex-col items-center h-[380px] mx-auto" aria-hidden="true">
        <span class="text-[10px] font-mono text-muted-dark tracking-[0.25em] uppercase [writing-mode:vertical-rl] mb-4">
          Test &amp; Measurement Instruments
        </span>
        <div class="flex-1 w-px bg-[repeating-linear-gradient(to_bottom,rgba(255,255,255,0.18)_0_1px,transparent_1px_14px)]"></div>
        <div class="mt-4 text-center">
          <p class="text-[10px] font-mono text-muted-dark tracking-widest">22.575°N</p>
          <p class="text-[10px] font-mono text-muted-dark tracking-widest">88.353°E</p>
          <p class="mt-2 text-[9px] font-mono text-red tracking-[0.2em] uppercase">Howrah Works</p>
        </div>
      </div>

      <!-- ── Center: headline, copy, CTAs ─────────────────────────────────── -->
      <div class="text-center">
        <!-- Eyebrow -->
        <div data-hero-anim style="--d: 0ms" class="inline-flex items-center gap-2 mb-8 px-3 py-1.5 rounded-full border border-white/10 bg-white/5">
          <span class="w-1.5 h-1.5 rounded-full bg-red animate-pulse" aria-hidden="true"></span>
          <span class="text-[11px] font-mono text-muted-dark tracking-widest uppercase">Cambridge Instruments &amp; Engg. Co. · Est. 1963</span>
        </div>

        <!-- Headline - text-balance lets the browser choose even line breaks
             at every width, instead of forced per-line spans wrapping badly. -->
        <h1 data-hero-anim style="--d: 120ms" class="text-balance text-[length:var(--text-hero)] font-extrabold leading-[1.05] tracking-tight mb-6 text-white mx-auto max-w-[18ch]">
          Precision instruments, <span class="text-red">built in India</span>.
        </h1>

        <!-- Subhead -->
        <p data-hero-anim style="--d: 240ms" class="text-balance text-lg text-muted-dark mb-10 leading-[1.6] max-w-xl mx-auto">
          Insulation testers, earth testers, relay test sets, and oil test equipment,
          engineered in Howrah for utilities, railways, and industry since 1963.
        </p>

        <!-- CTAs -->
        <div data-hero-anim style="--d: 360ms" class="flex flex-col sm:flex-row gap-3 justify-center mb-10">
          <a
            href={u('/products/')}
            class="btn-primary link-arrow focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Explore Products
            <Icon name="arrow" class="w-4 h-4 shrink-0" />
          </a>
          <a
            href={genericMailto}
            class="btn-secondary text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Request a Quote
          </a>
        </div>

        <!-- Trust row -->
        <div data-hero-anim style="--d: 480ms" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-10 text-xs text-muted-dark font-mono uppercase tracking-wide">
          {['60+ Years', 'Made in India', '12-Month Warranty', 'Authorised Vartech Dealer'].map(t => (
            <span class="flex items-center gap-1.5">
              <span class="w-1 h-1 rounded-full bg-red" aria-hidden="true"></span>
              {t}
            </span>
          ))}
        </div>

        <!-- Stat band - real, computed figures (not marketing round-ups).
             Numbers count up on load (script below); prefers-reduced-motion
             and no-JS both fall back to the plain final value below. -->
        <div data-hero-anim style="--d: 560ms" class="flex items-stretch justify-center divide-x divide-white/10 max-w-lg mx-auto">
          {[
            { value: 1963, suffix: '', label: 'Founded In' },
            { value: 60, suffix: '+', label: 'Years of Service' },
            { value: heroCategoryCount, suffix: '', label: 'Product Categories' },
          ].map(s => (
            <div class="flex-1 px-4 sm:px-6 first:pl-0 last:pr-0">
              <p class="hero-stat-num text-2xl sm:text-3xl font-extrabold text-white tracking-tight" data-count-to={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</p>
              <p class="mt-1 text-[10px] font-mono text-muted-dark tracking-widest uppercase">{s.label}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ── Right rail: analogue gauge motif - hidden below lg ──────────── -->
      <div data-hero-fade style="--d: 200ms" class="hidden lg:flex flex-col items-center h-[380px] mx-auto" aria-hidden="true">
        <div class="relative">
          <div class="absolute inset-0 rounded-full bg-red/25 blur-2xl pointer-events-none" aria-hidden="true"></div>
          <svg id="hero-gauge" class="relative w-24 xl:w-28 h-auto" viewBox="0 0 120 90" fill="none">
            <path d="M 10 75 A 50 50 0 0 1 110 75" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round" />
            {Array.from({ length: 11 }).map((_, i) => {
              const deg = 180 - i * 18;
              const rad = (deg * Math.PI) / 180;
              const rOuter = 50, rInner = i % 5 === 0 ? 41 : 45;
              const x1 = 60 + rOuter * Math.cos(rad), y1 = 75 - rOuter * Math.sin(rad);
              const x2 = 60 + rInner * Math.cos(rad), y2 = 75 - rInner * Math.sin(rad);
              return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={i % 5 === 0 ? '#E0252E' : 'rgba(255,255,255,0.35)'} stroke-width="1.5" stroke-linecap="round" />;
            })}
            <g id="hero-gauge-needle" style="transform-origin: 60px 75px;">
              <line x1="60" y1="75" x2="60" y2="30" stroke="#E0252E" stroke-width="2" stroke-linecap="round" />
            </g>
            <circle cx="60" cy="75" r="4" fill="white" />
          </svg>
        </div>
        <p class="mt-3 text-[9px] font-mono text-muted-dark tracking-[0.2em] uppercase text-center max-w-[8ch]">Calibrated Before Despatch</p>
        <div class="flex-1 w-px mt-4 bg-[repeating-linear-gradient(to_bottom,rgba(255,255,255,0.18)_0_1px,transparent_1px_14px)]"></div>
        <span class="text-[10px] font-mono text-muted-dark tracking-[0.25em] uppercase [writing-mode:vertical-rl] rotate-180 mt-4">
          Authorised Vartech Dealer
        </span>
      </div>

    </div>

    <!-- Gauge needle: sweeps in once, then rests. Radar sweep rotates
         continuously and slowly. Both skipped for reduced motion, where the
         base (or omitted) transform already shows the resting state. -->
    <style>
      @media (prefers-reduced-motion: no-preference) {
        #hero-gauge-needle {
          transform: rotate(-58deg);
          animation: hero-gauge-sweep 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both;
        }
        #hero-radar {
          animation: hero-radar-spin 16s linear infinite;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #hero-gauge-needle { transform: rotate(-58deg); }
        #hero-radar { display: none; }
      }
      @keyframes hero-gauge-sweep {
        0%   { transform: rotate(70deg); }
        60%  { transform: rotate(-68deg); }
        100% { transform: rotate(-58deg); }
      }
      @keyframes hero-radar-spin {
        from { transform: translate(-50%, -50%) rotate(0deg); }
        to   { transform: translate(-50%, -50%) rotate(360deg); }
      }
    </style>

    <!-- Scroll cue -->
    <div id="hero-scroll-cue" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-muted-dark transition-opacity duration-500" aria-hidden="true">
      <span class="text-[10px] font-mono uppercase tracking-widest">Scroll</span>
      <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7-7-7M12 21V3"/>
      </svg>
    </div>
  </section>

  <script>
  {
    // ── Hero scroll dynamics: content fade/scale-out only ───────────────────
    // Runs only while the hero is in view (IntersectionObserver-gated) and
    // only does work inside requestAnimationFrame, so it costs nothing once
    // the user has scrolled past. Fully skipped for prefers-reduced-motion.
    // No image parallax: the product stage sits in normal document flow
    // beneath a content-height (not viewport-locked) hero, so translating it
    // on scroll would push it past the section's own bottom edge and get
    // clipped by overflow-hidden - not worth it for a single centered shot.
    const hero    = document.getElementById('home-hero');
    const content = document.getElementById('hero-content');
    const cue     = document.getElementById('hero-scroll-cue');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hero && content && !reduceMotion) {
      let heroInView = true;
      let ticking = false;

      function apply() {
        const heroHeight = hero!.offsetHeight || 1;
        const progress = Math.min(Math.max(window.scrollY / heroHeight, 0), 1);

        content!.style.opacity = String(Math.max(1 - progress * 1.15, 0));
        content!.style.transform = `scale(${1 - progress * 0.06})`;

        if (cue) cue.style.opacity = String(Math.max(1 - progress * 4, 0));

        ticking = false;
      }

      function onScroll() {
        if (!heroInView) return;
        if (!ticking) {
          requestAnimationFrame(apply);
          ticking = true;
        }
      }

      // Only listen while the hero is anywhere near the viewport.
      const io = new IntersectionObserver((entries) => {
        heroInView = entries[0]?.isIntersecting ?? false;
        if (heroInView) apply();
      }, { rootMargin: '200px 0px 200px 0px' });
      io.observe(hero);

      window.addEventListener('scroll', onScroll, { passive: true });
      apply();
    }
  }
  </script>

  <script>
  {
    // ── Hero stat band: count up from 0 once on load ─────────────────────
    // Markup already renders the final value (progressive enhancement / no-JS
    // fallback); this just animates from 0 up to it once, skipped entirely
    // for prefers-reduced-motion.
    const nums = document.querySelectorAll<HTMLElement>('.hero-stat-num');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (nums.length && !reduceMotion) {
      nums.forEach(el => {
        const target = Number(el.dataset.countTo || '0');
        const suffix = el.dataset.suffix || '';
        el.textContent = '0' + suffix;

        const duration = 1100;
        let start: number | null = null;

        function step(ts: number) {
          if (start === null) start = ts;
          const progress = Math.min((ts - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.round(eased * target) + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }

        setTimeout(() => requestAnimationFrame(step), 700);
      });
    }
  }
  </script>

  <!-- ── PRODUCT CATEGORIES (horizontal slider) ───────────────────────────── -->
  <section class="bg-cloud section-pad">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10 gap-4" data-reveal>
        <div>
          <EyebrowLabel text="Product Catalogue" class="mb-3" />
          <h2 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Test &amp; Measurement Instruments</h2>
          <p class="mt-3 text-muted max-w-2xl text-lg leading-relaxed">
            CIE manufactured instruments from Howrah, plus the full Vartech range - backed by direct after-sales support.
          </p>
        </div>
        <!-- Slider arrows -->
        <div class="hidden sm:flex items-center gap-2 shrink-0">
          <button id="cat-prev" aria-label="Previous categories"
            class="w-9 h-9 rounded-full border border-border bg-white hover:border-ink hover:bg-ink hover:text-white text-ink transition-all flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="cat-next" aria-label="Next categories"
            class="w-9 h-9 rounded-full border border-border bg-white hover:border-ink hover:bg-ink hover:text-white text-ink transition-all flex items-center justify-center disabled:opacity-30 disabled:pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <!-- Scrollable track -->
      <div id="cat-track"
        class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-3 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
        style="scrollbar-width:none; -ms-overflow-style:none;">
        {categoryCount.map(cat => (
          <a href={u((cat as any).brand === 'vartech' ? `/authorised-dealership/${cat.id.replace('vartech-', '')}/` : `/products/${cat.id}/`)}
            class="card card-interactive group snap-start shrink-0 w-[260px] sm:w-[280px] p-6 flex flex-col">
            <div class="flex items-start gap-3 mb-3">
              <div class="shrink-0 w-11 h-11 bg-cloud rounded-xl flex items-center justify-center transition-colors duration-200 group-hover:bg-red/8">
                <Icon name={categoryIcon(cat.id)} class="w-5 h-5 text-ink transition-colors duration-200 group-hover:text-red" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-ink text-sm leading-snug transition-colors duration-200 group-hover:text-red line-clamp-2">{cat.name}</h3>
                <span class="text-xs font-mono text-muted">{cat.count} {cat.count === 1 ? 'product' : 'products'}</span>
              </div>
            </div>
            <p class="text-xs text-muted leading-relaxed line-clamp-3 flex-1">{cat.description}</p>
            <div class="link-arrow mt-3 pt-3 border-t border-border text-xs text-red">
              View products <Icon name="arrow" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>

      <!-- Dot indicators (aria-hidden: decorative, tabindex=-1 keeps them non-focusable) -->
      <div id="cat-dots" class="flex justify-center gap-1.5 mt-5" aria-hidden="true">
        {categoryCount.map((_, i) => (
          <button data-dot={i}
            tabindex="-1"
            class={`cat-dot w-1.5 h-1.5 rounded-full transition-all ${i === 0 ? 'bg-ink w-4' : 'bg-muted/30'}`}></button>
        ))}
      </div>

      <div class="mt-6 text-center">
        <ArrowLink href="/products/" class="justify-center text-sm text-ink hover:text-red">
          Browse full catalogue
        </ArrowLink>
      </div>
    </div>
  </section>

  <script>
  {
    const track = document.getElementById('cat-track');
    const dots  = document.querySelectorAll<HTMLButtonElement>('.cat-dot');
    const prev  = document.getElementById('cat-prev') as HTMLButtonElement | null;
    const next  = document.getElementById('cat-next') as HTMLButtonElement | null;
    if (track) {
      let cachedSlideW = 296;
      const updateSlideW = () => {
        const first = track.querySelector('a');
        if (first) cachedSlideW = first.offsetWidth + 16;
      };
      // Defer initial measurement out of the critical layout path
      requestAnimationFrame(updateSlideW);
      new ResizeObserver(updateSlideW).observe(track);
      const slideW = () => cachedSlideW;
      const scroll = (dir: number) => {
        track.scrollBy({ left: dir * slideW() * 3, behavior: 'smooth' });
      };
      prev?.addEventListener('click', () => scroll(-1));
      next?.addEventListener('click', () => scroll(1));
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * slideW(), behavior: 'smooth' });
        });
      });
      track.addEventListener('scroll', () => {
        const idx = Math.round(track.scrollLeft / slideW());
        dots.forEach((d, i) => {
          d.classList.toggle('bg-ink', i === idx);
          d.classList.toggle('!w-4', i === idx);
          d.classList.toggle('bg-muted/30', i !== idx);
        });
      }, { passive: true });
    }
  }
  </script>

