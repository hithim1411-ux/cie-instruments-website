---
import Base from '../layouts/Base.astro';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABand from '../components/CTABand.astro';
import site from '../data/site.json';
import { getGroups } from '../data/compare';

const data = getGroups();
const json = JSON.stringify(data).replace(/</g, '\\u003c');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Instrument Comparison Tool',
  description: 'Compare CIE and Vartech test instruments side by side.',
  url: 'https://www.cieinstruments.in/compare/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  publisher: { '@id': 'https://www.cieinstruments.in/#organization' },
};
---

<Base title="Compare Instruments Side by Side" description="Pick two or three CIE or Vartech instruments and see their specifications side by side: clamp meters, multimeters, insulation testers, oscilloscopes and more.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="blueprint-bg bg-ink text-white pt-10 pb-12 lg:pb-16 cmp-noprint">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="cmp-crumbs"><Breadcrumbs crumbs={[{ label: 'Compare' }]} /></div>
      <EyebrowLabel text="Free tool" class="mt-5 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold leading-[1.1] tracking-tight max-w-4xl">Compare instruments side by side</h1>
      <p class="mt-3 text-muted-dark max-w-2xl text-body-lg">Choose a type, pick up to three models and see their specifications side by side.</p>
    </div>
  </section>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="cmp-noprint">
        <p class="cmp-step"><span>1</span> What are you comparing?</p>
        <div class="cmp-pills" id="cmp-groups" role="group" aria-label="Instrument type"></div>
        <p class="cmp-blurb" id="cmp-blurb"></p>

        <p class="cmp-step mt-7"><span>2</span> Pick up to three models <em id="cmp-count"></em></p>
        <div class="cmp-picktools">
          <input type="search" id="cmp-find" placeholder="Search models" aria-label="Search models" />
        </div>
        <div class="cmp-picker" id="cmp-picker"></div>

        <div class="cmp-bar" id="cmp-bar" hidden>
          <label class="cmp-hl"><input type="checkbox" id="cmp-hl" checked /> Highlight differences</label>
          <button type="button" class="cmp-btn" id="cmp-share">Copy link</button>
          <button type="button" class="cmp-btn" id="cmp-clear">Clear</button>
        </div>
      </div>

      <div class="cmp-empty cmp-noprint" id="cmp-empty">Tick at least two models above to see them side by side.</div>

      <div class="cmp-wrap" id="cmp-wrap" hidden>
        <table class="cmp-table hl" id="cmp-table"></table>
      </div>
      <button type="button" class="cmp-more cmp-noprint" id="cmp-more" hidden aria-expanded="false"></button>

      <div class="cmp-help cmp-noprint" id="cmp-help" hidden>
        <div>
          <p class="cmp-help-h">Have questions about these models?</p>
          <p class="cmp-help-p">Contact us on WhatsApp and we will help you choose.</p>
        </div>
        <a class="cmp-btn cmp-btn--wa" id="cmp-wa" href="#" target="_blank" rel="noopener noreferrer" data-wa={site.whatsapp}>Contact us on WhatsApp</a>
      </div>

      <p class="cmp-note">Specifications are taken from each product page. Please confirm details with us before ordering.</p>
    </div>
  </section>

  <div class="cmp-noprint"><CTABand heading="Not sure which one fits?" body="Tell us what you need to measure and our team in Howrah will suggest the right instrument." /></div>

  <div id="cmp-toast" role="status" aria-live="polite"></div>
  <script type="application/json" id="cmp-data" set:html={json}></script>

  <script>
    import { buildRows, rowDiffers } from '../utils/compareCore';
    import type { Group, Item, RowOut } from '../utils/compareCore';

    const DATA: Group[] = JSON.parse(document.getElementById('cmp-data')!.textContent || '[]');
    const MAX = 3, KEY = 'cie-compare';
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const state = { g: DATA[0].id, sel: [] as string[], q: '' };
    let showMore = false;

    const esc = (s: string) => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
    const group = () => DATA.find(g => g.id === state.g) || DATA[0];
    const byId = (g: Group, id: string) => g.items.find(i => i.id === id);
    const picked = () => state.sel.map(id => byId(group(), id)).filter(Boolean) as Item[];

    let toastTimer: number;
    function say(msg: string) { const t = $('cmp-toast'); t.textContent = msg; t.classList.add('on'); clearTimeout(toastTimer); toastTimer = window.setTimeout(() => t.classList.remove('on'), 1800); }

    function load() {
      const q = new URLSearchParams(location.search), g = q.get('g');
      if (g && DATA.some(d => d.id === g)) state.g = g;
      const gr = group();
      const fromUrl = (q.get('p') || '').split(',').filter(Boolean).filter(id => byId(gr, id)).slice(0, MAX);
      if (fromUrl.length) state.sel = fromUrl;
      else {
        let stored: { g?: string; ids?: string[] } = {};
        try { stored = JSON.parse(sessionStorage.getItem(KEY) || '{}'); } catch (e) { /* ignore */ }
        if (!q.get('g') && stored.g && DATA.some(d => d.id === stored.g) && stored.ids && stored.ids.length) {
          state.g = stored.g; state.sel = stored.ids.filter(id => byId(group(), id)).slice(0, MAX);
        }
        if (!state.sel.length) state.sel = group().items.slice(0, 2).map(i => i.id);
      }
    }
    function url() {
      const p = new URLSearchParams(); p.set('g', state.g);
      if (state.sel.length) p.set('p', state.sel.join(','));
      return location.origin + location.pathname + '?' + p.toString();
    }
    function sync() {
      try { history.replaceState(null, '', url()); } catch (e) { /* ignore */ }
      try { sessionStorage.setItem(KEY, JSON.stringify({ g: state.g, ids: state.sel, m: Object.fromEntries(picked().map(i => [i.id, i.model])) })); } catch (e) { /* ignore */ }
      window.dispatchEvent(new Event('cie-compare-change'));
    }

    function renderGroups() {
      $('cmp-groups').innerHTML = DATA.map(g => `<button type="button" class="cmp-pill" data-g="${esc(g.id)}" aria-pressed="${g.id === state.g}">${esc(g.label)} <i>${g.items.length}</i></button>`).join('');
      $('cmp-blurb').textContent = group().blurb;
    }
    function renderPicker() {
      const g = group(), q = state.q.trim().toLowerCase();
      const items = g.items.filter(i => !q || (i.model + ' ' + i.name + ' ' + i.brand).toLowerCase().includes(q));
      $('cmp-count').textContent = `(${state.sel.length} of ${MAX} chosen)`;
      $('cmp-picker').innerHTML = items.length ? items.map(i => {
        const on = state.sel.includes(i.id), full = !on && state.sel.length >= MAX;
        return `<button type="button" class="cmp-card${on ? ' on' : ''}" data-id="${esc(i.id)}" aria-pressed="${on}"${full ? ' disabled' : ''}>
          <span class="cmp-tick" aria-hidden="true">${on ? '✓' : ''}</span>
          ${i.img ? `<img src="${esc(i.img)}" alt="" width="64" height="64" loading="lazy" />` : '<span class="cmp-noimg"></span>'}
          <span class="cmp-cm"><b>${esc(i.model)}</b><small>${esc(i.brand)}</small></span></button>`;
      }).join('') : '<p class="cmp-none">No model matches that search.</p>';
      ($('cmp-find') as HTMLInputElement).style.display = g.items.length > 6 ? '' : 'none';
    }

    function tr(r: RowOut, cls = '') {
      return `<tr class="${cls}${rowDiffers(r.vals) ? ' is-diff' : ''}"><th scope="row">${esc(r.label)}</th>${r.vals.map(v =>
        v === null ? '<td class="cmp-na">-</td>' : `<td>${esc(v).replace(/ \| /g, '<br>')}</td>`).join('')}</tr>`;
    }

    function render() {
      const g = group(), items = picked(), ok = items.length >= 2;
      ['cmp-empty'].forEach(id => ($(id).hidden = ok));
      ['cmp-wrap', 'cmp-bar', 'cmp-help'].forEach(id => ($(id).hidden = !ok));
      $('cmp-more').hidden = true;
      if (!ok) return;

      const { rows, more } = buildRows(g.rows, items);
      const keyRows = g.rows.length ? rows : more; // groups without tuned rows: everything is a key row
      const extra = g.rows.length ? more : [];

      const head = `<thead><tr><th class="cmp-corner"></th>${items.map(it => `<th scope="col" class="cmp-h"><button type="button" class="cmp-x cmp-noprint" data-rm="${esc(it.id)}" aria-label="Remove ${esc(it.model)}">×</button>
        ${it.img ? `<img src="${esc(it.img)}" alt="${esc(it.model)}" width="120" height="120" />` : ''}
        <span class="cmp-brand">${esc(it.brand)}</span><a class="cmp-model" href="${esc(it.href)}">${esc(it.model)}</a><span class="cmp-name">${esc(it.name)}</span><a class="cmp-view cmp-noprint" href="${esc(it.href)}">View details →</a></th>`).join('')}</tr></thead>`;

      $('cmp-table').innerHTML = head + `<tbody>${keyRows.map(r => tr(r)).join('')}</tbody>` +
        (extra.length ? `<tbody class="cmp-extra"${showMore ? '' : ' hidden'}>${extra.map(r => tr(r)).join('')}</tbody>` : '');
      ($('cmp-table') as HTMLElement).style.setProperty('--n', String(items.length));

      const mb = $('cmp-more');
      if (extra.length) { mb.hidden = false; mb.textContent = `${showMore ? 'Hide' : 'Show'} ${extra.length} more specification${extra.length === 1 ? '' : 's'}`; mb.setAttribute('aria-expanded', String(showMore)); }

      const names = items.map(i => i.model).join(', ');
      const wa = $('cmp-wa') as HTMLAnchorElement;
      wa.href = `https://wa.me/${wa.dataset.wa}?text=${encodeURIComponent(`Hi, I am comparing ${names} and have a question. ${url()}`)}`;
    }

    function all() { renderGroups(); renderPicker(); render(); sync(); }
    function light() { renderPicker(); render(); sync(); }

    $('cmp-groups').addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest('[data-g]') as HTMLElement | null; if (!b) return;
      state.g = b.dataset.g!; state.q = ''; ($('cmp-find') as HTMLInputElement).value = '';
      state.sel = group().items.slice(0, 2).map(i => i.id); showMore = false; all();
    });
    $('cmp-find').addEventListener('input', e => { state.q = (e.target as HTMLInputElement).value; renderPicker(); });
    $('cmp-picker').addEventListener('click', e => {
      const b = (e.target as HTMLElement).closest('[data-id]') as HTMLButtonElement | null; if (!b || b.disabled) return;
      const id = b.dataset.id!, i = state.sel.indexOf(id);
      if (i >= 0) state.sel.splice(i, 1); else if (state.sel.length < MAX) state.sel.push(id);
      light();
    });
    $('cmp-table').addEventListener('click', e => {
      const x = (e.target as HTMLElement).closest('[data-rm]') as HTMLElement | null; if (!x) return;
      state.sel = state.sel.filter(id => id !== x.dataset.rm); light();
    });
    $('cmp-hl').addEventListener('change', e => $('cmp-table').classList.toggle('hl', (e.target as HTMLInputElement).checked));
    $('cmp-clear').addEventListener('click', () => { state.sel = []; light(); });
    $('cmp-more').addEventListener('click', () => { showMore = !showMore; render(); });
    $('cmp-share').addEventListener('click', () => {
      (navigator.clipboard ? navigator.clipboard.writeText(url()) : Promise.reject()).then(() => say('Link copied'), () => say('Link is in the address bar'));
    });

    load(); all();
  </script>
</Base>

<style is:global>
  .cmp-crumbs .text-ink { color: #fff; }
  .cmp-step { display: flex; align-items: center; gap: .6rem; margin: 0 0 .8rem; font-weight: 700; color: var(--color-ink); font-size: 1.02rem; }
  .cmp-step span { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: .5rem; background: var(--color-red); color: #fff; font-family: var(--font-mono); font-size: .78rem; }
  .cmp-step em { font-style: normal; font-weight: 500; font-size: .85rem; color: var(--color-muted); }
  .cmp-pills { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cmp-pill { padding: .55rem 1rem; font-size: .88rem; font-weight: 600; border: 1px solid var(--color-border); border-radius: 999px; background: #fff; color: var(--color-ink); cursor: pointer; transition: all .18s; }
  .cmp-pill i { font-style: normal; font-family: var(--font-mono); font-size: .72rem; opacity: .6; margin-left: .25rem; }
  .cmp-pill:hover { border-color: var(--color-red); }
  .cmp-pill[aria-pressed="true"] { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  .cmp-need { padding: .45rem .9rem; font-size: .84rem; font-weight: 600; border: 1px dashed #b9c0cc; border-radius: 999px; background: #fff; color: var(--color-ink); cursor: pointer; transition: all .15s; }
  .cmp-need span { font-family: var(--font-mono); margin-right: .15rem; color: var(--color-muted); }
  .cmp-need:hover { border-color: var(--color-red); }
  .cmp-need[aria-pressed="true"] { border-style: solid; border-color: var(--color-red); background: #fff1f1; color: #8f1219; }
  .cmp-need[aria-pressed="true"] span { color: var(--color-red); }
  .cmp-blurb { margin: .7rem 0 0; font-size: .9rem; color: var(--color-muted); }

  .cmp-picktools { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .8rem; align-items: center; }
  .cmp-picktools input { flex: 0 1 16rem; height: 2.5rem; padding: 0 .9rem; border: 1px solid var(--color-border); border-radius: .7rem; font-size: .9rem; }
  .cmp-picktools input:focus { outline: 2px solid var(--color-red); outline-offset: 1px; }
  .cmp-picker { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .6rem; }
  .cmp-none { color: var(--color-muted); font-size: .9rem; }
  .cmp-card { position: relative; display: flex; align-items: center; gap: .8rem; padding: .6rem .8rem; text-align: left; border: 1px solid var(--color-border); border-radius: .9rem; background: #fff; cursor: pointer; transition: all .15s; min-width: 0; }
  .cmp-card:hover:not(:disabled) { border-color: #b9c0cc; }
  .cmp-card.on { border-color: var(--color-red); background: #fff6f6; box-shadow: 0 0 0 3px rgba(224,37,46,.12); }
  .cmp-card:disabled { opacity: .45; cursor: not-allowed; }
  .cmp-card:focus-visible, .cmp-pill:focus-visible, .cmp-need:focus-visible, .cmp-btn:focus-visible, .cmp-more:focus-visible { outline: 2px solid var(--color-red); outline-offset: 2px; }
  .cmp-card img, .cmp-noimg { width: 3rem; height: 3rem; object-fit: contain; flex: none; border-radius: .5rem; background: var(--color-cloud); }
  .cmp-cm { display: flex; flex-direction: column; min-width: 0; }
  .cmp-cm b { font-size: .92rem; color: var(--color-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmp-cm small { font-family: var(--font-mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  .cmp-tick { position: absolute; top: .45rem; right: .55rem; font-size: .8rem; font-weight: 800; color: var(--color-red); }

  .cmp-bar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin: 1.6rem 0 .8rem; }
  .cmp-bar[hidden], .cmp-wrap[hidden], .cmp-more[hidden], .cmp-extra[hidden], .cmp-help[hidden] { display: none; }
  .cmp-hl { display: inline-flex; align-items: center; gap: .5rem; font-size: .88rem; font-weight: 600; color: var(--color-ink); cursor: pointer; margin-right: .4rem; }
  .cmp-hl input { width: 1.05rem; height: 1.05rem; accent-color: var(--color-red); }
  .cmp-btn { display: inline-flex; align-items: center; padding: .5rem .95rem; font-size: .82rem; font-weight: 700; border: 1px solid var(--color-border); border-radius: .6rem; background: var(--color-cloud); color: var(--color-ink); cursor: pointer; }
  .cmp-btn:hover { border-color: var(--color-red); color: var(--color-red); }
  .cmp-btn--red { background: var(--color-red); border-color: var(--color-red); color: #fff; }
  .cmp-btn--red:hover { filter: brightness(.92); color: #fff; }
  .cmp-btn--wa { background: #16a34a; border-color: #16a34a; color: #fff; }
  .cmp-btn--wa:hover { filter: brightness(.92); color: #fff; }
  .cmp-empty { margin-top: 1.6rem; padding: 2rem; text-align: center; border: 1px dashed var(--color-border); border-radius: 1rem; color: var(--color-muted); }
  .cmp-empty[hidden] { display: none; }


  .cmp-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: 1rem; background: #fff; -webkit-overflow-scrolling: touch; }
  .cmp-table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: calc(7rem + var(--n, 2) * 13rem); table-layout: fixed; }
  .cmp-table th, .cmp-table td { padding: .7rem .9rem; border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: top; font-size: .86rem; line-height: 1.5; overflow-wrap: anywhere; }
  .cmp-table tbody th { position: sticky; left: 0; z-index: 1; width: 7rem; background: var(--color-cloud); font-family: var(--font-mono); font-size: .7rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-ink); }
  .cmp-corner { position: sticky; left: 0; z-index: 2; width: 7rem; background: #fff; }
  .cmp-table td + td, .cmp-table th.cmp-h + th.cmp-h { border-left: 1px solid var(--color-border); }
  .cmp-h { position: relative; background: #fff; text-align: center !important; padding-top: 1.2rem !important; }
  .cmp-h img { display: block; margin: 0 auto .5rem; width: 6.5rem; height: 6.5rem; object-fit: contain; }
  .cmp-brand { display: block; font-family: var(--font-mono); font-size: .64rem; letter-spacing: .14em; text-transform: uppercase; color: var(--color-muted); }
  .cmp-model { display: block; font-size: 1.1rem; font-weight: 800; color: var(--color-ink); }
  .cmp-model:hover { color: var(--color-red); }
  .cmp-name { display: block; margin-top: .2rem; font-size: .76rem; font-weight: 400; color: var(--color-muted); line-height: 1.35; }
  .cmp-view { display: inline-block; margin-top: .55rem; font-size: .8rem; font-weight: 700; color: var(--color-red); }
  .cmp-view:hover { text-decoration: underline; }
  .cmp-x { position: absolute; top: .35rem; right: .45rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; font-size: 1rem; line-height: 1; color: var(--color-muted); background: var(--color-cloud); cursor: pointer; }
  .cmp-x:hover { background: var(--color-red); color: #fff; }
  .cmp-na { color: #9aa3af; font-style: italic; }
  .cmp-table.hl tr.is-diff td { background: #fff9ec; }
  .cmp-table.hl tr.is-diff th { box-shadow: inset 3px 0 0 #f59e0b; }
  .cmp-more { margin-top: .9rem; padding: .6rem 1.1rem; font-size: .86rem; font-weight: 600; border: 1px solid var(--color-border); border-radius: .7rem; background: #fff; cursor: pointer; }
  .cmp-more:hover { border-color: var(--color-red); color: var(--color-red); }
  .cmp-help { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.6rem; padding: 1.2rem 1.4rem; border-radius: 1rem; background: var(--color-ink); color: #fff; }
  .cmp-help-h { margin: 0; font-weight: 800; font-size: 1.05rem; }
  .cmp-help-p { margin: .25rem 0 0; font-size: .88rem; color: #aeb7c2; max-width: 34rem; }
  .cmp-help-btns { display: flex; flex-wrap: wrap; gap: .6rem; }
  .cmp-note { margin-top: 1.6rem; max-width: 52rem; font-size: .82rem; line-height: 1.6; color: var(--color-muted); }

  #cmp-toast { position: fixed; left: 50%; bottom: 1.5rem; transform: translate(-50%, 1rem); padding: .6rem 1.1rem; border-radius: 999px; background: var(--color-ink); color: #fff; font-size: .85rem; font-weight: 600; opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s; z-index: 60; }
  #cmp-toast.on { opacity: 1; transform: translate(-50%, 0); }
  @media (max-width: 640px) { .cmp-table th, .cmp-table td { padding: .55rem .6rem; font-size: .8rem; } .cmp-table tbody th, .cmp-corner { width: 5.6rem; } .cmp-table { min-width: calc(5.6rem + var(--n, 2) * 11rem); } }
</style>
