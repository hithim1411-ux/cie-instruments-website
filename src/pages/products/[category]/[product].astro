---
import Base from '../../../layouts/Base.astro';
import { u } from '../../../utils/url';
import EyebrowLabel from '../../../components/EyebrowLabel.astro';
import SpecTable from '../../../components/SpecTable.astro';
import CTABand from '../../../components/CTABand.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Badge from '../../../components/Badge.astro';
import Icon from '../../../components/Icon.astro';
import ProductCard from '../../../components/ProductCard.astro';
import categories from '../../../data/categories.json';
import products from '../../../data/products.json';
import site from '../../../data/site.json';

// Related categories: instrument families that are commonly specified together,
// used to fill out "Related Products" when a category has few other SKUs of its own.
const relatedCategoryGroups: string[][] = [
  ['insulation-testers-hand', 'multirange-insulation-hand', 'motor-operated-insulation', 'multirange-motorised-insulation', 'compact-insulation-testers', 'digital-insulation-testers'],
  ['earth-tester', 'digital-earth-micro-ohm'],
  ['hv-phase-sequence', 'phase-sequence-indicators'],
  ['clamp-meters', 'multimeters'],
];

export async function getStaticPaths() {
  return products.map(p => {
    const category = categories.find(c => c.id === p.categoryId)!;
    return {
      params: { category: p.categoryId, product: p.id },
      props: { product: p, category },
    };
  });
}

const { product, category } = Astro.props;

const waMsg = encodeURIComponent(`Hi, I'd like to enquire about the ${product.model} — ${product.name}. Please send me a quote.`);

const isVartech = (product as any).brand === 'vartech';

// Support images array (multiple images) or fall back to single image / default
const productImages: string[] = (() => {
  const imgs = (product as any).images as string[] | undefined;
  if (imgs && imgs.length > 0) {
    return imgs.map(img => isVartech ? u(`/images/${img}`) : u(`/images/products/${img}`));
  }
  if (product.image) {
    return [isVartech ? u(`/images/${product.image}`) : u(`/images/products/${product.image}`)];
  }
  return [u(`/images/products/${product.id}.webp`)];
})();
const productImageSrc = productImages[0];

// Build product-specific mailto
const quoteSubject = `Quote Request — ${product.model}`;
const quoteBody    = `Hello CIE team,\n\nI would like to request a quote for: ${product.model} — ${product.name}.\n\nRequired rated voltage / resistance range:\nQuantity:\n\nName:\nCompany:\nPhone:\nCity / State:\n\nThank you.`;
const quoteMailto  = `mailto:cieinstruments@gmail.com?subject=${encodeURIComponent(quoteSubject)}&body=${encodeURIComponent(quoteBody)}`;

// Product structured data for Google
const productImageAbsolute = `https://www.cieinstruments.in/images/products/${product.image ?? product.id + '.webp'}`;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${product.model} — ${product.name}`,
  description: product.tagline,
  image: productImageAbsolute,
  brand: {
    '@type': 'Brand',
    name: 'CIE',
  },
  manufacturer: {
    '@type': 'Organization',
    '@id': 'https://www.cieinstruments.in/#organization',
    name: 'Cambridge Instruments & Engg. Co.',
  },
  model: product.model,
  countryOfOrigin: 'IN',
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    url: `https://www.cieinstruments.in/products/${product.categoryId}/${product.id}/`,
    seller: { '@id': 'https://www.cieinstruments.in/#organization' },
  },
  ...(product.specs && product.specs.length > 0 && {
    additionalProperty: product.specs.map((s: { label: string; value: string }) => ({
      '@type': 'PropertyValue',
      name: s.label,
      value: s.value,
    })),
  }),
};

const autoTitle = `${product.model} — ${product.name}`;
const autoDesc  = `${product.model} ${product.name} — ${product.tagline} Manufactured by Cambridge Instruments & Engg. Co., Howrah, India. 12-month warranty.`;
const pageTitle       = (product as any).metaTitle ?? autoTitle;
const pageDescription = (product as any).metaDesc  ?? autoDesc;
const useRawTitle     = !!(product as any).metaTitle;

// Related products: same category first, then the wider instrument family, capped at 3.
const myGroup = relatedCategoryGroups.find(g => g.includes(product.categoryId));
const relatedPool = (products as any[]).filter(p =>
  p.id !== product.id &&
  (p.categoryId === product.categoryId || (myGroup && myGroup.includes(p.categoryId)))
);
const relatedProducts = [
  ...relatedPool.filter(p => p.categoryId === product.categoryId),
  ...relatedPool.filter(p => p.categoryId !== product.categoryId),
].slice(0, 3);
---

<Base
  title={pageTitle}
  description={pageDescription}
  rawTitle={useRawTitle}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <!-- Page header -->
  <div class={isVartech ? 'bg-emerald-50 border-b border-emerald-200 py-10' : 'bg-cloud border-b border-border py-10'}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[
        { label: 'Products', href: '/products' },
        { label: category.name, href: `/products/${category.id}` },
        { label: product.model },
      ]} />
      {isVartech ? (
        <div class="mt-4 mb-3 flex items-center gap-3">
          <img src={u('/images/vartech/vartech-logo.avif')} alt="Vartech" width="90" class="object-contain" />
          <Badge variant="emerald">CIE Authorised Dealer</Badge>
        </div>
      ) : (
        <EyebrowLabel text={category.eyebrow} class="mt-4 mb-3" />
      )}
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">
        <span class="model-code text-xl block mb-1">{product.model}</span>
        {product.name}
      </h1>
      <p class="mt-3 text-muted max-w-2xl">{product.tagline}</p>
    </div>
  </div>

  <!-- Main content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 section-pad-sm">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- ── Left sidebar: image + CTAs + trust ── -->
      <div class="lg:col-span-1">

        <!-- Product image / gallery -->
        {!product.hideImage && (
          <div>
            <div class="bg-cloud border border-border rounded-xl overflow-hidden mb-3">
              <img
                id="gallery-main"
                src={productImageSrc}
                alt={`${product.model} — ${product.name}`}
                width="600"
                height="600"
                class="w-full object-contain h-64 lg:h-72 p-4"
                loading="eager"
                onerror="this.style.opacity='0.15'"
              />
            </div>
            {productImages.length > 1 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {productImages.map((src, i) => (
                  <button
                    type="button"
                    data-src={src}
                    data-alt={`${product.model} — image ${i + 1}`}
                    class:list={['gallery-thumb w-16 h-16 rounded-lg border-2 overflow-hidden bg-cloud transition-all', i === 0 ? 'border-ink' : 'border-border hover:border-ink/50']}
                    aria-label={`View image ${i + 1}`}
                  >
                    <img src={src} alt="" aria-hidden="true" width="64" height="64" class="w-full h-full object-contain p-1" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- CTAs -->
        <div class="space-y-3">
          <a href={quoteMailto} class="btn-primary w-full">
            <Icon name="mail" class="w-4 h-4 shrink-0" />
            Request a Quote
          </a>
          <a
            href={`https://wa.me/${site.whatsapp}?text=${waMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary w-full text-ink"
          >
            <Icon name="message-circle" class="w-4 h-4 shrink-0" />
            Enquire on WhatsApp
          </a>
        </div>

        <!-- Trust signals -->
        <div class="mt-6 bg-cloud rounded-lg p-4 border border-border">
          <p class="text-xs font-mono font-bold text-ink uppercase tracking-widest mb-3">CIE® Guarantee</p>
          <ul class="space-y-2">
            {['CIE® Registered Trade Mark', 'Calibrated Before Despatch', '12-Month Warranty', 'Made in India', 'Custom Ranges Available'].map(f => (
              <li class="flex items-center gap-2 text-xs text-muted">
                <span class="w-1.5 h-1.5 rounded-full bg-red shrink-0"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- ── Right: full product info ── -->
      <div class="lg:col-span-2 space-y-10">

        <!-- 1. Description -->
        <div>
          <h2 class="text-xl font-bold text-ink mb-3">About This Instrument</h2>
          <p class="text-muted leading-relaxed">{product.description}</p>
        </div>

        <!-- 1b. Key Features (optional) -->
        {product.features && (product.features as string[]).length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-ink mb-4">Key Features</h2>
            <ul class="space-y-2">
              {(product.features as string[]).map((f: string) => (
                <li class="flex items-start gap-3 text-sm text-muted">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-ink shrink-0"></span>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- 2. Technical Specifications -->
        <div>
          <h2 class="text-xl font-bold text-ink mb-4">Technical Specifications</h2>
          <SpecTable specs={product.specs} />

          <!-- Build-to-order notice -->
          {product.buildToOrder && product.orderNote && (
            <div class="mt-5 flex gap-3 bg-red/5 border border-red/20 rounded-lg p-4">
              <span class="shrink-0 text-red mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </span>
              <div>
                <p class="text-xs font-bold text-red uppercase tracking-wide mb-0.5">Build to Order</p>
                <p class="text-sm text-ink">{product.orderNote}</p>
              </div>
            </div>
          )}

          <!-- Ordering combination / capability tables -->
          {product.specTables && (product.specTables as any[]).map((table: any) => (
            <div class="mt-6">
              {table.heading && (
                <h3 class="text-sm font-bold text-ink uppercase tracking-wide mb-3">{table.heading}</h3>
              )}
              <div class="overflow-x-auto rounded border border-border">
                <table class="spec-table w-full text-left border-collapse">
                  <thead>
                    <tr>
                      {(table.columns as string[]).map((col: string) => (
                        <th>{col}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {(table.rows as any[]).map((row: any) => (
                      <tr>
                        {(table.columns as string[]).map((_: string, i: number) => (
                          <td class:list={[
                            row[`col${i}`] === 'N.A.' && 'text-muted italic',
                            row[`col${i}`] === '✓'    && 'text-[#16a34a] font-bold text-center',
                          ]}>
                            {row[`col${i}`]}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {table.note && (
                <p class="mt-2 text-xs text-muted italic">{table.note}</p>
              )}
            </div>
          ))}

          <!-- Additional ordering options -->
          {product.options && (product.options as string[]).length > 0 && (
            <div class="mt-5 bg-cloud rounded-lg border border-border p-4">
              <p class="text-xs font-bold text-ink uppercase tracking-wide mb-2">Additional Options</p>
              <ul class="space-y-1.5">
                {(product.options as string[]).map((opt: string) => (
                  <li class="flex items-start gap-2 text-sm text-muted">
                    <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red shrink-0"></span>
                    {opt}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- 3. What's Included (kit / accessories) -->
        {product.includedWith && (product.includedWith as string[]).length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-ink mb-4">What's Included</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {(product.includedWith as string[]).map((item: string) => (
                <li class="flex items-start gap-2.5 text-sm text-muted bg-cloud border border-border rounded-lg px-4 py-2.5">
                  <span class="mt-1 w-1.5 h-1.5 rounded-full bg-ink shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- 4. Applications -->
        {product.applications && product.applications.length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-ink mb-4">Key Applications</h2>
            <ul class="space-y-2">
              {product.applications.map((app: string) => (
                <li class="flex items-start gap-3 text-sm text-muted">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red shrink-0"></span>
                  {app}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- 5. Warranty & after-sales -->
        <div class="bg-cloud border-l-4 border-ink rounded-r-lg p-5">
          <p class="text-sm text-ink font-semibold mb-1">12-Month Warranty · Direct After-Sales Support</p>
          <p class="text-sm text-muted">
            Every CIE® instrument carries a 12-month warranty against manufacturing defects.
            After-sales support is handled directly by CIE — not a distributor network.
            Non-standard ranges or custom specifications can be manufactured to your requirement.
          </p>
        </div>

      </div>
    </div>
  </div>

  <script>
  {
    const mainImg = document.getElementById('gallery-main') as HTMLImageElement | null;
    const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');
    thumbs.forEach(btn => {
      btn.addEventListener('click', () => {
        if (!mainImg) return;
        mainImg.src = btn.dataset.src ?? '';
        mainImg.alt = btn.dataset.alt ?? '';
        thumbs.forEach(t => t.classList.replace('border-ink', 'border-border'));
        btn.classList.replace('border-border', 'border-ink');
      });
    });
  }
  </script>

  {relatedProducts.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <h2 class="text-xl font-bold text-ink mb-6">Related Products</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedProducts.map((p: any) => (
          <ProductCard
            model={p.model}
            name={p.name}
            tagline={p.tagline}
            categoryId={p.categoryId}
            id={p.id}
            image={p.image}
          />
        ))}
      </div>
    </div>
  )}

  <CTABand
    heading={`Interested in the ${product.model}? Get a quote by email.`}
    body="Email us with your model, quantity, and specification — we respond within one business day."
    primaryLabel="Request a Quote"
    primaryHref={quoteMailto}
    secondaryLabel="Back to Products"
    secondaryHref={u(`/products/${category.id}/`)}
  />
</Base>
