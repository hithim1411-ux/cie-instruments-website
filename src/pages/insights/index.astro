---
import Base from '../../layouts/Base.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../utils/url';
import { tools } from '../../data/tools';
import posts from '../../data/blog.json';

const sorted = [...posts].sort((a, b) => b.publishDate.localeCompare(a.publishDate));
const bySlug = Object.fromEntries(posts.map((p) => [p.slug, p]));
const toolBySlug = Object.fromEntries(tools.map((t) => [t.slug, t]));
const latest = sorted.slice(0, 3);
const portalPosts = sorted.slice(0, 3);
const featuredTools = [...tools.filter((t) => t.isNew), ...tools.filter((t) => !t.isNew)].slice(0, 4);
const fmt = (d: string) => new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

// Subject shelves (same ids as the blog library) with counts, for the topic grid.
const SHELVES = [
  { id: 'physics', label: 'Physics and fundamentals', blurb: 'Ohm’s law, AC/DC, ratings and specs.', icon: 'zap' },
  { id: 'multimeters', label: 'Multimeters', blurb: 'Choosing and using the essential tool.', icon: 'gauge' },
  { id: 'clamp-meters', label: 'Clamp meters', blurb: 'Current without breaking the circuit.', icon: 'circle-dot' },
  { id: 'insulation-earthing', label: 'Insulation and earthing', blurb: 'Meggers, earth testers, motor tests.', icon: 'shield-check' },
  { id: 'scopes-signal', label: 'Scopes and signals', blurb: 'Waveforms, generators, LCR meters.', icon: 'activity' },
  { id: 'power-supplies', label: 'Power supplies and loads', blurb: 'Linear, SMPS and programmable.', icon: 'plug' },
  { id: 'calibration', label: 'Calibration', blurb: '4-20 mA loops and intervals.', icon: 'settings' },
  { id: 'environmental', label: 'Environmental', blurb: 'Light, sound, airflow, temperature.', icon: 'wind' },
  { id: 'power-quality', label: 'Power quality', blurb: 'Phase sequence, harmonics, PF.', icon: 'waves' },
  { id: 'relay-hv', label: 'Relay and HV testing', blurb: 'Protection relays, dielectric tests.', icon: 'flask' },
  { id: 'bench-tools', label: 'Bench and repair', blurb: 'Soldering, fuses, batteries.', icon: 'wrench' },
] as const;
const shelfCounts = Object.fromEntries(SHELVES.map((s) => [s.id, posts.filter((p: any) => p.shelf === s.id).length]));
const shelfLabel = Object.fromEntries(SHELVES.map((s) => [s.id, s.label]));

// Curated learning paths: an ordered reading list + the matching tools and instruments.
const PATHS = [
  {
    id: 'insulation', icon: 'shield-check', label: 'Test motor insulation',
    pitch: 'From what a megger measures to reading PI and DAR like a pro.',
    steps: ['insulation-resistance-testing-guide', 'what-is-a-megger', 'insulation-resistance-temperature-correction', 'polarization-index-vs-dielectric-absorption-ratio'],
    tools: ['ir-temperature-correction-calculator', 'pi-dar-calculator', 'motor-minimum-insulation-resistance'],
    product: { label: 'Insulation testers', href: '/products/insulation-testers-hand/' },
  },
  {
    id: 'earthing', icon: 'globe', label: 'Check an earth pit',
    pitch: 'Why earthing matters, how low is low enough, and how to test soil.',
    steps: ['what-is-electrical-earthing', 'earth-resistance-testing-guide', 'how-low-should-earth-resistance-be', 'soil-resistivity-wenner-vs-schlumberger'],
    tools: ['soil-resistivity-wenner-calculator', 'earth-rod-resistance-calculator'],
    product: { label: 'Earth testers', href: '/products/earth-tester/' },
  },
  {
    id: 'meters', icon: 'gauge', label: 'Pick the right meter',
    pitch: 'Multimeter or clamp? True RMS or not? Decide with confidence.',
    steps: ['what-is-a-multimeter', 'how-to-choose-a-multimeter', 'clamp-meter-vs-multimeter', 'true-rms-vs-average-rms'],
    tools: ['multimeter-accuracy-calculator', 'ohms-law-calculator'],
    product: { label: 'Multimeters', href: '/products/multimeters/' },
  },
  {
    id: 'scopes', icon: 'activity', label: 'Learn the oscilloscope',
    pitch: 'Controls, waveforms, bandwidth and what to buy.',
    steps: ['how-to-use-an-oscilloscope', 'oscilloscope-waveform-guide', 'oscilloscope-bandwidth-explained', 'how-to-choose-an-oscilloscope'],
    tools: ['oscilloscope-reading-calculator', 'oscilloscope-bandwidth-calculator'],
    product: { label: 'Vartech oscilloscopes', href: '/products/vartech-oscilloscopes/' },
  },
].map((p) => ({
  ...p,
  guides: p.steps.map((s) => bySlug[s]).filter(Boolean),
  toolItems: p.tools.map((t) => toolBySlug[t]).filter(Boolean),
}));

const TOPIC_CHIPS = ['insulation', 'earthing', 'multimeter', 'clamp meter', 'oscilloscope', 'calibration', 'relay', 'power supply'];

// Compact search index sent to the browser (titles + short excerpt for matching).
const searchData = {
  base: u('/'),
  guides: posts.map((p: any) => ({ t: p.title, u: `/blog/${p.slug}/`, c: p.category, s: shelfLabel[p.shelf] ?? '', x: (p.excerpt ?? '').slice(0, 140) })),
  tools: tools.map((t) => ({ t: t.name, u: `/tools/${t.slug}/`, c: t.category, x: t.body })),
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Insights - Technical Guides and Free Calculators',
  url: 'https://www.cieinstruments.in/insights/',
  description: `${posts.length} technical guides and ${tools.length} free calculators from Cambridge Instruments & Engg. Co., Howrah.`,
  isPartOf: { '@id': 'https://www.cieinstruments.in/#website' },
};
---

<Base
  title="Insights - Technical Guides and Free Calculators"
  description={`${posts.length} technical guides on test instruments and ${tools.length} free electrical testing calculators, plus the CIE podcast, from the team that has built insulation and earth testers in Howrah since 1963.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script id="ins-data" type="application/json" set:html={JSON.stringify(searchData)} />

  <!-- ══ Hero: search + live mini calculator ══ -->
  <div class="blueprint-bg bg-ink text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-28 lg:pb-32">
      <nav aria-label="Breadcrumb" class="mb-7">
        <ol class="flex items-center gap-2 text-xs text-muted-dark font-mono">
          <li><a href={u('/')} class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-white/30">›</li>
          <li class="text-white/80" aria-current="page">Insights</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-7 min-w-0">
          <p class="eyebrow mb-4">Insights</p>
          <h1 class="text-[length:var(--text-display)] font-extrabold leading-[1.06] tracking-tight">
            Learn it. Calculate it.<br />
            <span class="text-muted-dark">Then measure it right.</span>
          </h1>
          <p class="mt-5 text-gray-300 text-body-lg max-w-xl leading-relaxed">
            Practical guides, free calculators and a podcast from the people who have been building test instruments in Howrah since 1963.
          </p>

          <!-- Live search -->
          <div class="ins-search mt-8" id="ins-search">
            <label for="ins-q" class="sr-only">Search guides and calculators</label>
            <div class="ins-search__box">
              <svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input id="ins-q" type="search" autocomplete="off" spellcheck="false" placeholder={`Search ${posts.length} guides and ${tools.length} calculators`} aria-controls="ins-results" aria-expanded="false" />
              <kbd class="hidden sm:inline-flex" aria-hidden="true">/</kbd>
            </div>
            <div class="ins-results" id="ins-results" role="listbox" hidden></div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2" aria-label="Popular topics">
            <span class="font-mono text-[11px] uppercase tracking-widest text-muted-dark mr-1">Try</span>
            {TOPIC_CHIPS.map((c) => <button type="button" class="ins-chip" data-q={c}>{c}</button>)}
          </div>

          <dl class="mt-9 flex flex-wrap gap-x-10 gap-y-4">
            <div><dt class="font-mono text-[11px] uppercase tracking-widest text-muted-dark">Guides</dt><dd class="text-3xl font-bold">{posts.length}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-widest text-muted-dark">Calculators</dt><dd class="text-3xl font-bold">{tools.length}</dd></div>
            <div><dt class="font-mono text-[11px] uppercase tracking-widest text-muted-dark">Topics</dt><dd class="text-3xl font-bold">{SHELVES.length}</dd></div>
          </dl>
        </div>

        <!-- Mini PI / DAR calculator -->
        <aside class="lg:col-span-5 min-w-0" aria-labelledby="mini-title">
          <div class="mini" id="mini">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-dark">Try it now</p>
                <h2 id="mini-title" class="text-xl font-bold">Is this winding healthy?</h2>
              </div>
              <span class="mini__live" aria-hidden="true"><i></i>Live</span>
            </div>
            <p class="mt-2 text-sm text-gray-300 leading-relaxed">Type your timed megger readings. PI and DAR update as you type.</p>

            <div class="mt-4 grid grid-cols-3 gap-3">
              <label class="mini__f"><span>30 s</span><input id="m30" type="number" min="0" step="any" value="800" inputmode="decimal" /><em>MΩ</em></label>
              <label class="mini__f"><span>1 min</span><input id="m60" type="number" min="0" step="any" value="1100" inputmode="decimal" /><em>MΩ</em></label>
              <label class="mini__f"><span>10 min</span><input id="m600" type="number" min="0" step="any" value="2900" inputmode="decimal" /><em>MΩ</em></label>
            </div>

            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Example readings">
              <button type="button" class="ins-chip is-on" data-ex="800,1100,2900">Healthy motor</button>
              <button type="button" class="ins-chip" data-ex="40,44,47">Damp winding</button>
              <button type="button" class="ins-chip" data-ex="1500,2500,12000">Excellent</button>
            </div>

            <div class="mt-5 grid grid-cols-2 gap-3">
              <div class="mini__out"><small>PI</small><b id="o-pi">-</b><span id="v-pi" class="mini__v"></span></div>
              <div class="mini__out"><small>DAR</small><b id="o-dar">-</b><span id="v-dar" class="mini__v"></span></div>
            </div>
            <div class="mini__bar" aria-hidden="true"><i id="bar-pi"></i></div>
            <p class="mini__note" id="mini-note" aria-live="polite"></p>

            <a href={u('/tools/pi-dar-calculator/')} class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-[#FF7A82] transition-colors">
              Open the full calculator <Icon name="arrow" class="w-4 h-4" />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <!-- ══ The two doors ══ -->
  <section class="relative -mt-16 lg:-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:gap-8 md:grid-cols-2" data-reveal-stagger>

        <article class="card flex flex-col p-7 lg:p-9">
          <div class="flex items-center gap-4">
            <span class="grid place-items-center w-12 h-12 rounded-2xl bg-ink text-white shadow-lg" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5Z"/><path d="M4 5.5v16"/><path d="M9 8h7M9 12h5"/></svg>
            </span>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-red">Read</p>
              <h2 class="text-2xl lg:text-3xl font-bold text-ink leading-tight">The Blog</h2>
            </div>
          </div>
          <p class="mt-4 text-muted leading-relaxed">Technical guides on insulation, earthing, multimeters, scopes and more. Written for engineers and electricians who want the reasoning, not just the spec.</p>
          <ul class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
            {portalPosts.map((p) => (
              <li>
                <a href={u(`/blog/${p.slug}/`)} class="group flex items-start justify-between gap-4 py-3.5">
                  <span class="min-w-0">
                    <span class="block font-semibold text-ink group-hover:text-red transition-colors leading-snug">{p.title}</span>
                    <span class="mt-0.5 block font-mono text-[11px] text-muted">{fmt(p.publishDate)} · {p.readTime}</span>
                  </span>
                  <span class="mt-1 shrink-0 text-muted group-hover:text-red group-hover:translate-x-1 transition" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-7">
            <a href={u('/blog/')} class="btn-primary w-full sm:w-auto">Browse all {posts.length} guides <Icon name="arrow" class="w-4 h-4" /></a>
          </div>
        </article>

        <article class="card flex flex-col p-7 lg:p-9">
          <div class="flex items-center gap-4">
            <span class="grid place-items-center w-12 h-12 rounded-2xl bg-red text-white shadow-lg" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2.5" width="14" height="19" rx="2.5"/><path d="M8.5 6.5h7"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01M8.5 14.5h.01M12 14.5h.01M15.5 14.5h.01M8.5 18h.01M12 18h3.5"/></svg>
            </span>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-red">Calculate</p>
              <h2 class="text-2xl lg:text-3xl font-bold text-ink leading-tight">Free Tools</h2>
            </div>
          </div>
          <p class="mt-4 text-muted leading-relaxed">Small, fast calculators for insulation resistance, PI and DAR, motors, cables and power. Open one, type your readings, get a verdict.</p>
          <ul class="mt-6 divide-y divide-ink/10 border-t border-ink/10">
            {featuredTools.map((t) => (
              <li>
                <a href={u(`/tools/${t.slug}/`)} class="group flex items-center gap-4 py-3.5">
                  <span class="grid place-items-center w-9 h-9 shrink-0 rounded-xl bg-ink/[0.06] text-ink group-hover:bg-red group-hover:text-white transition-colors"><Icon name={t.icon} class="w-5 h-5" /></span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-ink group-hover:text-red transition-colors leading-snug">{t.name}</span>
                    <span class="block font-mono text-[11px] text-muted">{t.category}</span>
                  </span>
                  {t.isNew && <span class="badge badge--red">New</span>}
                  <span class="shrink-0 text-muted group-hover:text-red group-hover:translate-x-1 transition" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-7">
            <a href={u('/tools/')} class="btn-secondary w-full sm:w-auto text-ink">Open all {tools.length} calculators <Icon name="arrow" class="w-4 h-4" /></a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ══ Learning paths ══ -->
  <section class="section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">Start here</p>
        <h2 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Pick your job. Follow the path.</h2>
        <p class="mt-3 text-muted leading-relaxed">Not sure where to begin? Each path is an ordered reading list, with the calculators and instruments that go with it.</p>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-12" id="paths">
        <div class="lg:col-span-4 min-w-0" role="tablist" aria-label="Learning paths" aria-orientation="vertical">
          <div class="flex lg:flex-col gap-3 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 -mx-4 px-4 lg:mx-0 lg:px-0 snap-x">
            {PATHS.map((p, i) => (
              <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-path={p.id}
                class="path-tab snap-start shrink-0 lg:shrink text-left">
                <span class="path-tab__ico"><Icon name={p.icon as any} class="w-5 h-5" /></span>
                <span class="min-w-0">
                  <span class="path-tab__t">{p.label}</span>
                  <span class="path-tab__s">{p.guides.length} guides{p.toolItems.length ? ` · ${p.toolItems.length} tools` : ''}</span>
                </span>
              </button>
            ))}
          </div>
        </div>

        <div class="lg:col-span-8 min-w-0">
          {PATHS.map((p, i) => (
            <div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} class="card p-6 lg:p-8" hidden={i !== 0}>
              <p class="text-muted leading-relaxed">{p.pitch}</p>
              <ol class="path-steps mt-6">
                {p.guides.map((g: any, n: number) => (
                  <li>
                    <a href={u(`/blog/${g.slug}/`)} class="group path-step">
                      <span class="path-step__n">{n + 1}</span>
                      <span class="min-w-0 flex-1">
                        <span class="block font-semibold text-ink group-hover:text-red transition-colors leading-snug">{g.title}</span>
                        <span class="mt-0.5 block text-small text-muted line-clamp-2">{g.excerpt}</span>
                        <span class="mt-1 block font-mono text-[11px] text-muted">{g.readTime}</span>
                      </span>
                      <span class="shrink-0 text-muted group-hover:text-red group-hover:translate-x-1 transition mt-1" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>

              {(p.toolItems.length > 0 || p.product) && (
                <div class="mt-6 pt-6 border-t border-ink/10 grid gap-5 sm:grid-cols-2">
                  {p.toolItems.length > 0 && (
                    <div>
                      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted mb-2.5">Calculators for this</p>
                      <div class="flex flex-wrap gap-2">
                        {p.toolItems.map((t: any) => (
                          <a href={u(`/tools/${t.slug}/`)} class="path-pill"><Icon name={t.icon} class="w-4 h-4" />{t.short}</a>
                        ))}
                      </div>
                    </div>
                  )}
                  <div>
                    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted mb-2.5">Instruments</p>
                    <a href={u(p.product.href)} class="path-pill path-pill--red"><Icon name="box" class="w-4 h-4" />{p.product.label}<Icon name="arrow" class="w-4 h-4" /></a>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══ Browse by topic ══ -->
  <section class="section-pad-sm pt-0 lg:pt-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="eyebrow mb-3">Library</p>
          <h2 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Browse by topic</h2>
        </div>
        <a href={u('/blog/')} class="link-arrow text-red hidden sm:inline-flex">Full library <Icon name="arrow" class="w-4 h-4" /></a>
      </div>
      <div class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {SHELVES.map((s) => (
          <a href={u(`/blog/?shelf=${s.id}`)} class="card card-interactive group p-4 sm:p-5 flex flex-col">
            <span class="flex items-center justify-between gap-2">
              <span class="grid place-items-center w-10 h-10 rounded-xl bg-ink/[0.06] text-ink group-hover:bg-red group-hover:text-white transition-colors"><Icon name={s.icon as any} class="w-5 h-5" /></span>
              <span class="badge badge--neutral">{shelfCounts[s.id]} guides</span>
            </span>
            <h3 class="mt-4 font-bold text-ink leading-snug group-hover:text-red transition-colors">{s.label}</h3>
            <p class="mt-1 text-small text-muted leading-relaxed">{s.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ Latest articles ══ -->
  <section class="section-pad-sm pt-0 lg:pt-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6 mb-8">
        <div>
          <p class="eyebrow mb-3">Latest</p>
          <h2 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Fresh from the blog</h2>
        </div>
        <a href={u('/blog/')} class="link-arrow text-red hidden sm:inline-flex">All guides <Icon name="arrow" class="w-4 h-4" /></a>
      </div>
      <div class="grid gap-6 md:grid-cols-3" data-reveal-stagger>
        {latest.map((p) => (
          <a href={u(`/blog/${p.slug}/`)} class="card card-interactive group flex flex-col p-6">
            <span class="badge badge--neutral self-start">{p.category}</span>
            <h3 class="mt-4 text-h4 font-bold text-ink leading-snug group-hover:text-red transition-colors">{p.title}</h3>
            <p class="mt-2 text-small text-muted leading-relaxed line-clamp-3">{p.excerpt}</p>
            <p class="mt-auto pt-5 font-mono text-[11px] text-muted">{fmt(p.publishDate)} · {p.readTime}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ Podcast ══ -->
  <section class="section-pad-sm pt-0 lg:pt-0" id="podcast">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="card p-6 lg:p-10">
        <div class="flex flex-col lg:flex-row lg:items-center gap-10">
          <div class="lg:w-96 shrink-0">
            <div class="flex items-center gap-3 mb-5">
              <span class="w-8 h-0.5 bg-[#1DB954]"></span>
              <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-[#1DB954]">Podcast</p>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-ink leading-snug mb-4">We're on<br />Spotify.</h2>
            <p class="text-muted text-sm leading-relaxed mb-6">
              Deep-dives on measurement instruments, testing methodology and electrical engineering, for engineers and electricians who want more than just a manual.
            </p>
