  /* ── Mini calculator ── */
  .mini { padding: 1.6rem; border-radius: 1.5rem; color: #fff; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.16);
    -webkit-backdrop-filter: var(--glass-blur-lg); backdrop-filter: var(--glass-blur-lg); box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 30px 70px -20px rgba(0,0,0,.6); }
  .mini__live { display: inline-flex; align-items: center; gap: .4rem; font: 700 .65rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: #6ee7b7; }
  .mini__live i { width: .5rem; height: .5rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,.6); animation: mini-pulse 1.8s infinite; }
  @keyframes mini-pulse { 70% { box-shadow: 0 0 0 .5rem rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }
  .mini__f { display: block; padding: .55rem .7rem; border-radius: .9rem; background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.12); transition: border-color .2s, box-shadow .2s; cursor: text; }
  .mini__f:focus-within { border-color: #FF5A62; box-shadow: 0 0 0 3px rgba(224,37,46,.25); }
  .mini__f span { display: block; font: 600 .68rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: #aeb8c6; }
  .mini__f input { width: 100%; background: transparent; border: 0; outline: 0; color: #fff; font: 700 1.25rem var(--font-sans); padding: .1rem 0; -moz-appearance: textfield; }
  .mini__f input::-webkit-outer-spin-button, .mini__f input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .mini__f em { font: normal 500 .7rem var(--font-mono); color: #aeb8c6; }
  .mini__out { padding: .8rem 1rem; border-radius: 1rem; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.1); }
  .mini__out small { display: block; font: 700 .68rem var(--font-mono); letter-spacing: .1em; color: #aeb8c6; }
  .mini__out b { display: block; font: 700 2rem/1.1 var(--font-mono); letter-spacing: -.02em; color: #fff; font-variant-numeric: tabular-nums; }
  .mini__v { display: inline-block; margin-top: .35rem; padding: .15rem .6rem; border-radius: 9999px; font: 700 .72rem var(--font-sans); }
  .mini__v.v-bad { background: #dc2626; color: #fff; } .mini__v.v-warn { background: #fbbf24; color: #0A0E14; }
  .mini__v.v-good { background: #2563eb; color: #fff; } .mini__v.v-great { background: #34d399; color: #04261b; }
  .mini__bar { height: .4rem; margin-top: .9rem; border-radius: 9999px; background: linear-gradient(90deg, #dc2626 0 20%, #fbbf24 20% 40%, #2563eb 40% 80%, #34d399 80% 100%); position: relative; opacity: .9; }
  .mini__bar i { position: absolute; top: -.35rem; width: 3px; height: 1.1rem; margin-left: -1.5px; border-radius: 2px; background: #fff; box-shadow: 0 0 8px #fff; transition: left .35s var(--ease-premium); left: 0; }
  .mini__note { min-height: 1.1rem; margin-top: .6rem; font-size: .8rem; color: #fcd34d; }

  /* ── Learning paths ── */
  .path-tab { display: flex; align-items: center; gap: .9rem; padding: .9rem 1rem; border-radius: 1.1rem; cursor: pointer; min-width: 14.5rem;
    background: var(--glass-fill-soft); box-shadow: var(--glass-rim); color: #0A0E14; border: 0; transition: background .2s, box-shadow .25s, transform .25s var(--ease-premium); }
  .path-tab:hover { background: var(--glass-fill); transform: translateY(-1px); }
  .path-tab[aria-selected='true'] { background: #0A0E14; color: #fff; box-shadow: 0 14px 30px -10px rgba(10,14,20,.5); }
  .path-tab__ico { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; flex-shrink: 0; border-radius: .8rem; background: rgba(10,14,20,.07); }
  .path-tab[aria-selected='true'] .path-tab__ico { background: #CC1F29; color: #fff; }
  .path-tab__t { display: block; font-weight: 700; line-height: 1.2; }
  .path-tab__s { display: block; margin-top: .15rem; font: 500 .7rem var(--font-mono); color: #3F4A5C; }
  .path-tab[aria-selected='true'] .path-tab__s { color: #cbd5e1; }
  .path-steps { list-style: none; padding: 0; margin: 0; counter-reset: s; }
  .path-step { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem .25rem; text-decoration: none; border-top: 1px solid rgba(10,14,20,.08); }
  .path-steps li:first-child .path-step { border-top: 0; }
  .path-step__n { display: grid; place-items: center; flex-shrink: 0; width: 2rem; height: 2rem; border-radius: 50%; font: 700 .8rem var(--font-mono); background: #0A0E14; color: #fff; transition: background .2s; }
  .path-step:hover .path-step__n { background: #CC1F29; }
  .path-pill { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .9rem; border-radius: 9999px; font-size: .85rem; font-weight: 600; color: #0A0E14; text-decoration: none;
    background: var(--glass-fill); box-shadow: var(--glass-rim); transition: background .2s, color .2s, transform .2s; }
  .path-pill:hover { background: #0A0E14; color: #fff; transform: translateY(-1px); }
  .path-pill--red { background: #CC1F29; color: #fff; box-shadow: none; }
  .path-pill--red:hover { background: #A8121B; }
  .path-steps .path-step, .path-tab { -webkit-tap-highlight-color: transparent; }
  [role='tabpanel'] { animation: path-in .35s var(--ease-premium); }
  @keyframes path-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { [role='tabpanel'] { animation: none; } .mini__live i { animation: none; } }
</style>

<script>
  // ── Live search ──────────────────────────────────────────────────────
  type Item = { type: 'g' | 't'; title: string; url: string; meta: string; hay: string };
  const dataEl = document.getElementById('ins-data');
  const input = document.getElementById('ins-q') as HTMLInputElement | null;
  const box = document.getElementById('ins-results');
  if (dataEl && input && box) {
    const raw = JSON.parse(dataEl.textContent || '{}');
    const base: string = raw.base ?? '/';
    const withBase = (p: string) => (base.endsWith('/') ? base.slice(0, -1) : base) + p;
    const items: Item[] = [
      ...raw.guides.map((g: any) => ({ type: 'g' as const, title: g.t, url: g.u, meta: [g.c, g.s].filter(Boolean).join(' · '), hay: `${g.t} ${g.c} ${g.s} ${g.x}`.toLowerCase() })),
      ...raw.tools.map((t: any) => ({ type: 't' as const, title: t.t, url: t.u, meta: t.c, hay: `${t.t} ${t.c} ${t.x}`.toLowerCase() })),
    ];
    let active = -1;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

    function run() {
      const q = input!.value.trim().toLowerCase();
      active = -1;
      if (q.length < 2) { box!.hidden = true; input!.setAttribute('aria-expanded', 'false'); return; }
      const toks = q.split(/\s+/);
      const scored = items
        .filter((i) => toks.every((t) => i.hay.includes(t)))
        .map((i) => {
          const tl = i.title.toLowerCase();
          let s = 0;
          toks.forEach((t) => { if (tl.startsWith(t)) s += 4; else if (tl.includes(t)) s += 3; else s += 1; });
          if (i.type === 't') s += 0.5;
          return { i, s };
        })
        .sort((a, b) => b.s - a.s);
      const top = scored.slice(0, 8);
      box!.innerHTML = top.length
        ? top.map(({ i }, n) => `<a class="ins-r" role="option" id="ins-r-${n}" href="${withBase(i.url)}"><span class="ins-r__tag ins-r__tag--${i.type}">${i.type === 'g' ? 'Guide' : 'Tool'}</span><span class="min-w-0"><span class="ins-r__t">${esc(i.title)}</span><span class="ins-r__m">${esc(i.meta)}</span></span></a>`).join('')
          + (scored.length > 8 ? `<a class="ins-r__more" href="${withBase('/blog/')}?q=${encodeURIComponent(input!.value.trim())}">See all ${scored.length} matches in the library →</a>` : '')
        : `<p class="ins-r__empty">No match for "${esc(input!.value.trim())}". Try a shorter word like "earth" or "motor".</p>`;
      box!.hidden = false;
      input!.setAttribute('aria-expanded', 'true');
    }
    function move(d: number) {
      const rs = Array.from(box!.querySelectorAll<HTMLElement>('.ins-r'));
      if (!rs.length) return;
      active = (active + d + rs.length) % rs.length;
      rs.forEach((r, n) => r.setAttribute('aria-selected', String(n === active)));
      rs[active].scrollIntoView({ block: 'nearest' });
    }
    input.addEventListener('input', run);
    input.addEventListener('focus', run);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') { const r = box!.querySelectorAll<HTMLAnchorElement>('.ins-r'); const t = r[active] ?? r[0]; if (t) { e.preventDefault(); window.location.href = t.href; } }
      else if (e.key === 'Escape') { box!.hidden = true; input!.blur(); }
    });
    document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('#ins-search')) box!.hidden = true; });
    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement?.tagName ?? '').toLowerCase();
      if (e.key === '/' && tag !== 'input' && tag !== 'textarea') { e.preventDefault(); input!.focus(); }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => { input!.value = b.dataset.q ?? ''; input!.focus(); run(); }));
  }

  // ── Mini PI / DAR calculator (same bands as /tools/pi-dar-calculator/) ──
  const g = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const m30 = g('m30'), m60 = g('m60'), m600 = g('m600');
  if (m30 && m60 && m600) {
    const set = (id: string, t: string) => { const el = document.getElementById(id); if (el) el.textContent = t; };
    const verdict = (id: string, cls: string, label: string) => { const el = document.getElementById(id); if (el) { el.className = 'mini__v ' + cls; el.textContent = label; } };
    const clear = (id: string) => { const el = document.getElementById(id); if (el) { el.className = 'mini__v'; el.textContent = ''; } };
    const calc = () => {
      const a = parseFloat(m30.value), b = parseFloat(m60.value), c = parseFloat(m600.value);
      const note = document.getElementById('mini-note'); if (note) note.textContent = '';
      let pi = NaN;
      if (isFinite(b) && isFinite(c) && b > 0 && c >= 0) {
        pi = c / b; set('o-pi', pi.toFixed(2));
        if (pi < 1) verdict('v-pi', 'v-bad', 'Dangerous'); else if (pi < 2) verdict('v-pi', 'v-warn', 'Questionable'); else if (pi < 4) verdict('v-pi', 'v-good', 'Good'); else verdict('v-pi', 'v-great', 'Excellent');
        if (b > 5000 && note) note.textContent = 'Above 5000 MΩ at 1 min, PI may not be meaningful. Judge on absolute IR.';
      } else { set('o-pi', '-'); clear('v-pi'); }
      if (isFinite(a) && isFinite(b) && a > 0 && b >= 0) {
        const d = b / a; set('o-dar', d.toFixed(2));
        if (d < 1) verdict('v-dar', 'v-bad', 'Poor'); else if (d < 1.25) verdict('v-dar', 'v-warn', 'Questionable'); else if (d < 1.6) verdict('v-dar', 'v-good', 'Acceptable'); else verdict('v-dar', 'v-great', 'Excellent');
      } else { set('o-dar', '-'); clear('v-dar'); }
      const pin = document.getElementById('bar-pi'); if (pin) pin.style.left = (isFinite(pi) ? Math.max(0, Math.min(100, (pi / 5) * 100)) : 0) + '%';
    };
    [m30, m60, m600].forEach((el) => el.addEventListener('input', () => { document.querySelectorAll('[data-ex]').forEach((b) => b.classList.remove('is-on')); calc(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-ex]').forEach((b) => b.addEventListener('click', () => {
      const [x, y, z] = (b.dataset.ex ?? '').split(',');
      m30.value = x; m60.value = y; m600.value = z;
      document.querySelectorAll('[data-ex]').forEach((o) => o.classList.toggle('is-on', o === b));
      calc();
    }));
    calc();
  }

  // ── Learning-path tabs (arrow-key accessible) ──
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.path-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  function pick(id: string, focus = false) {
    tabs.forEach((t) => { const on = t.dataset.path === id; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); });
    panels.forEach((p) => { p.hidden = p.id !== `panel-${id}`; });
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(t.dataset.path!));
    t.addEventListener('keydown', (e) => {
      const k = e.key;
      if (k === 'ArrowDown' || k === 'ArrowRight') { e.preventDefault(); pick(tabs[(i + 1) % tabs.length].dataset.path!, true); }
      else if (k === 'ArrowUp' || k === 'ArrowLeft') { e.preventDefault(); pick(tabs[(i - 1 + tabs.length) % tabs.length].dataset.path!, true); }
    });
  });
</script>
