---
import Base from '../layouts/Base.astro';
import EyebrowLabel from '../components/EyebrowLabel.astro';
import CTABand from '../components/CTABand.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { u } from '../utils/url';
import type { IconName } from '../utils/iconNames';
import industries from '../data/industries.json';
---

<Base
  title="Industries & Applications"
  description="CIE instruments are used by power utilities, Indian Railways, substation commissioning teams, EPC contractors, industry, and testing laboratories across India."
>
  <div class="bg-cloud border-b border-border py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs crumbs={[{ label: 'Industries' }]} />
      <EyebrowLabel text="Applications · Industries Served" class="mt-4 mb-3" />
      <h1 class="text-[length:var(--text-display)] font-extrabold text-ink leading-[1.1] tracking-tight">Industries &amp; Applications</h1>
      <p class="mt-2 text-muted max-w-2xl">
        CIE instruments are in daily use across India's critical infrastructure — from generating stations to rolling stock workshops.
      </p>
    </div>
  </div>

  <section class="bg-white section-pad-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map(industry => (
          <a href={u(`/industries/${industry.slug}/`)} class="card card-interactive group block p-8">
            <div class="w-11 h-11 bg-cloud rounded-xl flex items-center justify-center shrink-0 mb-4">
              <Icon name={industry.icon as IconName} class="w-5 h-5 text-ink" />
            </div>
            <h2 class="text-lg font-black text-ink mb-2 group-hover:text-red transition-colors">{industry.name}</h2>
            <p class="text-xs font-mono text-muted uppercase tracking-widest mb-4">{industry.customers}</p>
            <p class="text-sm text-muted leading-relaxed line-clamp-3">{industry.description}</p>
            <span class="inline-flex items-center gap-1 text-sm font-semibold text-red mt-4">
              View instruments used
              <Icon name="arrow" class="w-4 h-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    heading="Tell us your application — we'll recommend the right instrument."
    body="Our team has been serving these sectors for over 60 years. We know which instrument fits your requirement."
  />
</Base>
